---
import { ClientRouter } from "astro:transitions";
import type { ImageMetadata } from "astro";
import OverlayScrollbarsSetup from "@/components/ui/overlay/OverlayScrollbarsSetup";
import JsonLd from "@/components/ui/seo/JsonLd.astro";
import {
  buildOrganizationSchema,
  buildWebSiteSchema,
} from "@/components/ui/seo/seo.data";
import overlayScrollbarsCssUrl from "overlayscrollbars/styles/overlayscrollbars.css?url";
import RevealSetup from "../components/ui/reveal/RevealSetup.astro";
import "../styles/index.css";

interface Props {
  title?: string;
  description?: string;
  author?: string;
  ogImage?: string | ImageMetadata;
  ogType?: "website" | "article";
  noindex?: boolean;
}

const {
  title = "ATELIER TraiT D'ARCHITECTURE",
  description = "Atelier d'architecture en Corse, à Bastia, sur la Côte Bleue et en Provence.",
  author,
  ogImage = "/media/og/default-og.jpg",
  ogType = "website",
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(
  typeof ogImage === "string" ? ogImage : ogImage.src,
  Astro.site ?? Astro.url,
).href;
const organizationJsonLd = buildOrganizationSchema(Astro.site ?? Astro.url);
const webSiteJsonLd = buildWebSiteSchema(Astro.site ?? Astro.url);
const ogImageAlt = title;
const ogImageWidth = "1200";
const ogImageHeight = "630";
const robots = noindex ? "noindex, nofollow" : "index, follow";
const overlayScrollbarsMediaQuery =
  "(min-width: 1024px) and (hover: hover) and (pointer: fine)";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" />
    <!-- Resolve and apply the theme before first paint to avoid a theme flash
         (FOUC). Mirrors src/scripts/theme.ts: same storage key + attribute.
         is:inline scripts are not bundled, so constants are inlined here. -->
    <script is:inline>
      (() => {
        if (window.__t2aThemeInit) return;
        window.__t2aThemeInit = true;

        const STORAGE_KEY = "t2a-theme";
        const DARK_QUERY = "(prefers-color-scheme: dark)";
        const THEME_COLORS = { light: "#ffffff", dark: "#0d1117" };

        const readStoredTheme = () => {
          try {
            const stored = sessionStorage.getItem(STORAGE_KEY);
            if (stored === "light" || stored === "dark") return stored;
          } catch {
            /* sessionStorage unavailable (private mode / blocked storage) */
          }
          return null;
        };

        const resolveTheme = () =>
          readStoredTheme() ??
          (window.matchMedia(DARK_QUERY).matches ? "dark" : "light");

        const applyTheme = (targetDocument, theme) => {
          targetDocument.documentElement.dataset.theme = theme;
          const meta = targetDocument.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute("content", THEME_COLORS[theme]);
        };

        // 1) Initial: set before the first paint.
        applyTheme(document, resolveTheme());

        // 2) Re-stamp during SPA view transitions: the incoming document is
        //    parsed without data-theme, so set it before the swap is painted.
        document.addEventListener("astro:before-swap", (event) => {
          applyTheme(event.newDocument, resolveTheme());
        });
        document.addEventListener("astro:after-swap", () => {
          applyTheme(document, resolveTheme());
        });

        // 3) Follow the OS preference live until an explicit choice is stored.
        window.matchMedia(DARK_QUERY).addEventListener("change", () => {
          if (readStoredTheme()) return;
          applyTheme(document, resolveTheme());
        });
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/media/favicon/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/media/favicon/apple-touch-icon.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="192x192"
      href="/media/favicon/favicon-192.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="512x512"
      href="/media/favicon/favicon-512.png"
    />
    <link
      rel="preload"
      href="/fonts/T2A-Light.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/T2A-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/T2A-Demi-Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    {author ? <meta name="author" content={author} /> : null}
    <link rel="canonical" href={canonicalURL.href} />
    <meta name="robots" content={robots} />
    <meta property="og:site_name" content="ATELIER TraiT D'ARCHITECTURE" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:width" content={ogImageWidth} />
    <meta property="og:image:height" content={ogImageHeight} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <JsonLd data={organizationJsonLd} />
    <JsonLd data={webSiteJsonLd} />
    <!-- Keep this path close to Astro defaults. On iOS/WKWebView, native view
          transitions can still be disturbed by browser chrome changes that the
          page cannot control, notably the Google app reopening its URL bar and
          shrinking visualViewport during the transition. -->
    <ClientRouter />
    <RevealSetup />
    <link
      rel="stylesheet"
      href={overlayScrollbarsCssUrl}
      media={overlayScrollbarsMediaQuery}
    />
    <script is:inline>
      const LANDING_DISMISSED_STORAGE_KEY = "t2a-landing-dismissed";

      const syncDismissedLandingState = (targetDocument = document) => {
        try {
          if (sessionStorage.getItem(LANDING_DISMISSED_STORAGE_KEY) !== "1") {
            return;
          }

          targetDocument.documentElement.classList.add("is-landing-dismissed");
          targetDocument.body?.classList.add("landing-dismissed");

          // Remove the wrapper before back-nav scroll restoration runs.
          const landingWrapper =
            targetDocument.getElementById("landing-wrapper");
          landingWrapper?.remove();
        } catch {
          return;
        }
      };

      // Keep dismissed-home state in sync before first paint and during SPA swaps.
      syncDismissedLandingState();

      document.addEventListener("astro:before-swap", (event) => {
        syncDismissedLandingState(event.newDocument);
      });

      document.addEventListener("astro:after-swap", () => {
        syncDismissedLandingState();
      });
    </script>
    <script is:inline>
      const overlayScrollbarsMediaQuery =
        "(min-width: 1024px) and (hover: hover) and (pointer: fine)";

      if (window.matchMedia(overlayScrollbarsMediaQuery).matches) {
        document.documentElement.setAttribute(
          "data-overlayscrollbars-initialize",
          "",
        );
        document.addEventListener(
          "DOMContentLoaded",
          function () {
            document.body.setAttribute("data-overlayscrollbars-initialize", "");
          },
          { once: true },
        );
      }
    </script>
    <slot name="head" />
  </head>
  <body class="bg-(--bg-primary) font-sans text-(--text-primary) antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:inline-flex focus:items-center focus:border focus:border-(--trait) focus:bg-(--bg-primary) focus:px-4 focus:py-2 focus:text-[0.8rem] focus:uppercase focus:tracking-[0.14em] focus:text-(--t2a-blue-dark) focus:no-underline focus:outline-2 focus:outline-offset-2 focus:outline-(--t2a-blue) dark:focus:text-(--t2a-blue)"
    >
      Aller au contenu
    </a>
    <div id="t2a-grain" aria-hidden="true" transition:persist="t2a-grain"></div>
    <div
      id="t2a-nav-progress"
      role="progressbar"
      aria-label="Chargement de la page"
      aria-hidden="true"
    >
    </div>
    <OverlayScrollbarsSetup client:idle />
    <slot />
    <script is:inline>
      (() => {
        if (window.__t2aNavProgressInit) return;
        window.__t2aNavProgressInit = true;

        const SHOW_DELAY_MS = 150;
        const STALL_AFTER_MS = 900;
        const DONE_HOLD_MS = 200;
        let showTimer = null;
        let stallTimer = null;
        let hideTimer = null;

        const getEl = () => document.getElementById("t2a-nav-progress");

        const clearAllTimers = () => {
          if (showTimer) {
            clearTimeout(showTimer);
            showTimer = null;
          }
          if (stallTimer) {
            clearTimeout(stallTimer);
            stallTimer = null;
          }
          if (hideTimer) {
            clearTimeout(hideTimer);
            hideTimer = null;
          }
        };

        const reset = (el) => {
          if (!el) return;
          el.classList.remove(
            "is-loading",
            "is-stalled",
            "is-done",
            "is-hidden",
          );
        };

        const show = () => {
          const el = getEl();
          if (!el) return;
          reset(el);
          el.setAttribute("aria-hidden", "false");
          // force reflow before adding class so transition plays
          void el.offsetWidth;
          el.classList.add("is-loading");

          // After the main scaleX transition completes, switch to indeterminate
          // shimmer so the user keeps getting feedback on very slow networks.
          stallTimer = window.setTimeout(() => {
            stallTimer = null;
            const target = getEl();
            if (target && target.classList.contains("is-loading")) {
              target.classList.add("is-stalled");
            }
          }, STALL_AFTER_MS);
        };

        const complete = () => {
          clearAllTimers();
          const el = getEl();
          if (!el || !el.classList.contains("is-loading")) {
            return;
          }
          el.classList.remove("is-loading", "is-stalled");
          el.classList.add("is-done");
          hideTimer = window.setTimeout(() => {
            el.classList.add("is-hidden");
            hideTimer = window.setTimeout(() => {
              reset(el);
              el.setAttribute("aria-hidden", "true");
              hideTimer = null;
            }, 220);
          }, DONE_HOLD_MS);
        };

        document.addEventListener("astro:before-preparation", () => {
          clearAllTimers();
          showTimer = window.setTimeout(() => {
            showTimer = null;
            show();
          }, SHOW_DELAY_MS);
        });

        document.addEventListener("astro:page-load", complete);
      })();
    </script>
    <script is:inline>
      // Forward-navigation scroll reset.
      //
      // On iOS WebKit / the Google app, when the URL bar is collapsed the
      // native view transition can be skipped abnormally. The scroll-to-top
      // Astro performs *inside* the transition callback is then lost, so the
      // new page keeps the previous scroll offset and a shorter destination
      // clamps to its footer (a taller one lands mid-page). Re-assert the top
      // after the navigation has settled (astro:page-load fires whether or not
      // the transition played), for forward navigations only so back/forward
      // scroll restoration keeps working.
      (() => {
        if (window.__t2aScrollResetInit) return;
        window.__t2aScrollResetInit = true;

        let pendingNavigationType = null;
        let viewportGuard = null;

        const clearViewportGuard = () => {
          if (!viewportGuard) return;
          const guard = viewportGuard;
          viewportGuard = null;
          clearTimeout(guard.timer);
          window.visualViewport?.removeEventListener("resize", guard.onResize);
          window.removeEventListener("touchstart", guard.onUserInput, true);
          window.removeEventListener("wheel", guard.onUserInput, true);
          window.removeEventListener("keydown", guard.onUserInput, true);
          window.removeEventListener("pointerdown", guard.onUserInput, true);
        };

        const scrollToTop = () => {
          if (window.location.hash) return;
          window.scrollTo(0, 0);
        };

        // While the visual viewport is still settling after a forward
        // navigation (notably the Google app reopening its URL bar), keep the
        // page pinned to the top — but bail out the moment the user interacts,
        // so a deliberate scroll is never fought.
        const armViewportGuard = () => {
          clearViewportGuard();
          if (!window.visualViewport) return;

          const onResize = () => scrollToTop();
          const onUserInput = () => clearViewportGuard();
          const timer = window.setTimeout(clearViewportGuard, 1000);

          viewportGuard = { onResize, onUserInput, timer };
          window.visualViewport.addEventListener("resize", onResize);
          window.addEventListener("touchstart", onUserInput, {
            capture: true,
            passive: true,
          });
          window.addEventListener("wheel", onUserInput, {
            capture: true,
            passive: true,
          });
          window.addEventListener("keydown", onUserInput, true);
          window.addEventListener("pointerdown", onUserInput, true);
        };

        document.addEventListener("astro:before-preparation", (event) => {
          pendingNavigationType = event.navigationType;
        });

        document.addEventListener("astro:page-load", () => {
          const navigationType = pendingNavigationType;
          pendingNavigationType = null;

          // Only handle deliberate forward navigations. Back/forward
          // ("traverse") and the initial load keep their native/Astro scroll
          // restoration.
          if (navigationType !== "push" && navigationType !== "replace") {
            clearViewportGuard();
            return;
          }

          scrollToTop();
          requestAnimationFrame(() => requestAnimationFrame(scrollToTop));
          armViewportGuard();
        });
      })();
    </script>
  </body>
</html>
