---
import { ClientRouter } from "astro:transitions";
import OverlayScrollbarsSetup from "@/components/ui/overlay/OverlayScrollbarsSetup";
import "../styles/index.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title = "ATELIER TraiT D'ARCHITECTURE",
  description = "Site vitrine de l'ATELIER TraiT D'ARCHITECTURE.",
  ogImage = "/media/favicon/favicon.svg",
  noindex = false,
} = Astro.props;

const robots = noindex ? "noindex, nofollow" : "index, follow";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/media/favicon/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/T2A-Light.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/T2A-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/T2A-Demi-Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#ffffff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#0d1117"
    />
    <meta property="og:site_name" content="ATELIER TraiT D'ARCHITECTURE" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <ClientRouter />
    <script is:inline>
      const overlayScrollbarsMediaQuery =
        "(min-width: 1024px) and (hover: hover) and (pointer: fine)";

      if (window.matchMedia(overlayScrollbarsMediaQuery).matches) {
        document.documentElement.setAttribute(
          "data-overlayscrollbars-initialize",
          "",
        );
        document.addEventListener(
          "DOMContentLoaded",
          function () {
            document.body.setAttribute("data-overlayscrollbars-initialize", "");
          },
          { once: true },
        );
      }
    </script>
    <slot name="head" />
  </head>
  <body class="bg-(--bg-primary) font-sans text-(--text-primary) antialiased">
    <div id="t2a-vt-bg" aria-hidden="true" transition:persist="t2a-vt-bg"></div>
    <div id="t2a-grain" aria-hidden="true" transition:persist="t2a-grain"></div>
    <div
      id="t2a-nav-progress"
      role="progressbar"
      aria-label="Chargement de la page"
      aria-hidden="true"
    >
    </div>
    <OverlayScrollbarsSetup client:idle />
    <slot />
    <script is:inline>
      (() => {
        if (window.__t2aNavProgressInit) return;
        window.__t2aNavProgressInit = true;

        const SHOW_DELAY_MS = 150;
        const STALL_AFTER_MS = 900;
        const DONE_HOLD_MS = 200;
        let showTimer = null;
        let stallTimer = null;
        let hideTimer = null;

        const getEl = () => document.getElementById("t2a-nav-progress");

        const clearAllTimers = () => {
          if (showTimer) {
            clearTimeout(showTimer);
            showTimer = null;
          }
          if (stallTimer) {
            clearTimeout(stallTimer);
            stallTimer = null;
          }
          if (hideTimer) {
            clearTimeout(hideTimer);
            hideTimer = null;
          }
        };

        const reset = (el) => {
          if (!el) return;
          el.classList.remove(
            "is-loading",
            "is-stalled",
            "is-done",
            "is-hidden",
          );
        };

        const show = () => {
          const el = getEl();
          if (!el) return;
          reset(el);
          el.setAttribute("aria-hidden", "false");
          // force reflow before adding class so transition plays
          void el.offsetWidth;
          el.classList.add("is-loading");

          // After the main scaleX transition completes, switch to indeterminate
          // shimmer so the user keeps getting feedback on very slow networks.
          stallTimer = window.setTimeout(() => {
            stallTimer = null;
            const target = getEl();
            if (target && target.classList.contains("is-loading")) {
              target.classList.add("is-stalled");
            }
          }, STALL_AFTER_MS);
        };

        const complete = () => {
          clearAllTimers();
          const el = getEl();
          if (!el || !el.classList.contains("is-loading")) {
            return;
          }
          el.classList.remove("is-loading", "is-stalled");
          el.classList.add("is-done");
          hideTimer = window.setTimeout(() => {
            el.classList.add("is-hidden");
            hideTimer = window.setTimeout(() => {
              reset(el);
              el.setAttribute("aria-hidden", "true");
              hideTimer = null;
            }, 220);
          }, DONE_HOLD_MS);
        };

        document.addEventListener("astro:before-preparation", () => {
          clearAllTimers();
          showTimer = window.setTimeout(() => {
            showTimer = null;
            show();
          }, SHOW_DELAY_MS);
        });

        document.addEventListener("astro:page-load", complete);
      })();
    </script>
    <script is:inline>
      /* Option A — Hide mobile URL bar before view transition.
         The Snapshot Containing Block always includes the URL bar area
         (CSS View Transitions spec §4.1). On Chromium Android, when the
         URL bar is visible at the start of a VT, a black band appears
         between the old and new root pseudos during the translateY
         animation — there is NO CSS/JS/meta API to exclude the URL bar
         from the SCB.

         Workaround: retract the URL bar programmatically BEFORE the
         view transition starts. This only works while a user gesture is
         still active (Chrome Android requirement), so we hook into
         `astro:before-preparation` which fires synchronously inside the
         click handler of the triggering link. */
      (() => {
        if (window.__t2aHideUrlBarInit) return;
        window.__t2aHideUrlBarInit = true;

        const isUrlBarLikelyVisible = () => {
          const vv = window.visualViewport;
          if (!vv) return false;
          // If visual viewport is shorter than layout viewport by more
          // than 10px, retractable chrome (URL bar) is on screen.
          return window.innerHeight - vv.height > 10;
        };

        const waitForFrames = (count) =>
          new Promise((resolve) => {
            const step = (remaining) => {
              if (remaining <= 0) resolve();
              else requestAnimationFrame(() => step(remaining - 1));
            };
            step(count);
          });

        const waitForViewportSettled = async (timeoutMs = 400) => {
          const start = performance.now();
          let lastHeight = window.visualViewport
            ? window.visualViewport.height
            : window.innerHeight;
          // Wait until two consecutive frames report the same viewport
          // height (URL bar done animating), with a hard timeout.
          while (performance.now() - start < timeoutMs) {
            await waitForFrames(1);
            const current = window.visualViewport
              ? window.visualViewport.height
              : window.innerHeight;
            if (current === lastHeight) return;
            lastHeight = current;
          }
        };

        document.addEventListener("astro:before-preparation", (event) => {
          if (!isUrlBarLikelyVisible()) return;

          // Ensure we have scroll room so the URL bar can actually
          // retract. If the document is too short or we are already at
          // the top, scrolling by 1px is enough on Chrome Android while
          // the user gesture is still active.
          const originalScrollY = window.scrollY;
          if (originalScrollY < 1) {
            window.scrollTo({ top: 1, behavior: "instant" });
          } else {
            // Force a 1px delta to wake up the URL bar retract logic.
            window.scrollTo({
              top: originalScrollY + 1,
              behavior: "instant",
            });
          }

          // Defer the page load until the viewport has settled so the
          // VT captures the "old" snapshot with URL bar already hidden.
          const originalLoader = event.loader;
          event.loader = async () => {
            await waitForViewportSettled();
            return originalLoader.call(event);
          };
        });
      })();
    </script>
  </body>
</html>
