---
import "../styles/index.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title = "ATELIER TraiT D'ARCHITECTURE",
  description = "Migration Astro en cours pour le site vitrine de l'atelier.",
  ogImage = "/media/favicon/favicon.svg",
  noindex = false,
} = Astro.props;

const robots = noindex ? "noindex, nofollow" : "index, follow";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/media/favicon/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/T2A-Light.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/T2A-Regular.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/T2A-Demi-Bold.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#5E7396" />
    <meta property="og:site_name" content="ATELIER TraiT D'ARCHITECTURE" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <slot name="head" />
  </head>
  <body class="bg-(--bg-primary) font-sans text-(--text-primary) antialiased">
    <slot />
  </body>
</html>
