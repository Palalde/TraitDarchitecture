---
import { ClientRouter } from "astro:transitions";
import OverlayScrollbarsSetup from "@/components/ui/overlay/OverlayScrollbarsSetup";
import "overlayscrollbars/styles/overlayscrollbars.css";
import "../styles/index.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title = "ATELIER TraiT D'ARCHITECTURE",
  description = "Site vitrine de l'ATELIER TraiT D'ARCHITECTURE.",
  ogImage = "/media/favicon/favicon.svg",
  noindex = false,
} = Astro.props;

const robots = noindex ? "noindex, nofollow" : "index, follow";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <link rel="icon" type="image/svg+xml" href="/media/favicon/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/T2A-Light.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/T2A-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/T2A-Demi-Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#5E7396" />
    <meta property="og:site_name" content="ATELIER TraiT D'ARCHITECTURE" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>
      (() => {
        const ua = navigator.userAgent;
        const isAndroidChromium =
          /Android/i.test(ua) &&
          /(Chrome|CriOS|EdgA|OPR)\//.test(ua) &&
          !/(Firefox|FxiOS)\//.test(ua);

        if (isAndroidChromium) {
          document.documentElement.setAttribute(
            "data-t2a-android-overlay-fix",
            "",
          );
        }
      })();
    </script>
    <ClientRouter />
    <script is:inline>
      const overlayScrollbarsMediaQuery =
        "(min-width: 1024px) and (hover: hover) and (pointer: fine)";

      if (window.matchMedia(overlayScrollbarsMediaQuery).matches) {
        document.documentElement.setAttribute(
          "data-overlayscrollbars-initialize",
          "",
        );
        document.addEventListener(
          "DOMContentLoaded",
          function () {
            document.body.setAttribute("data-overlayscrollbars-initialize", "");
          },
          { once: true },
        );
      }
    </script>
    <slot name="head" />
  </head>
  <body class="bg-(--bg-primary) font-sans text-(--text-primary) antialiased">
    <div id="t2a-grain" aria-hidden="true" transition:persist="t2a-grain"></div>
    <div
      id="t2a-transition-overlay"
      aria-hidden="true"
      transition:persist="t2a-transition-overlay"
    ></div>
    <div
      id="t2a-nav-progress"
      role="progressbar"
      aria-label="Chargement de la page"
      aria-hidden="true"
    >
    </div>
    <OverlayScrollbarsSetup client:idle />
    <slot />
    <script is:inline>
      (() => {
        if (window.__t2aNavProgressInit) return;
        window.__t2aNavProgressInit = true;

        const SHOW_DELAY_MS = 150;
        const STALL_AFTER_MS = 900;
        const DONE_HOLD_MS = 200;
        let showTimer = null;
        let stallTimer = null;
        let hideTimer = null;

        const getEl = () => document.getElementById("t2a-nav-progress");
        const getOverlay = () =>
          document.getElementById("t2a-transition-overlay");

        const clearAllTimers = () => {
          if (showTimer) {
            clearTimeout(showTimer);
            showTimer = null;
          }
          if (stallTimer) {
            clearTimeout(stallTimer);
            stallTimer = null;
          }
          if (hideTimer) {
            clearTimeout(hideTimer);
            hideTimer = null;
          }
        };

        const reset = (el) => {
          if (!el) return;
          el.classList.remove(
            "is-loading",
            "is-stalled",
            "is-done",
            "is-hidden",
          );
        };

        const showOverlay = () => {
          const overlay = getOverlay();
          if (!overlay) return;
          overlay.classList.add("is-active");
        };

        const hideOverlay = () => {
          const overlay = getOverlay();
          if (!overlay) return;
          overlay.classList.remove("is-active");
        };

        const show = () => {
          const el = getEl();
          if (!el) return;
          reset(el);
          el.setAttribute("aria-hidden", "false");
          // force reflow before adding class so transition plays
          void el.offsetWidth;
          el.classList.add("is-loading");

          // After the main scaleX transition completes, switch to indeterminate
          // shimmer so the user keeps getting feedback on very slow networks.
          stallTimer = window.setTimeout(() => {
            stallTimer = null;
            const target = getEl();
            if (target && target.classList.contains("is-loading")) {
              target.classList.add("is-stalled");
            }
          }, STALL_AFTER_MS);
        };

        const complete = () => {
          clearAllTimers();
          const el = getEl();
          if (!el || !el.classList.contains("is-loading")) {
            return;
          }
          el.classList.remove("is-loading", "is-stalled");
          el.classList.add("is-done");
          hideTimer = window.setTimeout(() => {
            el.classList.add("is-hidden");
            hideTimer = window.setTimeout(() => {
              reset(el);
              el.setAttribute("aria-hidden", "true");
              hideTimer = null;
            }, 220);
          }, DONE_HOLD_MS);
        };

        document.addEventListener("astro:before-preparation", () => {
          clearAllTimers();
          showOverlay();
          showTimer = window.setTimeout(() => {
            showTimer = null;
            show();
          }, SHOW_DELAY_MS);
        });

        document.addEventListener("astro:page-load", () => {
          complete();
          hideOverlay();
        });
      })();
    </script>
  </body>
</html>
