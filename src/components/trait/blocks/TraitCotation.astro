---
type TraitCotationCorner =
  | "top-left"
  | "top-right"
  | "bottom-left"
  | "bottom-right";
type TraitCotationOrientation = "horizontal" | "vertical";

interface Props {
  className?: string;
  corner?: TraitCotationCorner;
  cornerDelay?: string;
  cornerDuration?: string;
  connectorDuration?: string;
  length?: number | string;
  orientation?: TraitCotationOrientation;
}

const {
  className,
  corner,
  cornerDelay,
  cornerDuration,
  connectorDuration,
  length = 24,
  orientation = "horizontal",
}: Props = Astro.props;

const resolvedLength = typeof length === "number" ? `${length}px` : length;
const isCorner = typeof corner === "string";

const horizontalClass =
  corner === "top-right" || corner === "bottom-right" ? "right-0" : "left-0";
const horizontalOriginClass =
  corner === "top-right" || corner === "bottom-right"
    ? "origin-right"
    : "origin-left";
const horizontalCotationCorner =
  corner === "top-right" || corner === "bottom-right" ? "x-right" : "x-left";
const horizontalVerticalPositionClass =
  corner === "bottom-left" || corner === "bottom-right" ? "bottom-0" : "top-0";

const verticalClass =
  corner === "bottom-left" || corner === "bottom-right" ? "bottom-0" : "top-0";
const verticalOriginClass =
  corner === "bottom-left" || corner === "bottom-right"
    ? "origin-bottom"
    : "origin-top";
const verticalCotationCorner =
  corner === "bottom-left" || corner === "bottom-right" ? "y-bottom" : "y-top";
const verticalHorizontalPositionClass =
  corner === "top-right" || corner === "bottom-right" ? "right-0" : "left-0";
const timingStyle = [
  connectorDuration
    ? `--cotation-connector-d:${connectorDuration};`
    : undefined,
  cornerDuration ? `--cotation-corner-d:${cornerDuration};` : undefined,
  cornerDelay ? `--cotation-corner-delay:${cornerDelay};` : undefined,
]
  .filter(Boolean)
  .join("");
---

{
  isCorner ? (
    <span
      aria-hidden="true"
      class:list={["pointer-events-none relative block", className]}
      data-reveal="cotation"
      style={`width:${resolvedLength};height:${resolvedLength};${timingStyle}`}
    >
      <span
        class:list={[
          "absolute h-px bg-(--trait)",
          horizontalClass,
          horizontalOriginClass,
          horizontalVerticalPositionClass,
        ]}
        data-cotation-corner={horizontalCotationCorner}
        style={`width:${resolvedLength};`}
      />
      <span
        class:list={[
          "absolute w-px bg-(--trait)",
          verticalClass,
          verticalOriginClass,
          verticalHorizontalPositionClass,
        ]}
        data-cotation-corner={verticalCotationCorner}
        style={`height:${resolvedLength};`}
      />
    </span>
  ) : (
    <span
      aria-hidden="true"
      class:list={[
        "pointer-events-none block bg-(--trait)",
        orientation === "horizontal" ? "h-px" : "w-px",
        className,
      ]}
      data-cotation-connector={orientation === "horizontal" ? "x" : "y"}
      data-reveal="cotation"
      style={
        orientation === "horizontal"
          ? `width:${resolvedLength};${timingStyle}`
          : `height:${resolvedLength};${timingStyle}`
      }
    />
  )
}
