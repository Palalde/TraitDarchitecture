---
import type { TraitEtymology } from "@/components/trait/trait.data";
import { TRAIT_NARRATIVE_INDENT } from "@/components/trait/trait.classes";
import TraitCotation from "@/components/trait/blocks/TraitCotation.astro";

interface Props {
  entry: TraitEtymology;
  index: number;
}

const { entry, index }: Props = Astro.props;

const blockId = `trait-etymology-${index + 1}`;
const blockLabel = `Étymologie ${String(index + 1).padStart(2, "0")}`;
const phoneticMatch = entry.phonetic.match(/^(\[[^\]]+\])\s*(.*)$/);
const phoneticWord = phoneticMatch?.[1] ?? entry.phonetic;
const phoneticMeta = phoneticMatch?.[2] ?? "";
const bodyClass =
  "text-[0.98rem] leading-7 text-(--text-primary) sm:text-[1rem] sm:leading-8";
const ghostWordClass =
  "pointer-events-none relative z-0 block whitespace-nowrap pl-10 text-[clamp(2.2rem,9.2vw,3.3rem)] leading-[0.8] font-semibold tracking-[0.04em] text-(--t2a-blue)/18 opacity-70 mix-blend-multiply [-webkit-text-stroke:0.45px_var(--t2a-blue)] sm:pl-12 sm:text-[4.8rem] md:pl-14 md:text-[6rem] lg:absolute lg:top-10 lg:left-[calc(27%+0.35rem)] lg:pl-0 lg:text-[5.33rem] xl:text-[6.33rem] 2xl:text-[7.33rem] dark:opacity-55 dark:mix-blend-screen";
const phoneticLineClass =
  "flex flex-wrap items-baseline gap-x-2 gap-y-1 leading-6 italic";
const phoneticWordClass =
  "[font-family:'Segoe_UI',Arial,sans-serif] text-[0.78rem] font-normal tracking-[0.01em] text-(--text-muted) opacity-75 sm:text-[0.84rem]";
const phoneticMetaClass =
  "font-sans text-[0.9rem] font-light tracking-[0.01em] text-(--t2a-blue-light) sm:text-[0.95rem]";
---

<article
  aria-labelledby={blockId}
  class="relative py-12 sm:py-14 lg:min-h-72 lg:py-16"
>
  <!-- sr-only heading -->
  <h2 id={blockId} class="sr-only">{entry.word}</h2>

  <!-- ghost word (background, decorative) -->
  <p aria-hidden="true" class={ghostWordClass}>
    {entry.word}
  </p>

  <!-- cotation hook (top-left corner, lg+ only) -->
  <TraitCotation
    className="revealed absolute top-16 hidden lg:left-[calc(27%-1.15rem)] lg:block"
    corner="top-left"
    length="3.25rem"
  />

  <!-- text block (label + phonetic + etymology + meaning) -->
  <div
    class:list={[
      "relative z-10 -mt-2 sm:-mt-3 lg:mt-0 lg:max-w-xl",
      TRAIT_NARRATIVE_INDENT,
    ]}
  >
    <p
      class="text-[0.72rem] font-semibold uppercase tracking-[0.16em] text-(--text-muted) dark:text-(--text-muted)"
    >
      {blockLabel}
    </p>

    <div class="mt-4 flex flex-col gap-5 sm:mt-5 sm:gap-6">
      <!-- phonetic line -->
      <p class={phoneticLineClass}>
        <span class={phoneticWordClass}>{phoneticWord}</span>
        {phoneticMeta && <span class={phoneticMetaClass}>{phoneticMeta}</span>}
      </p>

      <!-- etymology -->
      <div class="flex flex-col gap-2">
        <p
          class="text-[0.72rem] font-semibold uppercase tracking-[0.14em] text-(--t2a-blue-dark) dark:text-(--t2a-blue)"
        >
          Étymologie
        </p>
        <p class={bodyClass}>{entry.etymology}</p>
      </div>

      <!-- meaning -->
      <div class="flex flex-col gap-2">
        <p
          class="text-[0.72rem] font-semibold uppercase tracking-[0.14em] text-(--t2a-blue-dark) dark:text-(--t2a-blue)"
        >
          Sens
        </p>
        <p class={bodyClass}>{entry.meaning}</p>
      </div>
    </div>
  </div>
</article>
