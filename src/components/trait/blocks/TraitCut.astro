---
interface Props {
  className?: string;
  label?: string;
  labelClassName?: string;
  lineClassName?: string;
}

const { className, label, labelClassName, lineClassName }: Props = Astro.props;
const hasLabel = Boolean(label?.trim());
---

{
  hasLabel ? (
    <div
      class:list={["relative flex w-full items-center gap-4", className]}
      data-reveal="bar-from-left"
    >
      <span
        aria-hidden="true"
        class:list={["block h-px flex-1 bg-(--trait)", lineClassName]}
      />
      <span
        class:list={[
          "shrink-0 text-[0.72rem] font-semibold uppercase tracking-[0.16em] text-(--t2a-blue-dark) dark:text-(--t2a-blue)",
          labelClassName,
        ]}
      >
        {label}
      </span>
      <span
        aria-hidden="true"
        class:list={["block h-px flex-1 bg-(--trait)", lineClassName]}
      />
    </div>
  ) : (
    <span
      aria-hidden="true"
      class:list={["block h-px w-full bg-(--trait)", className, lineClassName]}
      data-reveal="bar-from-left"
    />
  )
}