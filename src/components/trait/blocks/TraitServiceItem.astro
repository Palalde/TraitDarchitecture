---
interface Props {
  index: number;
  service: string;
}

const { index, service }: Props = Astro.props;
const revealDelay = `${index * 40}ms`;
---

<li
  class="flex max-w-176 items-start gap-4"
  style={`--reveal-delay:${revealDelay};`}
>
  <!-- cotation segment -->
  <span
    aria-hidden="true"
    class="mt-[0.82rem] block h-px w-4 shrink-0 origin-left bg-(--trait)"
    data-reveal="bar-from-left"
    style="--reveal-d:420ms;"></span>

  <!-- service text -->
  <p
    class="max-w-(--reading-measure) text-body-sm text-(--text-reading) [&_strong]:font-semibold [&_strong]:text-(--text-primary)"
    data-reveal="fade-up"
    style="--reveal-d:520ms;"
    set:html={service}
  />
</li>
