---
import { Image } from "astro:assets";
import {
  traitProcessPhotos,
  type TraitStepData,
} from "@/components/trait/trait.data";
import { TRAIT_NARRATIVE_INDENT } from "@/components/trait/trait.classes";
import CotationFrame from "@/components/ui/cotation/CotationFrame.astro";
import FigCaption from "@/components/ui/cotation/FigCaption.astro";

interface Props {
  className?: string;
  step: TraitStepData;
}

const { className, step }: Props = Astro.props;

const stepTitle = step.displayTitle ?? step.title;
const stepPhoto = traitProcessPhotos[step.photoKey];
const mediaWidthClass =
  step.mediaWidth === "narrow"
    ? "lg:w-[60%]"
    : step.mediaWidth === "medium"
      ? "lg:w-[75%]"
      : "lg:w-[90%]";
const imageAlt = `Document de travail pour l'étape ${step.id} : ${step.title}`;
---

<article class:list={["relative py-10 sm:py-12 lg:py-14", className]}>
  <div class:list={["relative z-10 lg:max-w-5xl", TRAIT_NARRATIVE_INDENT]}>
    <div class="grid gap-5 sm:gap-6 lg:grid-cols-[3rem_minmax(0,1fr)] lg:gap-7">
      <p
        class="text-[1.6rem] leading-none font-semibold tracking-[0.08em] text-(--t2a-blue-dark) dark:text-(--t2a-blue) sm:text-[1.85rem] lg:pt-1"
      >
        <span class="sr-only">Étape </span>
        {step.id}
      </p>

      <div class="min-w-0">
        <div class="flex items-center gap-3 sm:gap-4">
          <span
            aria-hidden="true"
            class="block h-px w-8 shrink-0 bg-(--trait) sm:w-10"></span>
          <h3
            class="text-[0.74rem] font-semibold uppercase tracking-[0.16em] text-(--t2a-blue-dark) dark:text-(--t2a-blue) sm:text-[0.78rem]"
          >
            {stepTitle}
          </h3>
        </div>

        <figure class:list={["relative mt-7 w-full sm:mt-8", mediaWidthClass]}>
          <CotationFrame aspectRatio={step.mediaRatio} revealCotation={false}>
            <Image
              alt={imageAlt}
              class="h-full w-full object-cover object-center grayscale"
              draggable="false"
              format="webp"
              loading="lazy"
              quality={72}
              sizes="(min-width: 1024px) 52rem, (min-width: 640px) calc(100vw - 8rem), calc(100vw - 5rem)"
              src={stepPhoto}
              widths={[360, 480, 640, 780, 960, 1200]}
            />
          </CotationFrame>
          <FigCaption overlay overlayTone="dark" label={step.caption} />
        </figure>

        <p
          class="mt-7 max-w-184 text-[0.98rem] leading-7 text-(--text-primary) sm:mt-8 sm:text-[1rem] sm:leading-8 [&_strong]:font-semibold [&_strong]:text-(--text-primary)"
          set:html={step.body}
        />
      </div>
    </div>
  </div>
</article>
