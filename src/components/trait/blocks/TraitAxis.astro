---
interface Props {
  bottom?: string;
  className?: string;
  left?: string;
  reveal?: boolean;
  top?: string;
}

const { bottom, className, left, reveal = false, top }: Props = Astro.props;

const axisStyle = [
  top ? `top:${top};` : undefined,
  bottom ? `bottom:${bottom};` : undefined,
  left ? `left:${left};` : undefined,
]
  .filter(Boolean)
  .join("");
---

<span
  aria-hidden="true"
  class:list={["pointer-events-none absolute z-0 w-px bg-(--trait)", className]}
  data-reveal={reveal ? "bar-from-top" : undefined}
  style={axisStyle || undefined}></span>
