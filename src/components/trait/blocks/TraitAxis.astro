---
interface Props {
  bottom?: string;
  className?: string;
  left?: string;
  top?: string;
}

const {
  bottom = "0",
  className,
  left = "27%",
  top = "0",
}: Props = Astro.props;
---

<span
  aria-hidden="true"
  class:list={[
    "pointer-events-none absolute z-0 w-px bg-(--trait)",
    className,
  ]}
  data-reveal="bar-from-top"
  style={`left:${left};top:${top};bottom:${bottom};`}
/>