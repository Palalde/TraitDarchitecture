---
import type { TraitFormulaData } from "@/components/trait/trait.data";
import { FORMULA_PHASES } from "@/components/trait/trait.data";
import { TRAIT_FORMULA_MATRIX_GRID } from "@/components/trait/trait.classes";

interface Props {
  formula: TraitFormulaData;
  index: number;
}

const { formula, index }: Props = Astro.props;
const rowDelayMs = index * 110;

const coveredPhases = FORMULA_PHASES.filter((phase) =>
  formula.phases.includes(phase.id),
);
const coveredPhaseLabel = coveredPhases.map((phase) => phase.label).join(", ");
---

<li
  aria-label={`${formula.name} : ${formula.description}. Phases couvertes : ${coveredPhaseLabel}.`}
  class:list={[
    "relative py-6 pl-6 last:border-b last:border-(--border) md:pl-0",
    TRAIT_FORMULA_MATRIX_GRID,
  ]}
>
  <span
    aria-hidden="true"
    class="absolute left-0 top-0 z-10 block h-full w-px bg-(--trait) md:hidden"
    data-reveal="bar-from-top"
    style={`--reveal-delay:${rowDelayMs}ms;--reveal-d:480ms;`}></span>
  <span
    aria-hidden="true"
    class="absolute left-0 top-0 z-10 block h-px w-10 bg-(--trait) md:hidden"
    data-reveal="bar-from-left"
    style={`--reveal-delay:${rowDelayMs}ms;--reveal-d:480ms;`}></span>
  <span
    aria-hidden="true"
    class="absolute bottom-0 left-0 z-10 block h-px w-10 bg-(--trait) md:hidden"
    data-reveal="bar-from-left"
    style={`--reveal-delay:${rowDelayMs}ms;--reveal-d:480ms;`}></span>
  <span
    aria-hidden="true"
    class="absolute inset-x-0 top-0 z-0 block h-px bg-(--border)"
    data-reveal="bar-from-left"
    style={`--reveal-delay:${rowDelayMs}ms;--reveal-d:520ms;`}></span>

  <div class="min-w-0 md:pr-4">
    <p
      class="text-[0.86rem] font-semibold uppercase tracking-[0.14em] text-(--t2a-blue-dark) sm:text-[0.9rem] dark:text-(--t2a-blue)"
      data-reveal="fade"
      style={`--reveal-delay:${rowDelayMs + 40}ms;--reveal-d:480ms;`}
    >
      {formula.name}
    </p>
    <p
      class="mt-2 max-w-md text-[0.86rem] leading-6 font-light text-(--text-secondary) sm:text-[0.9rem] sm:leading-7"
      data-reveal="fade-up"
      style={`--reveal-delay:${rowDelayMs + 80}ms;--reveal-d:520ms;`}
    >
      {formula.description}
    </p>
  </div>

  <div class="mt-5 flex flex-col gap-3 md:hidden" aria-hidden="true">
    {
      coveredPhases.map((phase, phaseIndex) => (
        <div class="flex items-center gap-3">
          <span
            class="block h-px w-12 shrink-0 origin-left bg-(--trait)"
            data-reveal="bar-from-left"
            style={`--reveal-delay:${rowDelayMs + 120 + phaseIndex * 40}ms;--reveal-d:420ms;`}
          />
          <span
            class="text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-(--t2a-blue-dark) dark:text-(--t2a-blue)"
            data-reveal="fade"
            style={`--reveal-delay:${rowDelayMs + 150 + phaseIndex * 40}ms;--reveal-d:420ms;`}
          >
            {phase.label}
          </span>
        </div>
      ))
    }
  </div>

  {
    FORMULA_PHASES.map((phase, phaseIndex) => {
      const isCovered = formula.phases.includes(phase.id);

      return (
        <div class="hidden min-h-8 items-center md:flex" aria-hidden="true">
          {isCovered && (
            <span
              class="block h-px w-16 origin-left bg-(--trait) lg:w-20"
              data-reveal="bar-from-left"
              style={`--reveal-delay:${rowDelayMs + 120 + phaseIndex * 45}ms;--reveal-d:460ms;`}
            />
          )}
        </div>
      );
    })
  }
</li>
