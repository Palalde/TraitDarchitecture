---
import type { TraitPhaseData } from "@/components/trait/trait.data";
import TraitAxis from "@/components/trait/blocks/TraitAxis.astro";
import { TRAIT_AXIS_LEFT } from "@/components/trait/trait.classes";

interface Props {
  className?: string;
  headingId?: string;
  phase: Pick<TraitPhaseData, "id" | "label" | "title">;
  revealed?: boolean;
}

const { className, headingId, phase, revealed = true }: Props = Astro.props;
const titleId = headingId ?? `trait-phase-${phase.id.toLowerCase()}-title`;
const label = `${phase.label} · ${phase.title}`;
const revealedClass = revealed ? "revealed" : undefined;
---

<header
  aria-labelledby={titleId}
  class:list={["relative w-full py-2 sm:py-2.5 lg:py-3", className]}
>
  <!-- axis wrapper aligned with global max-w-7xl runway -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-y-0 left-1/2 z-0 w-full max-w-7xl -translate-x-1/2 px-6 sm:px-8 lg:px-10"
  >
    <TraitAxis bottom="0" className={TRAIT_AXIS_LEFT} top="0" />
  </div>

  <div class="relative z-10 flex w-full items-center gap-0">
    <span
      aria-hidden="true"
      class:list={["block h-px flex-1 bg-(--trait)", revealedClass]}
      data-reveal="bar-from-left"></span>
    <h2
      id={titleId}
      class:list={[
        "shrink-0 bg-transparent px-3 py-1 text-center text-[0.72rem] font-semibold uppercase tracking-[0.16em] text-(--t2a-blue-dark) backdrop-blur-md dark:text-(--t2a-blue) sm:px-4 sm:text-[0.76rem]",
        revealedClass,
      ]}
      data-reveal="fade"
    >
      {label}
    </h2>
    <span
      aria-hidden="true"
      class:list={["block h-px flex-1 bg-(--trait)", revealedClass]}
      data-reveal="bar-from-left"></span>
  </div>
</header>
