---
import type { TraitPhaseData } from "@/components/trait/trait.data";
import { TRAIT_AXIS_LEFT } from "@/components/trait/trait.classes";

interface Props {
  className?: string;
  headingId?: string;
  phase: Pick<TraitPhaseData, "id" | "label" | "title">;
  revealed?: boolean;
}

const { className, headingId, phase, revealed = true }: Props = Astro.props;
const titleId = headingId ?? `trait-phase-${phase.id.toLowerCase()}-title`;
const label = `${phase.label} · ${phase.title}`;
const revealedClass = revealed ? "revealed" : undefined;
---

<header
  aria-labelledby={titleId}
  class:list={["relative w-full py-8 sm:py-10 lg:py-12", className]}
>
  <!-- axis wrapper aligned with global max-w-7xl runway -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-y-0 left-1/2 z-0 w-full max-w-7xl -translate-x-1/2 px-6 sm:px-8 lg:px-10"
  >
    <span
      class:list={[
        "pointer-events-none absolute bottom-0 top-0 block w-px bg-(--trait)",
        TRAIT_AXIS_LEFT,
      ]}></span>
  </div>

  <div class="relative z-10 flex w-full items-center gap-4 sm:gap-5">
    <span
      aria-hidden="true"
      class:list={["block h-px flex-1 bg-(--trait)", revealedClass]}
      data-reveal="bar-from-left"></span>
    <h2
      id={titleId}
      class:list={[
        "shrink-0 text-center text-[0.72rem] font-semibold uppercase tracking-[0.16em] text-(--t2a-blue-dark) dark:text-(--t2a-blue) sm:text-[0.76rem]",
        revealedClass,
      ]}
      data-reveal="fade"
    >
      {label}
    </h2>
    <span
      aria-hidden="true"
      class:list={["block h-px flex-1 bg-(--trait)", revealedClass]}
      data-reveal="bar-from-left"></span>
  </div>
</header>
