---
import type { TraitPageData } from "@/components/trait/trait.data";
import { FORMULA_PHASES } from "@/components/trait/trait.data";
import { TRAIT_FORMULA_MATRIX_GRID } from "@/components/trait/trait.classes";
import TraitFormulaRow from "@/components/trait/blocks/TraitFormulaRow.astro";

interface Props {
  formulas: TraitPageData["formulas"];
}

const { formulas }: Props = Astro.props;
---

<section aria-labelledby="trait-formulas-title" class="relative w-full">
  <span
    aria-hidden="true"
    class="absolute inset-x-0 top-0 z-0 block h-px bg-(--trait)"></span>

  <div
    class="relative z-10 mx-auto w-full max-w-7xl px-6 py-14 sm:px-8 sm:py-16 lg:px-10 lg:py-20"
  >
    <div class="relative z-10">
      <h2
        id="trait-formulas-title"
        class="mb-8 text-[0.76rem] font-semibold uppercase tracking-[0.16em] text-(--t2a-blue-dark) md:mb-10 dark:text-(--t2a-blue)"
      >
        Formules
      </h2>

      <div
        class:list={[
          "hidden border-b border-(--border) pb-4 md:grid",
          TRAIT_FORMULA_MATRIX_GRID,
        ]}
        aria-hidden="true"
      >
        <span></span>
        {
          FORMULA_PHASES.map((phase) => (
            <p class="text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-(--t2a-blue-dark) dark:text-(--t2a-blue)">
              {phase.label}
            </p>
          ))
        }
      </div>

      <ul aria-label="Matrice des formules d'accompagnement">
        {formulas.map((formula) => <TraitFormulaRow formula={formula} />)}
      </ul>
    </div>
  </div>
</section>
