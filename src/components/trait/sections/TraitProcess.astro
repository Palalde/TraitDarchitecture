---
import type { TraitPageData } from "@/components/trait/trait.data";
import { TRAIT_AXIS_LEFT } from "@/components/trait/trait.classes";
import TraitAxis from "@/components/trait/blocks/TraitAxis.astro";
import TraitPhaseTitle from "@/components/trait/blocks/TraitPhaseTitle.astro";
import TraitStep from "@/components/trait/blocks/TraitStep.astro";

interface Props {
  phases: TraitPageData["phases"];
}

const { phases }: Props = Astro.props;
const firstPhaseTitleId = `trait-process-phase-${phases[0].id.toLowerCase()}-title`;
---

<section
  aria-labelledby={firstPhaseTitleId}
  class="relative w-full pb-14 sm:pb-16 lg:pb-20"
>
  {
    phases.map((phase) => {
      const phaseTitleId = `trait-process-phase-${phase.id.toLowerCase()}-title`;
      return (
        <div class="relative w-full">
          <TraitPhaseTitle
            className="sticky top-0 z-40 bg-transparent"
            headingId={phaseTitleId}
            phase={phase}
          />

          <div class="relative z-10 mx-auto w-full max-w-7xl px-6 sm:px-8 lg:px-10">
            <TraitAxis bottom="0" className={TRAIT_AXIS_LEFT} top="0" />

            <div class="relative z-10 flex flex-col">
              {phase.steps.map((step) => (
                <TraitStep step={step} />
              ))}
            </div>
          </div>
        </div>
      );
    })
  }
</section>
