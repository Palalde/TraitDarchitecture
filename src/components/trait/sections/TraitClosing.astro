---
import type { TraitPageData } from "@/components/trait/trait.data";
import { TRAIT_AXIS_LEFT } from "@/components/trait/trait.classes";
import TraitAxis from "@/components/trait/blocks/TraitAxis.astro";

interface Props {
  closingQuote: TraitPageData["closingQuote"];
}

const { closingQuote }: Props = Astro.props;
---

<section aria-labelledby="trait-closing-title" class="relative w-full">
  <span
    aria-hidden="true"
    class="block h-px w-full bg-(--trait)"
    data-reveal="bar-from-left"
    style="--reveal-delay:120ms;--reveal-d:560ms;"></span>

  <div
    class="relative z-10 mx-auto w-full max-w-7xl px-6 py-14 sm:px-8 sm:py-16 lg:px-10 lg:py-20"
  >
    <div class="relative z-10 mx-auto max-w-none">
      <h2 id="trait-closing-title" class="sr-only">Citation finale</h2>

      <blockquote
        class="text-balance text-[clamp(1.35rem,5.2vw,1.9rem)] leading-[1.18] font-light italic tracking-[0.01em] text-(--t2a-blue-dark) sm:text-[clamp(1.75rem,4.7vw,2.45rem)] lg:text-[clamp(2.15rem,3vw,2.85rem)] dark:text-(--t2a-blue)"
        data-reveal="fade-up"
        style="--reveal-delay:120ms;--reveal-d:560ms;"
      >
        {closingQuote}
      </blockquote>
    </div>
  </div>

  <div
    class="relative z-10 mx-auto w-full max-w-7xl px-6 pb-(--footer-root-overlap) sm:px-8 lg:px-10"
  >
    <TraitAxis
      className={`${TRAIT_AXIS_LEFT} top-0 bottom-0 [--reveal-delay:180ms] [--reveal-d:720ms]`}
      reveal
    />
    <div
      aria-hidden="true"
      class="pointer-events-none relative h-40 sm:h-48 md:h-56 lg:h-80 2xl:h-128"
    >
    </div>
  </div>
</section>
