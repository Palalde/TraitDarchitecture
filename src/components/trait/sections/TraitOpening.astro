---
import type { TraitPageData } from "@/components/trait/trait.data";
import {
  TRAIT_AXIS_LEFT,
  TRAIT_NARRATIVE_INDENT,
} from "@/components/trait/trait.classes";
import TraitAxis from "@/components/trait/blocks/TraitAxis.astro";

interface Props {
  opening: TraitPageData["opening"];
}

const { opening }: Props = Astro.props;

const richBodyClass =
  "max-w-[40rem] text-[1rem] leading-7 text-(--text-primary) sm:text-[1.05rem] sm:leading-8 [&_strong]:font-semibold [&_strong]:text-(--text-primary)";
const richPreviewClass =
  "max-w-[38rem] text-[0.98rem] leading-7 text-(--text-secondary) sm:text-[1rem] sm:leading-8 [&_strong]:font-semibold [&_strong]:text-(--text-primary)";
const ghostWordClass =
  "pointer-events-none relative -mb-3 block whitespace-nowrap text-[clamp(2.2rem,9.2vw,3.3rem)] leading-[0.85] font-semibold tracking-[0.04em] text-(--t2a-blue)/18 opacity-70 mix-blend-multiply [-webkit-text-stroke:0.45px_var(--t2a-blue)] sm:-mb-5 sm:text-[4.8rem] md:text-[6rem] lg:absolute lg:-top-9 lg:left-0 lg:-translate-x-8 lg:text-[5.33rem] xl:text-[6.33rem] 2xl:text-[7.33rem] dark:opacity-55 dark:mix-blend-screen";
---

<section aria-labelledby="trait-page-title" class="relative w-full">
  <div
    class="relative z-10 mx-auto flex w-full max-w-7xl flex-col px-6 pb-12 pt-[calc(var(--header-height)+4rem)] sm:px-8 sm:pb-14 sm:pt-[calc(var(--header-height)+5rem)] lg:px-10 lg:pb-16 lg:pt-[calc(var(--header-height)+6rem)]"
  >
    <!-- vertical axis -->
    <TraitAxis
      bottom="calc(-8rem - 1.25px)"
      className={TRAIT_AXIS_LEFT}
      top="0"
    />

    <div
      class:list={["relative z-10 w-full lg:max-w-xl", TRAIT_NARRATIVE_INDENT]}
    >
      <!-- ghost word -->
      <p aria-hidden="true" class={ghostWordClass} data-reveal="fade">
        OUVERTURE
      </p>

      <!-- heading -->
      <h1
        id="trait-page-title"
        class="relative z-10 text-[clamp(3.5rem,14vw,7rem)] leading-[1.1] lg:leading-[1.7] font-light tracking-[0.02em] text-(--t2a-blue-dark) dark:text-(--t2a-blue)"
        data-reveal="fade-up"
      >
        {opening.heading}
      </h1>

      <div class="mt-8 flex flex-col gap-8 sm:mt-10 sm:gap-10">
        <!-- identity paragraph -->
        <div class="flex flex-col gap-3">
          <p
            class="text-[0.74rem] font-semibold uppercase tracking-[0.14em] text-(--t2a-blue-dark) [--reveal-delay:90ms] dark:text-(--t2a-blue)"
            data-reveal="fade"
          >
            {opening.identity.title}
          </p>
          <p
            class:list={[richBodyClass, "[--reveal-delay:140ms]"]}
            data-reveal="fade-up"
            set:html={opening.identity.body}
          />
        </div>

        <!-- project preview paragraph -->
        <div class="flex flex-col gap-3">
          <p
            class="text-[0.74rem] font-semibold uppercase tracking-[0.14em] text-(--text-muted) [--reveal-delay:210ms] dark:text-(--text-muted)"
            data-reveal="fade"
          >
            {opening.project.title}
          </p>
          <p
            class:list={[richPreviewClass, "[--reveal-delay:260ms]"]}
            data-reveal="fade-up"
            set:html={opening.project.preview}
          />
        </div>
      </div>
    </div>
  </div>
</section>
