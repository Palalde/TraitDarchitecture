---
import type { TraitPageData } from "@/components/trait/trait.data";
import TraitAxis from "@/components/trait/blocks/TraitAxis.astro";

interface Props {
  opening: TraitPageData["opening"];
}

const { opening }: Props = Astro.props;

const richBodyClass =
  "max-w-[40rem] text-[1rem] leading-7 text-(--text-primary) sm:text-[1.05rem] sm:leading-8 [&_strong]:font-semibold [&_strong]:text-(--text-primary)";
const richPreviewClass =
  "max-w-[38rem] text-[0.98rem] leading-7 text-(--text-secondary) sm:text-[1rem] sm:leading-8 [&_strong]:font-semibold [&_strong]:text-(--text-primary)";
const ghostWordClass =
  "pointer-events-none relative -mb-3 block whitespace-nowrap text-[3.3rem] leading-[0.8] font-semibold tracking-[0.04em] text-(--t2a-blue)/18 opacity-70 mix-blend-multiply [-webkit-text-stroke:0.45px_var(--t2a-blue)] sm:-mb-5 sm:text-[4.8rem] md:text-[6rem] lg:absolute lg:-top-9 lg:left-0 lg:-translate-x-8 lg:text-[5.33rem] xl:text-[6.33rem] 2xl:text-[7.33rem] dark:opacity-55 dark:mix-blend-screen";
---

<section aria-labelledby="trait-page-title" class="relative w-full">
  <div
    class="relative z-10 mx-auto flex w-full max-w-7xl flex-col px-6 pb-12 pt-[calc(var(--header-height)+4rem)] sm:px-8 sm:pb-14 sm:pt-[calc(var(--header-height)+5rem)] lg:px-10 lg:pb-16 lg:pt-[calc(var(--header-height)+6rem)]"
  >
    <!-- vertical axis -->
    <TraitAxis
      bottom="0"
      className="revealed left-6 sm:left-8 md:left-10 lg:left-[27%]"
      top="0"
    />

    <div
      class="relative z-10 w-full pl-10 sm:pl-12 md:pl-14 lg:ml-[31%] lg:max-w-xl lg:pl-0"
    >
      <!-- ghost word -->
      <p aria-hidden="true" class={ghostWordClass}>OUVERTURE</p>

      <!-- heading -->
      <h1
        id="trait-page-title"
        class="relative z-10 text-[clamp(3.5rem,14vw,7rem)] leading-[1.1] lg:leading-[1.7] font-light tracking-[0.02em] text-(--t2a-blue-dark) dark:text-(--t2a-blue)"
      >
        {opening.heading}
      </h1>

      <div class="mt-8 flex flex-col gap-8 sm:mt-10 sm:gap-10">
        <!-- identity paragraph -->
        <div class="flex flex-col gap-3">
          <p
            class="text-[0.74rem] font-semibold uppercase tracking-[0.14em] text-(--t2a-blue-dark) dark:text-(--t2a-blue)"
          >
            {opening.identity.title}
          </p>
          <p class={richBodyClass} set:html={opening.identity.body} />
        </div>

        <!-- project preview paragraph -->
        <div class="flex flex-col gap-3">
          <p
            class="text-[0.74rem] font-semibold uppercase tracking-[0.14em] text-(--text-muted) dark:text-(--text-muted)"
          >
            {opening.project.title}
          </p>
          <p class={richPreviewClass} set:html={opening.project.preview} />
        </div>
      </div>
    </div>
  </div>
</section>
