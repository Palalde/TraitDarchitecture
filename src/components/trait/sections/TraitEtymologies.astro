---
import type { TraitPageData } from "@/components/trait/trait.data";
import TraitEtymologyBlock from "@/components/trait/blocks/TraitEtymologyBlock.astro";

interface Props {
  etymologies: TraitPageData["etymologies"];
}

const { etymologies }: Props = Astro.props;
---

<section aria-labelledby="trait-etymologies-title" class="relative w-full">
  <div
    class="relative z-10 mx-auto w-full max-w-7xl px-6 pb-4 sm:px-8 sm:pb-6 lg:px-10 lg:pb-8"
  >
    <!-- sr-only heading -->
    <h2 id="trait-etymologies-title" class="sr-only">Étymologies</h2>

    <!-- etymology blocks (×3) -->
    <div class="relative z-10 flex flex-col">
      {
        etymologies.map((entry, index) => (
          <TraitEtymologyBlock
            entry={entry}
            index={index}
            isLast={index === etymologies.length - 1}
          />
        ))
      }
    </div>
  </div>
</section>
