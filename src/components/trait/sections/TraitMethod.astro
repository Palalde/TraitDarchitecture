---
import { Image } from "astro:assets";
import architectStatueImage from "@/assets/photos/TraiT/Architecte-statue.jpg";
import type { TraitPageData } from "@/components/trait/trait.data";
import {
  TRAIT_AXIS_LEFT,
  TRAIT_NARRATIVE_INDENT,
} from "@/components/trait/trait.classes";
import TraitServiceItem from "@/components/trait/blocks/TraitServiceItem.astro";
import CotationFrame from "@/components/ui/cotation/CotationFrame.astro";
import { ParallaxFrame } from "@/components/ui/media/ParallaxFrame";

interface Props {
  callout: TraitPageData["opening"]["callout"];
  method: TraitPageData["method"];
}

const { callout, method }: Props = Astro.props;

const richParagraphClass =
  "max-w-[46rem] text-[1rem] leading-7 text-(--text-primary) sm:text-[1.05rem] sm:leading-8 [&_strong]:font-semibold [&_strong]:text-(--text-primary)";
const calloutBodyClass =
  "max-w-[40rem] text-[0.98rem] leading-7 text-(--text-secondary) sm:text-[1rem] sm:leading-8 [&_strong]:font-semibold [&_strong]:text-(--text-primary)";
const ctaPromptClass =
  "max-w-[38rem] text-[1rem] leading-7 text-(--text-primary) sm:text-[1.05rem] sm:leading-8";
---

<section aria-labelledby="trait-method-title" class="relative w-full">
  <div
    class="relative z-10 mx-auto w-full max-w-7xl px-6 py-14 sm:px-8 sm:py-16 lg:px-10 lg:py-20"
  >
    <!-- vertical axis (static, full section height) -->
    <span
      aria-hidden="true"
      class:list={[
        "pointer-events-none absolute bottom-0 top-0 z-0 block w-px bg-(--trait)",
        TRAIT_AXIS_LEFT,
      ]}></span>

    <!-- narrative runway -->
    <div class="relative">
      <div class:list={["relative z-10 lg:max-w-4xl", TRAIT_NARRATIVE_INDENT]}>
        <!-- section title -->
        <h2
          id="trait-method-title"
          class="text-[0.76rem] font-semibold uppercase tracking-[0.16em] text-(--t2a-blue-dark) dark:text-(--t2a-blue)"
        >
          {method.title}
        </h2>

        <!-- editorial paragraphs -->
        <div class="mt-7 flex flex-col gap-5 sm:mt-8 sm:gap-6">
          {
            method.paragraphs.map((paragraph) => (
              <p class={richParagraphClass} set:html={paragraph} />
            ))
          }
        </div>

        <!-- open cotation callout -->
        <aside
          class="relative mt-10 max-w-3xl py-6 pl-7 sm:mt-12 sm:py-7 sm:pl-8 lg:ml-10"
        >
          <span
            aria-hidden="true"
            class="absolute left-0 top-0 block h-full w-px bg-(--trait)"></span>
          <span
            aria-hidden="true"
            class="absolute left-0 top-0 block h-px w-14 bg-(--trait) sm:w-16"
          ></span>
          <span
            aria-hidden="true"
            class="absolute bottom-0 left-0 block h-px w-14 bg-(--trait) sm:w-16"
          ></span>

          <h3
            class="text-[0.72rem] font-semibold uppercase tracking-[0.16em] text-(--t2a-blue-dark) dark:text-(--t2a-blue)"
          >
            {callout.title}
          </h3>
          <p class:list={[calloutBodyClass, "mt-4"]} set:html={callout.body} />
        </aside>

        <!-- services list + image -->
        <div class="mt-12 max-w-4xl sm:mt-14 lg:ml-10">
          <div
            class="grid gap-7 sm:gap-8 lg:grid-cols-[16rem_minmax(0,1fr)] lg:items-stretch lg:gap-10"
          >
            <!-- services image -->
            <figure class="relative w-full max-w-72 sm:max-w-80 lg:max-w-none">
              <CotationFrame aspectRatio="4:5" revealCotation={false}>
                <ParallaxFrame
                  client:visible
                  overflowPercent={0.025}
                  mobileOverflowPercent={0.04}
                >
                  <Image
                    alt="Statuette d'architecte tenant un plan de l'atelier"
                    class="h-full w-full object-cover object-center grayscale"
                    draggable="false"
                    format="webp"
                    loading="lazy"
                    quality={72}
                    sizes="(min-width: 1024px) 16rem, (min-width: 640px) 20rem, calc(100vw - 6.5rem)"
                    src={architectStatueImage}
                    widths={[240, 320, 420, 560]}
                  />
                </ParallaxFrame>
              </CotationFrame>
            </figure>

            <!-- services text -->
            <div class="flex h-full flex-col">
              <h3
                class="text-[0.72rem] font-semibold uppercase tracking-[0.16em] text-(--t2a-blue-dark) dark:text-(--t2a-blue)"
              >
                Services
              </h3>

              <ul
                class="mt-6 flex flex-1 flex-col gap-4 sm:gap-5 lg:gap-0 lg:justify-between"
                aria-label="Services d'accompagnement"
              >
                {
                  method.services.map((service) => (
                    <TraitServiceItem service={service} />
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- contact cta -->
    <div
      class:list={[
        "relative z-10 mt-10 sm:mt-12 lg:max-w-4xl",
        TRAIT_NARRATIVE_INDENT,
      ]}
    >
      <div class="max-w-3xl lg:ml-10">
        <p class={ctaPromptClass}>{method.cta.prompt}</p>

        <a
          href={method.cta.href}
          class="mt-6 inline-flex items-center justify-center border border-(--t2a-blue) bg-transparent px-6 py-3 text-[0.78rem] font-semibold uppercase tracking-[0.14em] text-(--t2a-blue-dark) transition-colors duration-200 ease-out hover:bg-(--t2a-blue-wash) hover:text-(--t2a-blue-dark) focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-(--trait) focus-visible:ring-offset-2 focus-visible:ring-offset-(--bg-primary) dark:text-(--t2a-blue) dark:hover:bg-(--t2a-blue-pale) dark:hover:text-(--t2a-blue-dark)"
        >
          {method.cta.label}
        </a>
      </div>
    </div>
  </div>
</section>
