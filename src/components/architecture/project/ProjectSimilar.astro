---
import type { CollectionEntry } from "astro:content";
import { getSimilarProjects } from "@/components/architecture/architecture.data";
import ProjectCard from "@/components/architecture/blocks/ProjectCard.astro";

interface Props {
  entry: CollectionEntry<"projects">;
  allProjects: CollectionEntry<"projects">[];
}

const { entry, allProjects }: Props = Astro.props;
const similarProjects = await getSimilarProjects(entry, allProjects);
const INDEX_SIZES = "(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw";
---

{
  similarProjects.length > 0 && (
    <section
      aria-labelledby="project-similar-heading"
      class="mt-12 lg:col-span-2 lg:mt-16"
    >
      <div>
        <h2
          id="project-similar-heading"
          class="text-[0.75rem] font-normal uppercase tracking-[0.14em] text-(--text-muted) [--reveal-delay:0ms]"
          data-reveal="fade-up"
        >
          Projets similaires
        </h2>
        <span
          aria-hidden="true"
          class="mt-3 block h-px w-24 bg-(--trait) [--reveal-delay:60ms] sm:w-32"
          data-reveal="bar-from-left"
        />
      </div>

      <ul class="mt-6 grid grid-cols-1 items-start gap-6 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
        {similarProjects.map((project, index) => {
          const slug = project.id.replace(/\/index$/, "");
          const { name, city, dept, cover, coverAlt, coverRatio } =
            project.data;

          return (
            <li
              data-reveal="fade-up"
              class:list={[index >= 2 ? "max-lg:hidden" : undefined]}
              style={`--reveal-delay:${index * 60}ms;`}
            >
              <ProjectCard
                coverRatio={coverRatio}
                image={cover}
                imageAlt={coverAlt}
                label={name}
                subtitle={`${city} (${dept})`}
                href={`/architecture/${slug}`}
                sizes={INDEX_SIZES}
                showTouchArrow={false}
                parallax
                alwaysClickable
              />
            </li>
          );
        })}
      </ul>
    </section>
  )
}
