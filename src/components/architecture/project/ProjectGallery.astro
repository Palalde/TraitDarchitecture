---
import { Image } from "astro:assets";
import type { GalleryImage } from "@/components/architecture/architecture.data";
import CotationFrame from "@/components/ui/cotation/CotationFrame.astro";
import FigCaption from "@/components/ui/cotation/FigCaption.astro";
import { ParallaxFrame } from "@/components/ui/media/ParallaxFrame";
import MasonrySetup from "@/components/ui/masonry/MasonrySetup.astro";

interface Props {
  images: GalleryImage[];
}

const { images }: Props = Astro.props;
const previewImages = images.slice(0, 6);
const hasMore = images.length > previewImages.length;

const GALLERY_SIZES =
  "(min-width: 1280px) 34rem, (min-width: 640px) 50vw, 100vw";
---

{
  previewImages.length > 0 && (
    <section
      aria-labelledby="project-gallery-heading"
      class="mt-12 lg:col-span-2 lg:mt-16"
    >
      <div>
        <h2
          id="project-gallery-heading"
          class="text-[0.75rem] font-normal uppercase tracking-[0.14em] text-(--text-muted) [--reveal-delay:0ms]"
          data-reveal="fade-up"
        >
          Galerie
        </h2>
        <span
          aria-hidden="true"
          class="mt-3 block h-px w-24 bg-(--trait) [--reveal-delay:60ms] sm:w-32"
          data-reveal="bar-from-left"
        />
      </div>

      <ul
        data-masonry
        class="mt-6 grid grid-cols-1 items-start gap-6 [--masonry-cols:1] [--masonry-gap:24px] sm:grid-cols-2 sm:[--masonry-cols:2] sm:gap-8 sm:[--masonry-gap:32px]"
      >
        {previewImages.map((image, index) => {
          const aspectStyle = `aspect-ratio:${image.src.width} / ${image.src.height}`;
          const revealDelay = `${index * 100}ms`;

          return (
            <li
              data-masonry-item
              data-reveal="wipe-from-left"
              style={`--reveal-d:500ms; --reveal-delay:${revealDelay};`}
            >
              <figure class="border border-(--border) bg-(--bg-primary)">
                <CotationFrame
                  contentStyle={aspectStyle}
                  revealCotation={index === 0}
                  showBorder={false}
                  showCotation={index === 0}
                >
                  <ParallaxFrame
                    client:visible
                    overflowPercent={0.02}
                    mobileOverflowPercent={0.03}
                  >
                    <Image
                      alt={image.alt}
                      class="h-full w-full object-cover"
                      draggable="false"
                      loading="lazy"
                      quality={85}
                      sizes={GALLERY_SIZES}
                      src={image.src}
                      widths={[400, 600, 800, 1200, 1600]}
                    />
                  </ParallaxFrame>
                </CotationFrame>

                <FigCaption
                  className="px-4 pb-4"
                  figureId={image.plate}
                  label={image.caption}
                />
              </figure>
            </li>
          );
        })}
      </ul>

      <MasonrySetup />

      {hasMore && (
        <button
          type="button"
          disabled
          aria-disabled="true"
          class="mt-6 inline-flex w-fit items-center gap-1.5 text-[0.78rem] uppercase tracking-widest text-(--text-muted) transition-colors duration-200 disabled:cursor-default disabled:opacity-100"
          data-reveal="fade-up"
          style={`--reveal-delay:${previewImages.length * 100 + 80}ms;`}
        >
          <span class="underline decoration-(--trait) decoration-1 underline-offset-2">
            Voir la galerie
          </span>
        </button>
      )}
    </section>
  )
}
