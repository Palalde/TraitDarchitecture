---
import { Image } from "astro:assets";
import type { GalleryImage } from "@/components/architecture/architecture.data";
import { ParallaxFrame } from "@/components/ui/media/ParallaxFrame";
import MasonrySetup from "@/components/ui/masonry/MasonrySetup.astro";

interface Props {
  images: GalleryImage[];
}

const { images }: Props = Astro.props;
const previewImages = images.slice(0, 6);

const GALLERY_SIZES =
  "(min-width: 1280px) 34rem, (min-width: 640px) 50vw, 100vw";
---

{
  previewImages.length > 0 && (
    <section
      aria-labelledby="project-gallery-heading"
      class="mt-12 lg:col-span-2 lg:mt-16"
    >
      <div>
        <h2
          id="project-gallery-heading"
          class="text-[0.75rem] font-normal uppercase tracking-[0.14em] text-(--text-muted) [--reveal-delay:0ms]"
          data-reveal="fade-up"
        >
          Galerie
        </h2>
        <span
          aria-hidden="true"
          class="mt-3 block h-px w-24 bg-(--trait) [--reveal-delay:60ms] sm:w-32"
          data-reveal="bar-from-left"
        />
      </div>

      <ul
        data-masonry
        class="mt-6 grid grid-cols-1 items-start gap-6 [--masonry-cols:1] [--masonry-gap:24px] sm:grid-cols-2 sm:[--masonry-cols:2] sm:gap-8 sm:[--masonry-gap:32px]"
      >
        {previewImages.map((image, index) => {
          const aspectStyle = `aspect-ratio:${image.src.width} / ${image.src.height}`;
          const revealDelay = `${index * 100}ms`;
          const imageLabel = image.caption || image.alt;

          return (
            <li
              data-masonry-item
              data-reveal="fade-up"
              style={`--reveal-delay:${revealDelay};`}
            >
              <div class="relative w-full overflow-hidden" style={aspectStyle}>
                <ParallaxFrame
                  client:visible
                  overflowPercent={0.02}
                  mobileOverflowPercent={0.03}
                >
                  <Image
                    alt={image.alt}
                    class="h-full w-full object-cover"
                    draggable="false"
                    loading="lazy"
                    quality={85}
                    sizes={GALLERY_SIZES}
                    src={image.src}
                    widths={[400, 600, 800, 1200, 1600]}
                  />
                </ParallaxFrame>

                <button
                  type="button"
                  class="group absolute inset-0 z-20 flex cursor-zoom-in items-center justify-center bg-transparent p-0 transition-colors duration-200 can-hover:hover:bg-(--t2a-blue)/5 focus-visible:bg-(--t2a-blue)/5"
                  aria-label={`Agrandir la photo — ${imageLabel}`}
                  data-gallery-open={String(index + 1)}
                >
                  <span class="pointer-events-none inline-flex items-center gap-1 border border-(--trait) bg-(--bg-primary)/80 px-2 py-1 text-[0.6rem] uppercase tracking-[0.14em] text-(--t2a-blue) opacity-0 transition-opacity duration-200 can-hover:group-hover:opacity-100 focus-visible:opacity-100">
                    <span
                      aria-hidden="true"
                      class="text-[0.85rem] leading-none"
                    >
                      ↗
                    </span>
                    <span>Agrandir</span>
                  </span>
                </button>
              </div>
            </li>
          );
        })}
      </ul>

      <MasonrySetup />

      <button
        type="button"
        class="group mt-6 inline-flex w-fit cursor-pointer items-center gap-2 text-[0.78rem] uppercase tracking-widest text-(--text-muted) transition-colors duration-200 can-hover:hover:text-(--t2a-blue)"
        data-reveal="fade-up"
        style={`--reveal-delay:${previewImages.length * 100 + 80}ms;`}
        data-gallery-open="0"
      >
        <span class="inline-flex items-center gap-2 border border-(--trait) px-3 py-2 transition-colors duration-200 can-hover:group-hover:bg-(--t2a-blue)/5">
          <span class="text-[0.65rem] leading-none" aria-hidden="true">
            ↗
          </span>
          <span class="underline decoration-(--trait) decoration-1 underline-offset-2">
            Voir la galerie
          </span>
        </span>
      </button>
    </section>
  )
}
