---
import { render, type CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"projects">;
}

const { entry }: Props = Astro.props;
const { Content } = await render(entry);
---

<div
  class="narrative-body max-w-[65ch] text-[1.0625rem] leading-8 text-(--text-primary)"
  data-reveal="fade-up"
>
  <Content />
</div>

{
  /*
  Exception to "Tailwind inline only":
  Markdown rendered via <Content /> cannot be styled inline.
  Scoped <style> is the official Astro primitive for this use case (no new dep).
  Hierarchy: body paragraphs = primary, ## blocks = visually secondary.
*/
}
<style>
  /* Primary body — paragraphs before any ## heading */
  .narrative-body :global(p) {
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }

  /* Secondary block heading — ## in Markdown → <h2> */
  .narrative-body :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 0.5rem;
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  /* Secondary paragraphs — those following a ## heading */
  .narrative-body :global(h2 ~ p) {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
  }

  /* Lists in secondary blocks */
  .narrative-body :global(h2 ~ ul),
  .narrative-body :global(h2 ~ ol) {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    padding-left: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .narrative-body :global(h2 ~ li) {
    margin-bottom: 0.375rem;
  }
</style>
