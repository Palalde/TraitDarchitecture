---
import { render, type CollectionEntry } from "astro:content";
import Prose from "@/components/ui/prose/Prose.astro";

interface Props {
  entry: CollectionEntry<"projects">;
}

const { entry }: Props = Astro.props;
const { Content } = await render(entry);
---

<Prose data-narrative>
  <Content />
</Prose>

<script is:inline data-astro-rerun>
  (() => {
    const body = document.querySelector("[data-narrative]");
    if (!body) return;

    Array.from(body.children).forEach((el, index) => {
      el.setAttribute("data-reveal", "fade-up");
      el.style.setProperty("--reveal-delay", `${index * 40}ms`);
    });
  })();
</script>
