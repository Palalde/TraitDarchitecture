---
import { render, type CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"projects">;
}

const { entry }: Props = Astro.props;
const { Content } = await render(entry);
---

<div
  data-narrative
  class="narrative-body max-w-[65ch] text-[1.0625rem] leading-8 text-(--text-primary)"
>
  <Content />
</div>

<script is:inline data-astro-rerun>
  (() => {
    const body = document.querySelector("[data-narrative]");
    if (!body) return;

    Array.from(body.children).forEach((el, index) => {
      el.setAttribute("data-reveal", "fade-up");
      el.style.setProperty("--reveal-delay", `${index * 40}ms`);
    });
  })();
</script>

{
  /*
  Exception to "Tailwind inline only":
  Markdown rendered via <Content /> cannot be styled inline.
  Scoped <style> is the official Astro primitive for this use case (no new dep).
  Hierarchy:
    - paragraphs keep the main reading rhythm;
    - a bare ## / ### draws a horizontal divider trait;
    - a blockquote (>) flows as secondary-register text (--text-secondary,
      0.9375rem), usable in both primary and secondary descriptions.
*/
}
<style>
  /* Primary body paragraphs */
  .narrative-body :global(p) {
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }

  /* Bold emphasis — **texte** in Markdown → <strong>.
     Pinned to 600 (the heaviest weight the T2A font ships) so it never
     falls back to a synthetic 700; keeps the same colour as its context. */
  .narrative-body :global(strong) {
    font-weight: 600;
    color: inherit;
  }

  /* Section heading — a bare ## / ### draws a horizontal divider trait. */
  .narrative-body :global(:is(h2, h3)) {
    margin-top: 2.5rem;
    margin-bottom: 0.5rem;
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .narrative-body :global(:is(ul, ol)) {
    padding-left: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .narrative-body :global(li) {
    margin-bottom: 0.375rem;
  }

  /* Blockquote (>) — secondary-register text with left-border aside.
     colour + size match description secondaire, usable in both primary
     and secondary contexts. */
  .narrative-body :global(blockquote) {
    margin: 2rem 0;
    padding: 0.25rem 0 0.25rem 1.25rem;
    border-left: 1px solid var(--border);
    color: var(--text-secondary);
  }

  .narrative-body :global(blockquote p) {
    font-size: 0.9375rem;
    color: inherit;
    margin-bottom: 1rem;
  }

  .narrative-body :global(blockquote :is(p, ul, ol):last-child) {
    margin-bottom: 0;
  }

  .narrative-body :global(blockquote :is(ul, ol)) {
    margin-bottom: 1rem;
  }
</style>
