---
import { render, type CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"projects">;
}

const { entry }: Props = Astro.props;
const { Content } = await render(entry);
---

<div
  data-narrative
  class="narrative-body max-w-[65ch] text-[1.0625rem] leading-8 text-(--text-primary) lg:max-w-[75ch]"
>
  <Content />
</div>

{
  /* Split reveal: primary description (children before the first <h2>) and
    secondary block (first <h2> and after) get separate delays. Markdown
    children can't carry data-reveal server-side, so they are tagged at parse
    time — before the deferred project-body controller starts and scans its
    targets. Reduced motion is covered by CSS ([data-reveal] is forced
    visible), and without JS nothing is tagged → content stays visible. */
}
<script is:inline data-astro-rerun>
  (() => {
    const body = document.querySelector("[data-narrative]");
    if (!body) return;

    let secondary = false;
    for (const el of body.children) {
      if (el.tagName === "H2") secondary = true;
      el.setAttribute("data-reveal", "fade-up");
      el.style.setProperty("--reveal-delay", secondary ? "150ms" : "0ms");
    }
  })();
</script>

{
  /*
  Exception to "Tailwind inline only":
  Markdown rendered via <Content /> cannot be styled inline.
  Scoped <style> is the official Astro primitive for this use case (no new dep).
  Hierarchy: body paragraphs = primary, ## blocks = visually secondary.
*/
}
<style>
  /* Primary body — paragraphs before any ## heading */
  .narrative-body :global(p) {
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }

  /* Bold emphasis — **texte** in Markdown → <strong>.
     Pinned to 600 (the heaviest weight the T2A font ships) so it never
     falls back to a synthetic 700; keeps the same colour as its context. */
  .narrative-body :global(strong) {
    font-weight: 600;
    color: inherit;
  }

  /* Secondary block heading — ## in Markdown → <h2> */
  .narrative-body :global(h2) {
    /* flow-root → the heading box (and its border-bottom trait) shrinks
       beside the floated cover instead of running full width under it. */
    display: flow-root;
    margin-top: 2.5rem;
    margin-bottom: 0.5rem;
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  /* Secondary paragraphs — those following a ## heading */
  .narrative-body :global(h2 ~ p) {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
  }

  /* Lists in secondary blocks */
  .narrative-body :global(h2 ~ ul),
  .narrative-body :global(h2 ~ ol) {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    padding-left: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .narrative-body :global(h2 ~ li) {
    margin-bottom: 0.375rem;
  }
</style>
