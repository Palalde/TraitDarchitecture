---
import { render, type CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"projects">;
}

const { entry }: Props = Astro.props;
const { Content } = await render(entry);
---

<div
  data-narrative
  class="narrative-body max-w-[65ch] text-[1.0625rem] leading-8 text-(--text-primary) lg:max-w-[75ch]"
>
  <Content />
</div>

{
  /* Split reveal: the secondary register (everything after the first ## / ###
    section heading, plus any blockquote aside) gets a slightly later delay
    than the primary flow. Markdown children can't carry data-reveal
    server-side, so they are tagged at parse time — before the deferred
    project-body controller starts and scans its targets. Reduced motion is
    covered by CSS ([data-reveal] is forced visible), and without JS nothing is
    tagged → content stays visible. */
}
<script is:inline data-astro-rerun>
  (() => {
    const body = document.querySelector("[data-narrative]");
    if (!body) return;

    let secondary = false;
    for (const el of body.children) {
      if (el.tagName === "H2" || el.tagName === "H3") secondary = true;
      const isSecondary = secondary || el.tagName === "BLOCKQUOTE";
      el.setAttribute("data-reveal", "fade-up");
      el.style.setProperty("--reveal-delay", isSecondary ? "150ms" : "0ms");
    }
  })();
</script>

{
  /*
  Exception to "Tailwind inline only":
  Markdown rendered via <Content /> cannot be styled inline.
  Scoped <style> is the official Astro primitive for this use case (no new dep).
  Hierarchy:
    - normal flow before any ## / ### = primary;
    - a bare ## / ### draws a horizontal divider trait, and everything after it
      reads as secondary;
    - a blockquote (>) is an untitled secondary aside, placeable anywhere.
*/
}
<style>
  /* Primary body paragraphs */
  .narrative-body :global(p) {
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }

  /* Bold emphasis — **texte** in Markdown → <strong>.
     Pinned to 600 (the heaviest weight the T2A font ships) so it never
     falls back to a synthetic 700; keeps the same colour as its context. */
  .narrative-body :global(strong) {
    font-weight: 600;
    color: inherit;
  }

  /* Section heading — a bare ## / ### draws a horizontal divider trait.
     flow-root → the heading box (and its border-bottom trait) shrinks beside
     the floated cover instead of running full width under it. */
  .narrative-body :global(:is(h2, h3)) {
    display: flow-root;
    margin-top: 2.5rem;
    margin-bottom: 0.5rem;
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  /* Secondary register — everything after a section heading reads smaller and
     in the secondary colour (general sibling: no return to primary afterwards). */
  .narrative-body :global(:is(h2, h3) ~ p) {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
  }

  .narrative-body :global(:is(h2, h3) ~ :is(ul, ol)) {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    padding-left: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .narrative-body :global(:is(h2, h3) ~ * li) {
    margin-bottom: 0.375rem;
  }

  /* Secondary aside — untitled Markdown blockquote (>), interleavable anywhere.
     flow-root keeps its left trait beside the floated cover. */
  .narrative-body :global(blockquote) {
    display: flow-root;
    margin: 2rem 0;
    padding: 0.25rem 0 0.25rem 1.25rem;
    border-left: 1px solid var(--border);
  }

  .narrative-body :global(blockquote p) {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .narrative-body :global(blockquote :is(p, ul, ol):last-child) {
    margin-bottom: 0;
  }

  .narrative-body :global(blockquote :is(ul, ol)) {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    padding-left: 1.25rem;
    margin-bottom: 1rem;
  }

  .narrative-body :global(blockquote li) {
    margin-bottom: 0.375rem;
  }
</style>
