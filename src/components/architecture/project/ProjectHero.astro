---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import CotationFrame from "@/components/ui/cotation/CotationFrame.astro";
import FigCaption from "@/components/ui/cotation/FigCaption.astro";
import { ParallaxFrame } from "@/components/ui/media/ParallaxFrame";
import {
  ZONE_LABELS,
  STATUS_LABELS,
} from "@/components/architecture/architecture.data";

interface Props {
  entry: CollectionEntry<"projects">;
}

const { entry }: Props = Astro.props;
const { name, city, dept, zone, year, status, cover, coverAlt, coverRatio } =
  entry.data;

const locationLine = `${city} (${dept}) — ${ZONE_LABELS[zone]}`;

const metaParts = [
  year != null ? String(year) : null,
  status != null ? STATUS_LABELS[status] : null,
].filter((v): v is string => v !== null);
const metaLine = metaParts.join(" · ");

// Per-ratio config — desktop float layout (cover floated right, cartouche +
// narrative flow left of it, text wraps below when longer than the cover).
// cotation: CotationFrame expects colon notation ("5:4").
// maxW: caps the stacked figure below lg (the float width governs at lg+).
// float: floated width by ratio — wider image takes more of the row,
//   portrait gets breathing room.
// sizes: matches the lg+ float width and the xl cap (max-w-7xl − px-10 ≈ 1200px).
const RATIO_CONFIG = {
  "1/1": {
    cotation: "1:1",
    maxW: "max-w-3xl",
    float: "lg:w-[48%]",
    sizes: "(min-width: 1280px) 36rem, (min-width: 1024px) 48vw, 100vw",
  },
  "5/4": {
    cotation: "5:4",
    maxW: "max-w-4xl",
    float: "lg:w-[55%]",
    sizes: "(min-width: 1280px) 41rem, (min-width: 1024px) 55vw, 100vw",
  },
  "4/5": {
    cotation: "4:5",
    maxW: "max-w-2xl",
    float: "lg:w-[40%]",
    sizes: "(min-width: 1280px) 30rem, (min-width: 1024px) 40vw, 100vw",
  },
} as const;
const ratio = RATIO_CONFIG[coverRatio];
---

{
  /* Hero cover — plate figure 01 (LCP image).
    First in DOM so the lg+ float starts at the top of the flow container
    (a float only escapes upward of nothing — placed after the cartouche it
    would start below it). Mobile/tablet order (cartouche first) is restored
    by order-* on the parent's flex-col. The figure holds no focusable
    element, so tab order is unaffected. */
}
<figure
  class:list={[
    "order-2 mt-8 w-full sm:mt-12 lg:float-right lg:mb-10 lg:ml-10 lg:mt-0 lg:max-w-none",
    ratio.maxW,
    ratio.float,
  ]}
>
  <CotationFrame
    aspectRatio={ratio.cotation}
    revealBorder
    revealCotation
    showCotation
  >
    <ParallaxFrame
      client:visible
      overflowPercent={0.025}
      mobileOverflowPercent={0.04}
    >
      <Image
        src={cover}
        alt={coverAlt}
        class="h-full w-full object-cover"
        draggable="false"
        loading="eager"
        fetchpriority="high"
        quality={85}
        widths={[800, 1200, 1600]}
        sizes={ratio.sizes}
      />
    </ParallaxFrame>
  </CotationFrame>
  <FigCaption figureId="01" label={coverAlt} />
</figure>

{
  /* Cartouche — flows left of the floated cover on desktop (line boxes avoid
    the float), stacked first on mobile/tablet via order-1. */
}
<div class="order-1 flex flex-col">
  {/* Back link — first focusable element after the header */}
  <a
    href="/architecture"
    class="group mb-6 inline-flex w-fit items-center gap-1.5 text-[0.78rem] uppercase tracking-widest text-(--text-muted) transition-colors duration-200 can-hover:hover:text-(--t2a-blue)"
    data-reveal="fade"
    style="--reveal-delay:0ms;"
  >
    <span
      class="inline-block transition-transform duration-200 can-hover:group-hover:-translate-x-0.5"
      aria-hidden="true">←</span
    >
    <span
      class="underline decoration-(--trait) decoration-1 underline-offset-2 transition-[text-decoration-color] duration-200 can-hover:group-hover:decoration-(--t2a-blue)"
      >Retour aux projets</span
    >
  </a>

  {/* H1 — project name, same scale as index H1 */}
  <h1
    id="project-page-title"
    class="text-[clamp(2.25rem,7vw,4rem)] font-light leading-[1.05] tracking-[0.02em] text-(--t2a-blue-dark) [--reveal-delay:60ms] dark:text-(--t2a-blue)"
    data-reveal="fade-up"
  >
    {name}
  </h1>

  {/* Trait */}
  <span
    aria-hidden="true"
    class="mt-4 block h-px w-24 bg-(--trait) [--reveal-d:480ms] [--reveal-delay:120ms] sm:w-32"
    data-reveal="bar-from-left"></span>

  {/* Location line */}
  <p
    class="mt-4 text-[0.95rem] leading-6 text-(--text-secondary) [--reveal-delay:180ms] sm:text-[1rem]"
    data-reveal="fade-up"
  >
    {locationLine}
  </p>

  {
    /* Meta line (year · status) — rendered only when at least one value exists */
  }
  {
    metaLine && (
      <p
        class="mt-1.5 text-[0.75rem] uppercase tracking-widest text-(--text-muted) [--reveal-delay:240ms]"
        data-reveal="fade-up"
      >
        {metaLine}
      </p>
    )
  }
</div>
