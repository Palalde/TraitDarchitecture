---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import CotationFrame from "@/components/ui/cotation/CotationFrame.astro";
import FigCaption from "@/components/ui/cotation/FigCaption.astro";
import { ParallaxFrame } from "@/components/ui/media/ParallaxFrame";
import {
  ZONE_LABELS,
  STATUS_LABELS,
} from "@/components/architecture/architecture.data";

interface Props {
  entry: CollectionEntry<"projects">;
  hasGallery?: boolean;
}

const { entry, hasGallery = false }: Props = Astro.props;
const { name, city, dept, zone, year, status, cover, coverAlt, coverRatio } =
  entry.data;

const locationLine = `${city} (${dept}) — ${ZONE_LABELS[zone]}`;

const metaParts = [
  year != null ? String(year) : null,
  status != null ? STATUS_LABELS[status] : null,
].filter((v): v is string => v !== null);
const metaLine = metaParts.join(" · ");

// Per-ratio config — desktop sticky layout (cover in the right grid column).
// cotation: CotationFrame expects colon notation ("5:4").
// maxW: caps the stacked figure below lg.
// fit: cover width/height ratio, used to cap the figure width so that
//   image + figcaption always fit in the viewport (laptops included):
//   width ≤ (100dvh − header − 7rem) × fit.
const RATIO_CONFIG = {
  "1/1": { cotation: "1:1", maxW: "max-w-3xl", fit: 1 },
  "5/4": { cotation: "5:4", maxW: "max-w-4xl", fit: 1.25 },
  "4/5": { cotation: "4:5", maxW: "max-w-2xl", fit: 0.8 },
} as const;
const ratio = RATIO_CONFIG[coverRatio];

// Cover column ≈ half of (max-w-7xl − px-10 − gap) → ~36rem at the xl cap.
const COVER_SIZES =
  "(min-width: 1280px) 36rem, (min-width: 1024px) 50vw, 100vw";

// Sticky knobs as inline-style CSS vars (atelier pattern — avoids minting
// per-ratio arbitrary utility classes).
// top = 0 → the cover sticks to the very top of the viewport (the auto-hide
// header slides over it when it comes back, as on /atelier narrow mobile).
// max-width is height-driven so image + figcaption together fill the whole
// viewport height: image height = 100dvh − 2.5rem (the figcaption block),
// then width = height × fit.
const stickyFigureStyle = [
  "--project-cover-top: 5px",
  `--project-cover-max-width: min(100%, calc((100dvh - 2.5rem) * ${ratio.fit}))`,
].join("; ");
---

{
  /* Cartouche — left grid column (row 1) on desktop; first in the stacked
    mobile/tablet flow (DOM order = reading order, no order-* needed). */
}
<div class="flex flex-col lg:col-start-1 lg:row-start-1">
  {/* Back link — first focusable element after the header */}
  <a
    href="/architecture"
    class="group mb-6 inline-flex w-fit items-center gap-1.5 text-[0.78rem] uppercase tracking-widest text-(--text-muted) transition-colors duration-200 can-hover:hover:text-(--t2a-blue)"
    data-reveal="fade"
    style="--reveal-delay:0ms;"
  >
    <span
      class="inline-block transition-transform duration-200 can-hover:group-hover:-translate-x-0.5"
      aria-hidden="true">←</span
    >
    <span
      class="underline decoration-(--trait) decoration-1 underline-offset-2 transition-[text-decoration-color] duration-200 can-hover:group-hover:decoration-(--t2a-blue)"
      >Retour aux projets</span
    >
  </a>

  {/* H1 — project name, same scale as index H1 */}
  <h1
    id="project-page-title"
    class="text-[clamp(2.25rem,7vw,4rem)] font-light leading-[1.05] tracking-[0.02em] text-(--t2a-blue-dark) [--reveal-delay:60ms] dark:text-(--t2a-blue)"
    data-reveal="fade-up"
  >
    {name}
  </h1>

  {/* Trait */}
  <span
    aria-hidden="true"
    class="mt-4 block h-px w-24 bg-(--trait) [--reveal-d:480ms] [--reveal-delay:120ms] sm:w-32"
    data-reveal="bar-from-left"></span>

  {/* Location line */}
  <p
    class="mt-4 text-[0.95rem] leading-6 text-(--text-secondary) [--reveal-delay:180ms] sm:text-[1rem]"
    data-reveal="fade-up"
  >
    {locationLine}
  </p>

  {
    /* Meta line (year · status) — rendered only when at least one value exists */
  }
  {
    metaLine && (
      <p
        class="mt-1.5 text-[0.75rem] uppercase tracking-widest text-(--text-muted) [--reveal-delay:240ms]"
        data-reveal="fade-up"
      >
        {metaLine}
      </p>
    )
  }
</div>

{
  /* Hero cover — plate figure 01 (LCP image).
    Desktop: the cover lives in the right grid column.
    ⚠️ The sticky figure is wrapped in a REAL (non display:contents) block that
    occupies the grid area (col 2, rows 1-2 = cartouche + narrative). Why: the
    figure's box-tree parent ([data-project-head]) is lg:contents, and Chrome
    then bounds a sticky grid item to the GRID CONTAINER (which spans the facts
    row) instead of its grid area → the cover ran all the way under the whole
    fiche technique. Giving the figure an explicit block containing block makes
    it release exactly at the wrapper bottom = top of the facts row.
    Width capped per ratio (--project-cover-max-width) so image + figcaption fit
    the viewport. Sticky + parallax combine as on /atelier. */
}
<div class="lg:col-start-2 lg:row-span-2 lg:row-start-1">
  <figure
    class:list={[
      "mt-8 w-full sm:mt-12 lg:sticky lg:top-(--project-cover-top) lg:mx-auto lg:mt-0 lg:max-w-(--project-cover-max-width)",
      ratio.maxW,
    ]}
    style={stickyFigureStyle}
  >
    <CotationFrame
      aspectRatio={ratio.cotation}
      revealBorder
      revealCotation
      showCotation
    >
      {
        /* progressAnchorSelector (atelier pattern): a sticky frame's own rect is
          frozen in the viewport while stuck → progress stalls and the parallax
          dies. The anchor (resolved via closest()) is the scrolling grid
          container in ProjectShell, whose traversal drives the progress. */
      }
      <ParallaxFrame
        client:visible
        overflowPercent={0.025}
        mobileOverflowPercent={0.04}
        progressAnchorSelector="[data-parallax-anchor]"
      >
        <Image
          src={cover}
          alt={coverAlt}
          class="h-full w-full object-cover"
          draggable="false"
          loading="eager"
          fetchpriority="high"
          quality={85}
          widths={[800, 1200, 1600]}
          sizes={COVER_SIZES}
        />
      </ParallaxFrame>

      {
        hasGallery && (
          <button
            type="button"
            class="group absolute inset-0 z-20 flex cursor-zoom-in items-center justify-center bg-transparent p-0 transition-colors duration-200 can-hover:hover:bg-(--t2a-blue)/5 focus-visible:bg-(--t2a-blue)/5"
            aria-label={`Agrandir la photo — ${coverAlt}`}
            data-gallery-open="0"
          >
            <span class="pointer-events-none inline-flex items-center gap-1 border border-(--trait) bg-(--bg-primary)/80 px-2 py-1 text-[0.6rem] uppercase tracking-[0.14em] text-(--t2a-blue) opacity-0 transition-opacity duration-200 can-hover:group-hover:opacity-100 focus-visible:opacity-100">
              <span aria-hidden="true" class="text-[0.85rem] leading-none">
                ↗
              </span>
              <span>Agrandir</span>
            </span>
          </button>
        )
      }
    </CotationFrame>
    <FigCaption figureId="01" label={coverAlt} />
  </figure>
</div>
