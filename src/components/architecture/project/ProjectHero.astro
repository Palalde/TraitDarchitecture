---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import CotationFrame from "@/components/ui/cotation/CotationFrame.astro";
import FigCaption from "@/components/ui/cotation/FigCaption.astro";
import { ParallaxFrame } from "@/components/ui/media/ParallaxFrame";
import {
  ZONE_LABELS,
  STATUS_LABELS,
} from "@/components/architecture/architecture.data";

interface Props {
  entry: CollectionEntry<"projects">;
}

const { entry }: Props = Astro.props;
const { name, city, dept, zone, year, status, cover, coverAlt, coverRatio } =
  entry.data;

const locationLine = `${city} (${dept}) — ${ZONE_LABELS[zone]}`;

const metaParts = [
  year != null ? String(year) : null,
  status != null ? STATUS_LABELS[status] : null,
].filter((v): v is string => v !== null);
const metaLine = metaParts.join(" · ");

// Width calibrated by ratio for ~60-70vh perceived height on desktop (§ 3.3)
const MAX_W_CLASS = {
  "1/1": "max-w-3xl",
  "5/4": "max-w-4xl",
  "4/5": "max-w-2xl",
} as const;
const maxWClass = MAX_W_CLASS[coverRatio];

// CotationFrame expects colon notation ("5:4"), frontmatter uses slash ("5/4")
const COTATION_RATIO = {
  "1/1": "1:1",
  "5/4": "5:4",
  "4/5": "4:5",
} as const;
const cotationRatio = COTATION_RATIO[coverRatio];

// sizes: full-width mobile, capped at the calibrated max-w on desktop
const HERO_SIZES = {
  "1/1": "(min-width: 1280px) 48rem, (min-width: 1024px) 75vw, 100vw",
  "5/4": "(min-width: 1280px) 56rem, (min-width: 1024px) 80vw, 100vw",
  "4/5": "(min-width: 1280px) 42rem, (min-width: 1024px) 65vw, 100vw",
} as const;
const heroSizes = HERO_SIZES[coverRatio];
---

<section aria-labelledby="project-page-title" class="relative w-full">
  <div
    class="relative z-10 mx-auto flex w-full max-w-7xl flex-col px-6 pb-8 pt-[calc(var(--header-height)+2rem)] sm:px-8 sm:pb-12 sm:pt-[calc(var(--header-height)+2.5rem)] lg:px-10 lg:pb-16 lg:pt-[calc(var(--header-height)+3rem)]"
  >
    {/* Back link — first focusable element after the header */}
    <a
      href="/architecture"
      class="group mb-6 inline-flex w-fit items-center gap-1.5 text-[0.78rem] uppercase tracking-widest text-(--text-muted) transition-colors duration-200 can-hover:hover:text-(--t2a-blue)"
      data-reveal="fade"
      style="--reveal-delay:0ms;"
    >
      <span
        class="inline-block transition-transform duration-200 can-hover:group-hover:-translate-x-0.5"
        aria-hidden="true">←</span
      >
      <span
        class="underline decoration-(--trait) decoration-1 underline-offset-2 transition-[text-decoration-color] duration-200 can-hover:group-hover:decoration-(--t2a-blue)"
        >Retour aux projets</span
      >
    </a>

    {/* H1 — project name, same scale as index H1 */}
    <h1
      id="project-page-title"
      class="text-[clamp(2.25rem,7vw,4rem)] font-light leading-[1.05] tracking-[0.02em] text-(--t2a-blue-dark) [--reveal-delay:60ms] dark:text-(--t2a-blue)"
      data-reveal="fade-up"
    >
      {name}
    </h1>

    {/* Trait */}
    <span
      aria-hidden="true"
      class="mt-4 block h-px w-24 bg-(--trait) [--reveal-d:480ms] [--reveal-delay:120ms] sm:w-32"
      data-reveal="bar-from-left"></span>

    {/* Location line */}
    <p
      class="mt-4 text-[0.95rem] leading-6 text-(--text-secondary) [--reveal-delay:180ms] sm:text-[1rem]"
      data-reveal="fade-up"
    >
      {locationLine}
    </p>

    {
      /* Meta line (year · status) — rendered only when at least one value exists */
    }
    {
      metaLine && (
        <p
          class="mt-1.5 text-[0.75rem] uppercase tracking-widest text-(--text-muted) [--reveal-delay:240ms]"
          data-reveal="fade-up"
        >
          {metaLine}
        </p>
      )
    }

    {/* Hero cover — plate figure 01 (LCP image) */}
    <figure class:list={["mt-8 w-full sm:mt-12 lg:mt-16", maxWClass]}>
      <CotationFrame
        aspectRatio={cotationRatio}
        revealBorder
        revealCotation
        showCotation
      >
        <ParallaxFrame
          client:visible
          overflowPercent={0.025}
          mobileOverflowPercent={0.04}
        >
          <Image
            src={cover}
            alt={coverAlt}
            class="h-full w-full object-cover"
            draggable="false"
            loading="eager"
            fetchpriority="high"
            quality={85}
            widths={[800, 1200, 1600]}
            sizes={heroSizes}
          />
        </ParallaxFrame>
      </CotationFrame>
      <FigCaption figureId="01" label={coverAlt} />
    </figure>
  </div>
</section>
