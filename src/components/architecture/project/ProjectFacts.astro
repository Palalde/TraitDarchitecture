---
import type { CollectionEntry } from "astro:content";
import {
  ZONE_LABELS,
  TYPE_LABELS,
  MATERIAL_LABELS,
  PROGRAM_LABELS,
  STATUS_LABELS,
} from "@/components/architecture/architecture.data";

interface Props {
  entry: CollectionEntry<"projects">;
  compact?: boolean;
}

const { entry, compact = false }: Props = Astro.props;
const {
  city,
  dept,
  zone,
  year,
  status,
  types,
  materials,
  programs,
  surface,
  mission,
  client,
  budget,
  partners,
} = entry.data;

// Helpers to build "·"-joined label strings
const typeLabel =
  types && types.length > 0
    ? types.map((t) => TYPE_LABELS[t]).join(" · ")
    : null;
const materialLabel =
  materials && materials.length > 0
    ? materials.map((m) => MATERIAL_LABELS[m]).join(" · ")
    : null;
const programLabel =
  programs && programs.length > 0
    ? programs.map((g) => PROGRAM_LABELS[g]).join(" · ")
    : null;

// Ordered rows — filtered before render so the reveal stagger has no holes
const rows = [
  { label: "Lieu", value: `${city} (${dept})` },
  { label: "Zone", value: ZONE_LABELS[zone] },
  { label: "Année", value: year != null ? String(year) : null },
  { label: "Statut", value: status != null ? STATUS_LABELS[status] : null },
  { label: "Type", value: typeLabel },
  { label: "Matériaux", value: materialLabel },
  { label: "Programme", value: programLabel },
  { label: "Surface", value: surface ?? null },
  { label: "Mission", value: mission ?? null },
  { label: "Maîtrise d'ouvrage", value: client ?? null },
  { label: "Budget", value: budget ?? null },
] satisfies Array<{ label: string; value: string | null }>;

const visibleRows = rows.filter(
  (row): row is { label: string; value: string } => row.value !== null,
);

// Partners rendered separately (one row per entry)
const partnerRows = partners ?? [];

// Per-row reveal stagger (ms per row); partners block continues the sequence
const ROW_STAGGER = 40;
const gridClass = compact
  ? "grid grid-cols-2 gap-x-4 sm:gap-x-8"
  : "grid grid-cols-2 gap-x-4 sm:gap-x-8 lg:grid-cols-3 xl:grid-cols-4";
---

{
  /* Frame + heading reveal as one unit (fade), rows then cascade in with
    their own fragmented fade-up reveals. */
}
<aside
  data-reveal="fade"
  class="border border-(--trait) bg-(--bg-primary) p-5 sm:p-6"
  aria-labelledby="project-facts-heading"
>
  <h3
    id="project-facts-heading"
    class="mb-3 text-[0.65rem] font-normal uppercase tracking-[0.14em] text-(--text-muted)"
  >
    Fiche technique
  </h3>
  <span aria-hidden="true" class="mb-4 block h-px w-full bg-(--trait)"></span>

  {
    /* Dense grid of label/value pairs — 2 cols from mobile up, 3-4 cols on
      the full-width desktop band. Rows are ruled with border-b (divide-y
      can't follow a multi-col grid). */
  }
  <dl class={gridClass}>
    {
      visibleRows.map(({ label, value }, index) => (
        <div
          class="flex flex-col gap-0.5 border-b border-(--border) py-2.5"
          data-reveal="fade-up"
          style={`--reveal-delay:${index * ROW_STAGGER}ms;`}
        >
          <dt class="text-[0.65rem] uppercase tracking-widest text-(--text-muted)">
            {label}
          </dt>
          <dd class="text-[0.875rem] leading-5 text-(--text-primary)">
            {value}
          </dd>
        </div>
      ))
    }

    {
      /* Partners — one dt, one dd per entry; continues the row stagger */
      partnerRows.length > 0 && (
        <div
          class="flex flex-col gap-0.5 border-b border-(--border) py-2.5"
          data-reveal="fade-up"
          style={`--reveal-delay:${visibleRows.length * ROW_STAGGER}ms;`}
        >
          <dt class="text-[0.65rem] uppercase tracking-widest text-(--text-muted)">
            Partenaires
          </dt>
          {partnerRows.map((partner) => (
            <dd class="text-[0.875rem] leading-5 text-(--text-primary)">
              {partner}
            </dd>
          ))}
        </div>
      )
    }
  </dl>
</aside>
