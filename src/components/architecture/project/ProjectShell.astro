---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { CollectionEntry } from "astro:content";
import {
  getProjectGallery,
  getProjectSecondary,
} from "@/components/architecture/architecture.data";
import ProjectHero from "@/components/architecture/project/ProjectHero.astro";
import ProjectGallery from "@/components/architecture/project/ProjectGallery.astro";
import {
  ProjectGalleryOverlay,
  type ProjectGallerySlide,
} from "@/components/architecture/project/ProjectGalleryOverlay";
import ProjectNarrative from "@/components/architecture/project/ProjectNarrative.astro";
import ProjectSecondary from "@/components/architecture/project/ProjectSecondary.astro";
import ProjectFacts from "@/components/architecture/project/ProjectFacts.astro";
import ProjectSimilar from "@/components/architecture/project/ProjectSimilar.astro";

interface Props {
  entry: CollectionEntry<"projects">;
  allProjects: CollectionEntry<"projects">[];
}

const { entry, allProjects } = Astro.props;
const slug = entry.id.replace(/\/index$/, "");
const galleryImages = getProjectGallery(slug, entry.data.name);
const secondaryEntry = await getProjectSecondary(slug);
const hasGallery = galleryImages.length > 0;

// Fullscreen overlay variants generated at build time. Never pass the raw
// `ImageMetadata.src` to the island: it would ship the ORIGINAL files
// (20+ MB source photos) straight into dist/ and serve them fullscreen.
const OVERLAY_SIZES = "100vw";

async function buildOverlaySlide(
  source: ImageMetadata,
  meta: Pick<ProjectGallerySlide, "plate" | "caption" | "alt">,
): Promise<ProjectGallerySlide> {
  const optimized = await getImage({
    src: source,
    width: 1920,
    widths: [1280, 1920, 2560],
    sizes: OVERLAY_SIZES,
    format: "webp",
    quality: 80,
  });

  return {
    src: optimized.src,
    srcSet: optimized.srcSet.attribute,
    sizes: OVERLAY_SIZES,
    width: source.width,
    height: source.height,
    ...meta,
  };
}

const gallerySlides: ProjectGallerySlide[] = await Promise.all([
  buildOverlaySlide(entry.data.cover, {
    plate: "01",
    caption: entry.data.coverAlt,
    alt: entry.data.coverAlt,
  }),
  ...galleryImages.map((image) =>
    buildOverlaySlide(image.src, {
      plate: image.plate,
      caption: image.caption,
      alt: image.alt,
    }),
  ),
]);
---

<article
  data-project-shell
  aria-labelledby="project-page-title"
  class="relative w-full"
>
  {
    /* Shared container — lg+ = 2-col grid for the block haut. Left column:
      cartouche (row 1) + narrative (row 2) at a constant text width. Right
      column: cover figure spanning rows 1-2, sticky inside that grid-area
      runway. Below lg everything stacks in DOM order. */
  }
  <div
    class="relative z-10 mx-auto w-full max-w-7xl px-6 pb-36 pt-[calc(var(--header-height)+2rem)] sm:px-8 sm:pb-60 sm:pt-[calc(var(--header-height)+2.5rem)] lg:grid lg:grid-cols-2 lg:gap-x-10 lg:px-10 lg:pb-85 lg:pt-[calc(var(--header-height)+3rem)] 2xl:pb-150"
    data-parallax-anchor
  >
    {
      /* lg:contents → the wrapper's children become grid items while it keeps
        serving as reveal root (DOM scoping is display-independent). */
    }
    <div data-project-head class="lg:contents">
      {
        /* Script inside its reveal root (targets the parent, which exists at
          parse time) so the cartouche + hero reveal on a fresh load too, not
          only via VT. Pathname read at runtime so it works for any slug. */
      }
      <script is:inline data-astro-rerun>
        (() => {
          const revealSystem = window.__t2aReveal;
          if (!revealSystem) return;

          revealSystem
            .createController({
              id: "project-head",
              pathname: window.location.pathname,
              rootSelector: "[data-project-head]",
            })
            ?.startAfterPageVisible(revealSystem.getResponsiveDelay());
        })();
      </script>

      <ProjectHero entry={entry} hasGallery={hasGallery} />
    </div>

    {
      /* data-project-body: description, reserved gallery slot, then facts /
        secondary section. */
    }
    <div data-project-body class="lg:contents">
      {
        /* Script inside its reveal root so it also runs on a fresh (non-VT)
          load. Deferred until after the VT finishes to avoid iOS/WebKit
          rollback of an animation still running at the end of the root
          transition. */
      }
      <script is:inline data-astro-rerun>
        (() => {
          const revealSystem = window.__t2aReveal;
          if (!revealSystem) return;

          revealSystem
            .createController({
              id: "project-body",
              pathname: window.location.pathname,
              rootSelector: "[data-project-body]",
            })
            ?.startAfterPageTransition(revealSystem.getResponsiveDelay());
        })();
      </script>

      <section aria-labelledby="project-body-heading" class="lg:contents">
        <h2 id="project-body-heading" class="sr-only">Description du projet</h2>

        {/* Narrative — left column, row 2, under the cartouche */}
        <div class="mt-8 sm:mt-12 lg:col-start-1 lg:row-start-2 lg:mt-16">
          <ProjectNarrative entry={entry} />
        </div>
      </section>

      <ProjectGallery images={galleryImages} />

      {
        secondaryEntry ? (
          <section
            aria-label="Description secondaire et fiche technique"
            class="mt-12 lg:col-span-2 lg:mt-16 lg:grid lg:grid-cols-2 lg:gap-x-10"
          >
            <div class="lg:sticky lg:top-[calc(var(--header-height)+2rem)] lg:self-start">
              <ProjectSecondary entry={secondaryEntry} />
            </div>

            <div class="mt-8 lg:mt-0 lg:justify-self-center lg:w-full lg:max-w-124">
              <ProjectFacts entry={entry} compact />
            </div>
          </section>
        ) : (
          <section
            aria-labelledby="project-facts-heading"
            class="mt-12 lg:col-span-2 lg:mt-16"
          >
            <ProjectFacts entry={entry} />
          </section>
        )
      }

      <ProjectSimilar entry={entry} allProjects={allProjects} />
    </div>
  </div>

  {
    hasGallery && (
      <ProjectGalleryOverlay
        client:idle
        slides={gallerySlides}
        projectName={entry.data.name}
      />
    )
  }
</article>
