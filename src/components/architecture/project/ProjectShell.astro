---
import type { CollectionEntry } from "astro:content";
import ProjectHero from "@/components/architecture/project/ProjectHero.astro";
import ProjectNarrative from "@/components/architecture/project/ProjectNarrative.astro";
import ProjectFacts from "@/components/architecture/project/ProjectFacts.astro";

interface Props {
  entry: CollectionEntry<"projects">;
  allProjects: CollectionEntry<"projects">[];
}

const { entry } = Astro.props;
---

<article data-project-shell aria-labelledby="project-page-title">
  {
    /*
    Reveal controller for the cartouche + hero (head section).
    Starts once the page is visible (after the VT curtain lifts).
    Pathname is read at runtime so this script works for any slug.
  */
  }
  <script is:inline data-astro-rerun>
    (() => {
      const revealSystem = window.__t2aReveal;
      if (!revealSystem) return;

      revealSystem
        .createController({
          id: "project-head",
          pathname: window.location.pathname,
          rootSelector: "[data-project-head]",
        })
        ?.startAfterPageVisible(revealSystem.getResponsiveDelay());
    })();
  </script>

  {
    /*
    Reveal controller for body + gallery + similar projects.
    Deferred until after the VT finishes to avoid iOS/WebKit rollback
    (§ 3.8 Darchitecture.md).
  */
  }
  <script is:inline data-astro-rerun>
    (() => {
      const revealSystem = window.__t2aReveal;
      if (!revealSystem) return;

      revealSystem
        .createController({
          id: "project-body",
          pathname: window.location.pathname,
          rootSelector: "[data-project-body]",
        })
        ?.startAfterPageTransition(revealSystem.getResponsiveDelay());
    })();
  </script>

  <div data-project-head>
    <ProjectHero entry={entry} />
  </div>

  {
    /* data-project-body: description + fiche technique (steps 4+), gallery (6), similar (7) */
  }
  <div data-project-body>
    {
      /* Body section — description (col 1-7) + fiche technique sticky (col 9-12) on desktop */
    }
    <section
      aria-labelledby="project-body-heading"
      class="mx-auto w-full max-w-7xl px-6 pb-16 sm:px-8 lg:grid lg:grid-cols-12 lg:gap-x-8 lg:px-10 lg:pb-24"
    >
      <h2 id="project-body-heading" class="sr-only">Description du projet</h2>

      {/* Narrative — spans cols 1-7 on desktop */}
      <div class="mb-12 lg:col-span-7 lg:mb-0">
        <ProjectNarrative entry={entry} />
      </div>

      {/* Facts — col 9-12, sticky on desktop */}
      <div
        class="lg:col-span-4 lg:col-start-9 lg:self-start lg:sticky lg:top-[calc(var(--header-height)+2rem)]"
      >
        <ProjectFacts entry={entry} />
      </div>
    </section>
  </div>
</article>
