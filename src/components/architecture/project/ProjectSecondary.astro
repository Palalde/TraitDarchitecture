---
import { render, type CollectionEntry } from "astro:content";

interface Props {
  entry?: CollectionEntry<"projectSecondaries">;
}

const { entry }: Props = Astro.props;
const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content;
---

{
  Content && (
    <div
      data-secondary
      class="secondary-body max-w-(--reading-measure) text-body-sm text-(--text-reading)"
    >
      <Content />
    </div>
  )
}

<script is:inline data-astro-rerun>
  (() => {
    const body = document.querySelector("[data-secondary]");
    if (!body) return;

    Array.from(body.children).forEach((el, index) => {
      el.setAttribute("data-reveal", "fade-up");
      el.style.setProperty("--reveal-delay", `${index * 40}ms`);
    });
  })();
</script>

<style>
  .secondary-body :global(p) {
    margin-bottom: 1.25rem;
  }

  .secondary-body :global(strong) {
    font-weight: 600;
    color: inherit;
  }

  .secondary-body :global(:is(h2, h3)) {
    max-width: var(--reading-measure);
    color: var(--t2a-blue-dark);
    font-family: var(--font-sans);
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .secondary-body :global(h2) {
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
    font-size: var(--label-size);
  }

  .secondary-body :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    font-size: var(--label-sm-size);
  }

  .secondary-body :global(:is(ul, ol)) {
    padding-left: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .secondary-body :global(li) {
    margin-bottom: 0.375rem;
  }

  /* Markdown citations use the same T2A signature style as editorial quotes. */
  .secondary-body :global(blockquote) {
    margin: 2rem 0;
    padding: 0.25rem 0 0.25rem 1.25rem;
    border-left: 1px solid var(--border);
    color: var(--text-quote);
    font-family: var(--font-sans);
    font-size: var(--reading-quote-size);
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: 0.01em;
  }

  .secondary-body :global(blockquote p) {
    margin-bottom: 1rem;
    color: inherit;
    font-size: inherit;
  }

  .secondary-body :global(blockquote :is(p, ul, ol):last-child) {
    margin-bottom: 0;
  }

  .secondary-body :global(blockquote :is(ul, ol)) {
    margin-bottom: 1rem;
  }
</style>
