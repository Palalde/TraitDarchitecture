---
import ArchitectureHero from "@/components/architecture/blocks/ArchitectureHero.astro";
import ArchitectureGrid from "@/components/architecture/blocks/ArchitectureGrid.astro";
import { ArchitectureFilters } from "@/components/architecture/blocks/ArchitectureFilters";
import {
  getSortedProjects,
  TYPE_LABELS,
  MATERIAL_LABELS,
  PROGRAM_LABELS,
} from "@/components/architecture/architecture.data";

const projects = await getSortedProjects();

const projectMeta = projects.map((project) => ({
  zone: project.data.zone,
  types: project.data.types ?? [],
  materials: project.data.materials ?? [],
  programs: project.data.programs ?? [],
}));

const usedTypes = new Set(projectMeta.flatMap((project) => project.types));
const usedMaterials = new Set(
  projectMeta.flatMap((project) => project.materials),
);
const usedPrograms = new Set(
  projectMeta.flatMap((project) => project.programs),
);

const buildOptions = <T extends string>(
  labels: Record<T, string>,
  used: Set<string>,
) =>
  (Object.keys(labels) as T[]).map((value) => ({
    value,
    label: labels[value],
    available: used.has(value),
  }));

const typeOptions = buildOptions(TYPE_LABELS, usedTypes);
const materialOptions = buildOptions(MATERIAL_LABELS, usedMaterials);
const programOptions = buildOptions(PROGRAM_LABELS, usedPrograms);
---

<section
  data-architecture-shell
  class="relative z-10"
  style="--reveal-d: 450ms;"
>
  <div data-architecture-head>
    {
      /* Script inside its reveal root (targets the parent, which exists at parse
        time) so the hero + filters reveal on a fresh load too, not only via VT. */
    }
    <script is:inline data-astro-rerun>
      (() => {
        const revealSystem = window.__t2aReveal;
        if (!revealSystem) return;

        // Hero + filters reveal as the page-transition curtain lifts.
        revealSystem
          .createController({
            id: "architecture-head",
            pathname: "/architecture",
            rootSelector: "[data-architecture-head]",
          })
          ?.startAfterPageVisible(revealSystem.getResponsiveDelay());
      })();
    </script>

    <ArchitectureHero />
    <div class="relative z-20 mt-8 sm:mt-9 lg:mt-10" style="--reveal-d: 400ms;">
      <ArchitectureFilters
        projects={projectMeta}
        typeOptions={typeOptions}
        materialOptions={materialOptions}
        programOptions={programOptions}
        client:visible
      />
    </div>
  </div>
  <div data-architecture-grid class="relative z-10 mt-4 sm:mt-5 lg:mt-6">
    {
      /* Defer the grid reveals until the view transition has fully finished.
        On iOS/WebKit a reveal still animating when the root transition ends
        (~800ms) visibly rolls back, so the cards stay hidden behind the
        curtain and only animate once the page has settled. Script inside the
        root so it also runs on a fresh (non-VT) load. */
    }
    <script is:inline data-astro-rerun>
      (() => {
        const revealSystem = window.__t2aReveal;
        if (!revealSystem) return;

        revealSystem
          .createController({
            id: "architecture-grid",
            pathname: "/architecture",
            rootSelector: "[data-architecture-grid]",
          })
          ?.startAfterPageTransition(revealSystem.getResponsiveDelay());
      })();
    </script>

    <ArchitectureGrid projects={projects} />
  </div>
</section>
