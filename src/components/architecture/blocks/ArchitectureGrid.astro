---
import type { CollectionEntry } from "astro:content";
import MasonrySetup from "@/components/ui/masonry/MasonrySetup.astro";
import ProjectCard from "@/components/architecture/blocks/ProjectCard.astro";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;

// Real rendered cover width (container padding, grid gap, card padding and
// borders), × 1.08 for the parallax overflow (object-cover on a taller frame)
// and the desktop hover scale.
const INDEX_SIZES =
  "(min-width: 1280px) 15.75rem, (min-width: 1024px) calc((25vw - 5.5rem) * 1.08), (min-width: 640px) calc((50vw - 5.5rem) * 1.08), calc((100vw - 5.25rem) * 1.08)";
---

<div
  class="mx-auto w-full max-w-7xl px-6 pb-40 sm:px-8 sm:pb-70 lg:px-10 lg:pb-90 2xl:pb-150"
>
  <ul
    data-masonry
    class="grid grid-cols-1 items-start gap-6 [--masonry-cols:1] [--masonry-gap:24px] sm:grid-cols-2 sm:[--masonry-cols:2] lg:grid-cols-4 lg:gap-8 lg:[--masonry-cols:4] lg:[--masonry-gap:32px]"
  >
    {
      projects.map((project, index) => {
        const slug = project.id.replace(/\/index$/, "");
        const { name, city, dept, cover, coverAlt, coverRatio } = project.data;
        return (
          <li
            data-masonry-item
            data-project-card
            data-reveal="fade-up"
            style={`--reveal-delay:${Math.min(index, 7) * 60}ms;`}
          >
            <ProjectCard
              coverRatio={coverRatio}
              image={cover}
              imageAlt={coverAlt}
              label={name}
              subtitle={`${city} (${dept})`}
              href={`/architecture/${slug}/`}
              sizes={INDEX_SIZES}
              showTouchArrow={false}
              priority={index === 0}
              parallax
              alwaysClickable
            />
          </li>
        );
      })
    }
  </ul>
  <MasonrySetup />
</div>
