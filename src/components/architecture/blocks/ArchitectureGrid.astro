---
import type { CollectionEntry } from "astro:content";
import ProjectCard from "@/components/architecture/blocks/ProjectCard.astro";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;

const INDEX_SIZES = "(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw";
---

<div
  class="mx-auto w-full max-w-7xl px-6 pb-40 sm:px-8 sm:pb-70 lg:px-10 lg:pb-90 2xl:pb-150"
>
  <ul
    data-architecture-masonry
    class="grid grid-cols-1 items-start gap-6 [--masonry-cols:1] [--masonry-gap:24px] sm:grid-cols-2 sm:[--masonry-cols:2] lg:grid-cols-4 lg:gap-8 lg:[--masonry-cols:4] lg:[--masonry-gap:32px]"
  >
    {
      projects.map((project, index) => {
        const slug = project.id.replace(/\/index$/, "");
        const { name, city, dept, cover, coverAlt, coverRatio } = project.data;
        return (
          <li
            data-project-card
            data-reveal="fade-up"
            style={`--reveal-delay:${Math.min(index, 7) * 60}ms;`}
          >
            <ProjectCard
              coverRatio={coverRatio}
              image={cover}
              imageAlt={coverAlt}
              label={name}
              subtitle={`${city} (${dept})`}
              href={`/architecture/${slug}`}
              sizes={INDEX_SIZES}
              showTouchArrow={false}
              priority={index < 4}
              parallax
              alwaysClickable
            />
          </li>
        );
      })
    }
  </ul>

  {
    /* JS masonry: assigns each visible card to a fixed column by reading order
      (card N → column N mod cols, so the first row fills left→right, then it
      wraps), and stacks cards tightly within each column so varied cover ratios
      leave no row gap. The CSS Grid above is the no-JS fallback (same column
      assignment, but it aligns rows → gaps). Re-runs after each view
      transition; relays out on resize, on filter (.hidden toggle) and once
      webfonts settle. Positions via top/left so the reveal animation keeps full
      use of transform. */
  }
  <script is:inline data-astro-rerun>
    (() => {
      const grid = document.querySelector("[data-architecture-masonry]");
      if (!grid || grid.getAttribute("data-masonry-on") === "1") return;
      grid.setAttribute("data-masonry-on", "1");

      const readVar = (name, fallback) => {
        const value = parseFloat(getComputedStyle(grid).getPropertyValue(name));
        return Number.isFinite(value) ? value : fallback;
      };

      const clearCard = (card) => {
        card.style.position = "";
        card.style.width = "";
        card.style.left = "";
        card.style.top = "";
      };

      const layout = () => {
        const cols = readVar("--masonry-cols", 1);
        const cards = [...grid.querySelectorAll("[data-project-card]")].filter(
          (card) => getComputedStyle(card).display !== "none",
        );

        // Single column (mobile): plain document flow, no masonry needed.
        if (cols < 2 || cards.length === 0) {
          grid.style.position = "";
          grid.style.display = "";
          grid.style.height = "";
          cards.forEach(clearCard);
          return;
        }

        const gap = readVar("--masonry-gap", 24);
        const width = grid.clientWidth;
        if (width <= 0) return;

        const colWidth = (width - gap * (cols - 1)) / cols;

        // Phase 1 — pull cards out of flow at the resolved column width.
        grid.style.position = "relative";
        grid.style.display = "block";
        cards.forEach((card) => {
          card.style.position = "absolute";
          card.style.width = colWidth + "px";
        });

        // Phase 2 — measure every card once to avoid layout thrashing.
        const heights = cards.map((card) => card.offsetHeight);

        // Phase 3 — assign each card to its reading-order column (index mod
        // cols) and stack it below the previous card in that column.
        const colHeights = new Array(cols).fill(0);
        cards.forEach((card, index) => {
          const col = index % cols;
          card.style.left = col * (colWidth + gap) + "px";
          card.style.top = colHeights[col] + "px";
          colHeights[col] += heights[index] + gap;
        });

        grid.style.height = Math.max(...colHeights) - gap + "px";
      };

      let frame = 0;
      const schedule = () => {
        if (frame) return;
        frame = requestAnimationFrame(() => {
          frame = 0;
          layout();
        });
      };

      layout();

      new ResizeObserver(schedule).observe(grid);
      new MutationObserver(schedule).observe(grid, {
        attributes: true,
        attributeFilter: ["class"],
        subtree: true,
      });

      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(schedule);
      }
    })();
  </script>
</div>
