---
import type { CollectionEntry } from "astro:content";
import ProjectCard from "@/components/architecture/blocks/ProjectCard.astro";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;

const INDEX_SIZES = "(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw";
---

<ul
  class="mx-auto w-full max-w-7xl columns-1 gap-6 px-6 pb-40 sm:columns-2 sm:px-8 sm:pb-70 lg:columns-4 lg:gap-8 lg:px-10 lg:pb-90 2xl:pb-150"
>
  {
    projects.map((project, index) => {
      const slug = project.id.replace(/\/index$/, "");
      const { name, city, dept, cover, coverAlt, coverRatio } = project.data;
      return (
        <li
          class="mb-6 break-inside-avoid lg:mb-8"
          data-project-card
          data-reveal="fade-up"
          style={`--reveal-delay:${Math.min(index, 7) * 60}ms;`}
        >
          <ProjectCard
            coverRatio={coverRatio}
            image={cover}
            imageAlt={coverAlt}
            label={name}
            subtitle={`${city} (${dept})`}
            href={`/architecture/${slug}`}
            sizes={INDEX_SIZES}
            showTouchArrow={false}
            priority={index < 4}
            alwaysClickable
          />
        </li>
      );
    })
  }
</ul>
