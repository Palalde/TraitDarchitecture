---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import T2AMotifPattern from "@/components/ui/background/T2AMotifPattern.astro";
import { ParallaxFrame } from "@/components/ui/media/ParallaxFrame";

interface Props {
  className?: string;
  label?: string;
  subtitle?: string;
  lineWidths?: readonly string[];
  image?: ImageMetadata;
  imageAlt?: string;
  imageClassName?: string;
  coverRatio?: "1/1" | "5/4" | "4/5";
  parallax?: boolean;
  parallaxOverflow?: number;
  mobileParallaxOverflow?: number;
  sizes?: string;
  /** Affiche la flèche CTA sur les appareils tactiles (home). Index : false. */
  showTouchArrow?: boolean;
  /** Si true, toute la carte est cliquable sur tous les appareils (index). */
  alwaysClickable?: boolean;
  /** Lien vers la page projet. Temporairement "#" tant que les pages n'existent pas. */
  href?: string;
  cardReveal?: string;
  cardRevealDelay?: string;
  mobileCardReveal?: string;
}

const {
  className,
  label,
  subtitle,
  lineWidths = ["w-8/12", "w-10/12"],
  image,
  imageAlt = "",
  imageClassName = "object-cover object-center",
  coverRatio = "4/5",
  parallax = false,
  parallaxOverflow = 0.025,
  mobileParallaxOverflow = 0.04,
  sizes = "(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw",
  showTouchArrow = true,
  alwaysClickable = false,
  href = "#",
  cardReveal,
  cardRevealDelay,
  mobileCardReveal,
}: Props = Astro.props;

const hasLabel = Boolean(label);
const linkLabel =
  [label, subtitle].filter(Boolean).join(" — ") || "Voir le projet";

const ASPECT_CLASS = {
  "1/1": "aspect-square",
  "5/4": "aspect-5/4",
  "4/5": "aspect-4/5",
} as const;
const aspectClass = ASPECT_CLASS[coverRatio];
---

<article
  class:list={[
    "group relative z-10 overflow-hidden border border-(--border) bg-(--bg-primary) p-4 sm:p-5 can-hover:cursor-pointer",
    className,
    cardRevealDelay,
  ]}
  data-reveal={cardReveal}
  data-reveal-mobile={mobileCardReveal}
>
  <a
    href={href}
    class:list={[
      "absolute inset-0 z-30",
      alwaysClickable ? "block" : "hidden can-hover:block",
    ]}
    aria-label={linkLabel}
  >
  </a>
  <T2AMotifPattern />
  <div
    class:list={[
      "relative z-10 w-full overflow-hidden border border-(--trait) bg-(--t2a-blue-wash) motion-safe:can-hover:transition-transform motion-safe:can-hover:duration-300 motion-safe:can-hover:ease-out motion-safe:can-hover:group-hover:scale-[1.03]",
      aspectClass,
    ]}
  >
    {
      image && parallax ? (
        <ParallaxFrame
          client:visible
          overflowPercent={parallaxOverflow}
          mobileOverflowPercent={mobileParallaxOverflow}
        >
          <Image
            alt={imageAlt}
            class:list={["h-full w-full", imageClassName]}
            draggable="false"
            loading="lazy"
            quality={85}
            widths={[400, 600, 800]}
            sizes={sizes}
            src={image}
          />
        </ParallaxFrame>
      ) : image ? (
        <Image
          alt={imageAlt}
          class:list={["h-full w-full", imageClassName]}
          draggable="false"
          loading="lazy"
          quality={85}
          widths={[400, 600, 800]}
          sizes={sizes}
          src={image}
        />
      ) : null
    }
  </div>
  {
    hasLabel ? (
      <a
        href={href}
        class:list={[
          "relative z-30 mt-5 block",
          alwaysClickable
            ? "pointer-events-none"
            : "can-hover:pointer-events-none",
        ]}
        aria-label={linkLabel}
        data-reveal={cardReveal ? "fade" : undefined}
      >
        <p class="text-[0.95rem] font-semibold uppercase tracking-widest text-(--t2a-blue-dark) can-hover:transition-colors can-hover:duration-300 can-hover:group-hover:text-(--t2a-blue) dark:text-(--t2a-blue) dark:can-hover:group-hover:text-(--t2a-blue-light)">
          <span class="relative inline-block">
            {label}
            <span
              aria-hidden="true"
              class="absolute bottom-0 left-0 hidden h-px w-0 bg-(--trait) can-hover:block can-hover:transition-all can-hover:duration-300 can-hover:group-hover:w-full"
            />
          </span>
        </p>
        {subtitle && (
          <p class="mt-1 flex items-baseline justify-between text-[0.82rem] tracking-[0.04em] text-(--text-secondary)">
            <span>{subtitle}</span>
            {showTouchArrow && (
              <span
                aria-hidden="true"
                class="text-[24px] leading-none text-(--t2a-blue) can-hover:hidden"
              >
                →
              </span>
            )}
          </p>
        )}
      </a>
    ) : (
      <div class="relative z-10 mt-5 space-y-3" aria-hidden="true">
        {lineWidths.map((width) => (
          <div
            class:list={[
              "h-3 border border-(--border) bg-(--bg-secondary)",
              width,
            ]}
          />
        ))}
      </div>
    )
  }
</article>
