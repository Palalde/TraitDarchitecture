---
interface Props {
  aspectRatio?: "7:5" | "8:5" | "5:4" | "4:5";
  className?: string;
  contentClassName?: string;
  contentStyle?: string;
  orientation?: "horizontal" | "vertical";
  showBorder?: boolean;
  showCotation?: boolean;
}

const {
  aspectRatio,
  className,
  contentClassName,
  contentStyle,
  orientation = "vertical",
  showBorder = orientation === "vertical",
  showCotation = true,
}: Props = Astro.props;

const aspectRatioClass =
  aspectRatio === "7:5"
    ? "aspect-[7/5]"
    : aspectRatio === "8:5"
      ? "aspect-[8/5]"
      : aspectRatio === "5:4"
        ? "aspect-5/4"
        : aspectRatio === "4:5"
          ? "aspect-4/5"
          : undefined;
---

<div class:list={["relative w-full overflow-visible", className]}>
  {
    showCotation &&
      (orientation === "vertical" ? (
        <>
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-1 -bottom-1 -left-1 w-px bg-(--trait)"
          />
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-1 -bottom-1 -right-1 w-px bg-(--trait)"
          />

          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-1 -left-1 h-px w-2 bg-(--trait)"
          />
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-1 -left-1 h-2 w-px bg-(--trait)"
          />

          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-1 -right-1 h-px w-2 bg-(--trait)"
          />
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-1 -right-1 h-2 w-px bg-(--trait)"
          />

          <span
            aria-hidden="true"
            class="pointer-events-none absolute -bottom-1 -left-1 h-px w-2 bg-(--trait)"
          />
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -bottom-1 -left-1 h-2 w-px bg-(--trait)"
          />

          <span
            aria-hidden="true"
            class="pointer-events-none absolute -right-1 -bottom-1 h-px w-2 bg-(--trait)"
          />
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -right-1 -bottom-1 h-2 w-px bg-(--trait)"
          />
        </>
      ) : (
        <>
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-1 -left-1 -right-1 h-px bg-(--trait)"
          />
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -bottom-1 -left-1 -right-1 h-px bg-(--trait)"
          />

          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-1 -left-1 h-2 w-px bg-(--trait)"
          />
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-1 -right-1 h-2 w-px bg-(--trait)"
          />

          <span
            aria-hidden="true"
            class="pointer-events-none absolute -bottom-1 -left-1 h-2 w-px bg-(--trait)"
          />
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -bottom-1 -right-1 h-2 w-px bg-(--trait)"
          />
        </>
      ))
  }

  <div
    class:list={[
      aspectRatioClass,
      contentClassName,
      "relative w-full overflow-hidden bg-(--t2a-blue-wash)",
      showBorder && "border border-(--trait)",
    ]}
    style={contentStyle}
  >
    <slot />
  </div>
</div>
