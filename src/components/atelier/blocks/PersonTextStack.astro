---
import type { AtelierPersonSection } from "@/components/atelier/atelier.data";

interface Props {
  className: string;
  section: AtelierPersonSection;
}

const { className, section }: Props = Astro.props;
const richBodyClass =
  "mt-3 text-body-sm text-(--text-reading) [&_strong]:font-semibold";
// auto-rows-fr: every card takes the height of the tallest one, so the sticky
// cards cover each other exactly (and the narrow-tall portrait release can be
// derived from that single height, see AtelierShell).
const stepListClass =
  "grid grid-cols-1 auto-rows-fr gap-15 sm:gap-16 lg:gap-24";
// narrow-tall: cards stick 1rem under the sticky portrait (--atelier-portrait-h
// is set by the Fig. II / III section).
const stepArticleClass =
  "sticky top-(--header-height) relative min-h-72 bg-(--bg-primary) py-8 pr-5 pl-5 [--reveal-d:720ms] [--reveal-offset-y:24px] narrow-tall-mobile:top-[calc(var(--header-height)+var(--atelier-portrait-h)+1rem)] narrow-tall-mobile:min-h-0 narrow-tall-mobile:py-6 sm:py-10 sm:pr-6 sm:pl-6 lg:top-[calc(50vh-10rem)] lg:min-h-80 lg:py-12 lg:pr-8 lg:pl-8";
const stepIndexClass =
  "shrink-0 text-[0.75rem] font-semibold uppercase tracking-[0.18em] text-(--text-muted)";
---

<div class={className}>
  <div class={stepListClass}>
    {
      section.sections.map((contentSection, index) => (
        <article
          class={stepArticleClass}
          data-atelier-card
          data-reveal="fade-up"
          style={`z-index: ${index + 1};`}
        >
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0"
            data-reveal="cotation"
          >
            <span
              class="absolute top-0 left-0 h-px w-2 bg-(--trait)"
              data-cotation-corner="x-left"
            />
            <span
              class="absolute inset-y-0 left-0 w-px bg-(--trait)"
              data-cotation-connector="y"
            />
            <span
              class="absolute right-0 bottom-0 h-px w-2 bg-(--trait)"
              data-cotation-corner="x-right"
            />
            <span
              class="absolute inset-y-0 right-0 w-px bg-(--trait)"
              data-cotation-connector="y"
            />
          </div>
          <div class="flex items-baseline gap-3 sm:gap-4">
            <span class={stepIndexClass}>
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3 class="text-label text-(--t2a-blue-dark)">
              {contentSection.title}
            </h3>
          </div>
          <p class={richBodyClass} set:html={contentSection.body} />
        </article>
      ))
    }
  </div>
</div>
