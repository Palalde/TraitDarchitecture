---
interface Props {
  className?: string;
  figureId: string;
  label: string;
  overlay?: boolean;
}

const { className, figureId, label, overlay = false }: Props = Astro.props;

const captionClass = overlay
  ? "pointer-events-none absolute bottom-0 left-0 z-10 flex items-end px-3 py-3 text-[0.6rem] uppercase tracking-[0.12em] sm:px-4 sm:py-4 sm:text-[0.68rem]"
  : "mt-4 flex items-center justify-between gap-4 text-[0.6rem] uppercase tracking-[0.12em] text-(--text-muted) sm:text-[0.68rem]";

const figureIdClass = overlay ? "shrink-0 text-white" : "shrink-0";
const labelClass = overlay ? "sr-only" : "max-w-[70%] text-right leading-tight";
---

<figcaption class:list={[captionClass, className]}>
  <span class={figureIdClass}>{figureId}</span>
  <span class={labelClass}>{label}</span>
</figcaption>
