---
import { Image } from "astro:assets";
import { ParallaxFrame } from "@/components/ui/media/ParallaxFrame";
import CotationFrame from "@/components/ui/cotation/CotationFrame.astro";
import FigCaption from "@/components/ui/cotation/FigCaption.astro";
import type { AtelierPersonSection } from "@/components/atelier/atelier.data";

interface Props {
  className: string;
  section: AtelierPersonSection;
}

const { className, section }: Props = Astro.props;
const stickyFigureStyle =
  "--atelier-sticky-top: calc(50vh - 15rem); --atelier-sticky-max-width: min(100%, 24rem);";
---

<figure class={className} data-reveal="fade-up" style={stickyFigureStyle}>
  <CotationFrame aspectRatio={section.image.aspectRatio}>
    <ParallaxFrame
      client:visible
      overflowPercent={0.025}
      mobileOverflowPercent={0.04}
      progressAnchorSelector="[data-parallax-anchor]"
    >
      <Image
        alt={section.image.alt}
        class="h-full w-full object-cover object-center"
        draggable="false"
        format="webp"
        loading="lazy"
        quality={68}
        sizes="(min-width: 1024px) 24rem, (min-width: 640px) calc(100vw - 5rem), calc(100vw - 3rem)"
        src={section.image.src}
        widths={[320, 480, 640, 768]}
      />
    </ParallaxFrame>
  </CotationFrame>
  <FigCaption
    overlay
    figureId={section.figureId}
    label={section.name}
    style="bottom: var(--portrait-release-offset, 0px);"
  />
</figure>
