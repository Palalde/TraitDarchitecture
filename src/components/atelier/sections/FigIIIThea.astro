---
import FigBanner from "@/components/atelier/blocks/FigBanner.astro";
import PersonPortraitFigure from "@/components/atelier/blocks/PersonPortraitFigure.astro";
import PersonTextStack from "@/components/atelier/blocks/PersonTextStack.astro";
import type { AtelierPersonSection } from "@/components/atelier/atelier.data";

interface Props {
  section: AtelierPersonSection;
}

const { section }: Props = Astro.props;
const portraitFigureClass =
  "order-1 relative w-full narrow-tall-mobile:m-1 narrow-tall-mobile:sticky narrow-tall-mobile:top-(--header-height) narrow-tall-mobile:z-0 narrow-tall-mobile:mx-auto narrow-tall-mobile:max-w-64 narrow-tall-mobile:self-start narrow-tall-mobile:justify-self-center narrow-tall-mobile:row-start-1 narrow-tall-mobile:col-start-1 narrow-tall-mobile:pb-[21rem] narrow-tall-mobile-md:pb-[23.5rem] narrow-tall-mobile-sm:pb-[26.5rem] lg:col-start-3 lg:order-0 lg:sticky lg:top-(--atelier-sticky-top) lg:max-w-(--atelier-sticky-max-width) lg:self-start lg:justify-self-center";
const textStackClass =
  "order-2 flex flex-col gap-6 sm:gap-7 narrow-tall-mobile:row-start-1 narrow-tall-mobile:col-start-1 narrow-tall-mobile:pt-[21rem] narrow-tall-mobile-md:pt-[23.5rem] narrow-tall-mobile-sm:pt-[26.5rem] lg:col-start-1 lg:order-0 lg:pr-2";
---

<section
  class="flex flex-col gap-6 sm:gap-8"
  aria-labelledby="atelier-figure-iii-title"
>
  <FigBanner
    figureId={section.figureId}
    headingId="atelier-figure-iii-title"
    label={section.figureLabel}
  />

  <div
    class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1fr)_1px_minmax(0,1fr)] lg:items-start lg:gap-x-10 lg:gap-y-8"
    data-parallax-anchor
  >
    <PersonTextStack className={textStackClass} section={section} />

    <div
      aria-hidden="true"
      class="hidden w-px bg-(--trait) [--reveal-d:680ms] lg:col-start-2 lg:block lg:self-stretch"
      data-reveal="bar-from-top"
    >
    </div>

    <PersonPortraitFigure className={portraitFigureClass} section={section} />
  </div>
</section>
