---
import { Image } from "astro:assets";
import { ParallaxFrame } from "@/components/ui/media/ParallaxFrame";
import CotationFrame from "@/components/ui/cotation/CotationFrame.astro";
import FigCaption from "@/components/ui/cotation/FigCaption.astro";
import type { AtelierPageData } from "@/components/atelier/atelier.data";

interface Props {
  heading: string;
  section: AtelierPageData["duoFigure"];
}

const { heading, section }: Props = Astro.props;
const duoFrameStyle =
  "background-color: color-mix(in srgb, var(--bg-primary) 5%, transparent); backdrop-filter: blur(2px); -webkit-backdrop-filter: blur(2px);";
const duoFigureStyle = "--atelier-duo-max-width: min(100%, 45rem);";
const richParagraphClass =
  "mx-auto max-w-3xl text-[1rem] leading-7 text-(--text-primary) sm:text-[1.05rem] sm:leading-8 [&_strong]:font-semibold";
const richPivotClass =
  "mx-auto mt-4 max-w-4xl text-[1rem] leading-7 text-(--t2a-blue-dark) italic sm:text-[1.05rem] sm:leading-8 dark:text-(--t2a-blue) [&_strong]:font-semibold";
---

<section
  class="flex flex-col gap-6 sm:gap-8 lg:gap-10"
  aria-labelledby="atelier-page-title"
>
  <!-- title -->
  <div
    class="grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-3 sm:gap-5"
  >
    <div class="flex min-w-0 items-center gap-2">
      <span
        class="shrink-0 text-[0.68rem] uppercase tracking-[0.16em] text-(--text-muted) sm:text-[0.72rem]"
        data-reveal="fade"
      >
        {section.figureId}
      </span>
      <div
        aria-hidden="true"
        class="h-px flex-1 bg-(--trait) [--reveal-d:620ms]"
        data-reveal="bar-from-right"
      >
      </div>
    </div>
    <h1
      id="atelier-page-title"
      class="shrink-0 text-center text-[1.7rem] font-semibold tracking-[0.16em] text-(--t2a-blue-dark) dark:text-(--t2a-blue) sm:text-[2.15rem] lg:text-[3rem]"
      data-reveal="fade-up"
    >
      {heading}
    </h1>
    <div class="flex min-w-0 items-center gap-2">
      <div
        aria-hidden="true"
        class="h-px flex-1 bg-(--trait) [--reveal-d:620ms]"
        data-reveal="bar-from-left"
      >
      </div>
      <span
        aria-hidden="true"
        class="invisible shrink-0 text-[0.68rem] uppercase tracking-[0.16em] sm:text-[0.72rem]"
      >
        {section.figureId}
      </span>
    </div>
  </div>

  <!-- paragraph -->
  <CotationFrame
    className="mx-auto w-full max-w-4xl"
    contentClassName="bg-transparent px-5 py-5 text-center sm:px-6 sm:py-6"
    contentStyle={duoFrameStyle}
    orientation="horizontal"
    showBorder={false}
  >
    <p
      class={richParagraphClass}
      data-reveal="fade-up"
      set:html={section.intro}
    />
  </CotationFrame>

  <!-- image -->
  <figure
    class="relative mx-auto w-full max-w-232 lg:max-w-(--atelier-duo-max-width)"
    data-reveal="fade-up"
    style={duoFigureStyle}
  >
    <CotationFrame aspectRatio={section.image.aspectRatio}>
      <ParallaxFrame
        client:visible
        overflowPercent={0.025}
        mobileOverflowPercent={0.04}
      >
        <Image
          alt={section.image.alt}
          class="h-full w-full object-cover object-center"
          draggable="false"
          fetchpriority="high"
          format="webp"
          loading="eager"
          quality={72}
          sizes="(min-width: 1024px) 45rem, (min-width: 640px) calc(100vw - 5rem), calc(100vw - 3rem)"
          src={section.image.src}
          widths={[360, 480, 640, 720, 900]}
        />
      </ParallaxFrame>
    </CotationFrame>
    <FigCaption
      overlay
      figureId={section.figureId}
      label={section.image.label}
    />
  </figure>

  <!-- pivot text -->
  <CotationFrame
    className="mx-auto w-full max-w-4xl"
    contentClassName="bg-transparent px-5 py-5 text-center sm:px-6 sm:py-6"
    contentStyle={duoFrameStyle}
    orientation="horizontal"
    showBorder={false}
  >
    <p
      class="text-[0.72rem] font-semibold uppercase tracking-[0.16em] text-(--t2a-blue-dark) dark:text-(--t2a-blue)"
      data-reveal="fade"
    >
      {section.pivotTitle}
    </p>
    <p class={richPivotClass} data-reveal="fade-up" set:html={section.pivot} />
  </CotationFrame>
</section>
