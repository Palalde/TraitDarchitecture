---
import FigBanner from "@/components/atelier/blocks/FigBanner.astro";
import PersonPortraitFigure from "@/components/atelier/blocks/PersonPortraitFigure.astro";
import PersonTextStack from "@/components/atelier/blocks/PersonTextStack.astro";
import type { AtelierPersonSection } from "@/components/atelier/atelier.data";

interface Props {
  section: AtelierPersonSection;
}

const { section }: Props = Astro.props;
// narrow-tall (see AtelierShell): the portrait releases one card height
// (+0.75rem = 1rem gap − 0.25rem margin) before the end of the stack, so it
// leaves together with the last card instead of being covered by it.
const portraitFigureClass =
  "relative w-full narrow-tall-mobile:m-1 narrow-tall-mobile:[--portrait-release-offset:calc(var(--atelier-card-h,25rem)_+_0.75rem)] narrow-tall-mobile:sticky narrow-tall-mobile:top-(--header-height) narrow-tall-mobile:z-0 narrow-tall-mobile:mx-auto narrow-tall-mobile:max-w-64 narrow-tall-mobile:self-start narrow-tall-mobile:justify-self-center narrow-tall-mobile:row-start-1 narrow-tall-mobile:col-start-1 narrow-tall-mobile:pb-(--portrait-release-offset) lg:sticky lg:top-(--atelier-sticky-top) lg:max-w-(--atelier-sticky-max-width) lg:self-start lg:justify-self-center";
const textStackClass =
  "flex flex-col gap-6 sm:gap-7 narrow-tall-mobile:row-start-1 narrow-tall-mobile:col-start-1 narrow-tall-mobile:pt-[calc(var(--atelier-portrait-h)+1.25rem)] lg:col-start-3 lg:pl-2";
---

<section
  class="flex flex-col gap-6 sm:gap-8"
  aria-labelledby="atelier-figure-ii-title"
>
  <FigBanner
    figureId={section.figureId}
    headingId="atelier-figure-ii-title"
    label={section.figureLabel}
  />

  <div
    class="grid grid-cols-1 gap-8 [--atelier-portrait-h:calc(min(16rem,100vw-3rem)*1.25)] lg:grid-cols-[minmax(0,1fr)_1px_minmax(0,1fr)] lg:items-start lg:gap-x-10 lg:gap-y-8"
    data-atelier-person
    data-parallax-anchor
  >
    <PersonPortraitFigure className={portraitFigureClass} section={section} />

    <div
      aria-hidden="true"
      class="hidden w-px bg-(--trait) [--reveal-d:680ms] lg:block lg:self-stretch"
      data-reveal="bar-from-top"
    >
    </div>

    <PersonTextStack className={textStackClass} section={section} />
  </div>
</section>
