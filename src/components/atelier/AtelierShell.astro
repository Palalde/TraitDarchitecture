---
import { atelierPageData } from "@/components/atelier/atelier.data";
import FigIDuo from "@/components/atelier/sections/FigIDuo.astro";
import FigIITitouan from "@/components/atelier/sections/FigIITitouan.astro";
import FigIIIThea from "@/components/atelier/sections/FigIIIThea.astro";

const [titouanSection, theaSection] = atelierPageData.people;
---

<section aria-labelledby="atelier-page-title" class="relative w-full">
  <div
    class="relative z-10 mx-auto flex w-full max-w-7xl flex-col gap-20 px-6 pt-24 pb-24 sm:gap-24 sm:px-8 sm:pt-28 sm:pb-28 lg:gap-28 lg:px-10 lg:pt-32 lg:pb-32"
  >
    <header class="max-w-3xl border-y border-(--trait) py-6 sm:py-7">
      <p class="text-[0.72rem] uppercase tracking-[0.16em] text-(--text-muted)">
        Présentation
      </p>
      <h1
        id="atelier-page-title"
        class="mt-3 text-[2rem] font-semibold tracking-[0.12em] text-(--t2a-blue-dark) dark:text-(--t2a-blue) sm:text-[2.4rem] lg:text-[3.5rem]"
      >
        {atelierPageData.heading}
      </h1>
    </header>

    <div class="flex flex-col gap-20 sm:gap-24 lg:gap-28">
      <FigIDuo section={atelierPageData.duoFigure} />
      <FigIITitouan section={titouanSection} />
      <FigIIIThea section={theaSection} />
    </div>
  </div>
</section>
