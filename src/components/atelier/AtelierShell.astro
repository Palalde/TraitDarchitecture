---
import { atelierPageData } from "@/components/atelier/atelier.data";
import FigIDuo from "@/components/atelier/sections/FigIDuo.astro";
import FigIITitouan from "@/components/atelier/sections/FigIITitouan.astro";
import FigIIIThea from "@/components/atelier/sections/FigIIIThea.astro";

const [titouanSection, theaSection] = atelierPageData.people;
---

<section
  aria-labelledby="atelier-page-title"
  class="relative w-full"
  data-atelier-shell
>
  <script is:inline data-astro-rerun>
    (() => {
      const shell = document.querySelector("[data-atelier-shell]");
      if (!shell) return;

      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        shell
          .querySelectorAll("[data-reveal]")
          .forEach((el) => el.classList.add("revealed"));
        return;
      }

      if (window.__t2aAtelierIo) {
        window.__t2aAtelierIo.disconnect();
        window.__t2aAtelierIo = null;
      }

      const observed = new WeakSet();
      let syncTimerId = null;

      const isReadyForReveal = (el) => {
        const rect = el.getBoundingClientRect();
        const viewportHeight =
          window.innerHeight || document.documentElement.clientHeight;

        return (
          rect.top <= viewportHeight * 0.86 &&
          rect.bottom >= viewportHeight * 0.12
        );
      };

      const reveal = (el) => {
        el.classList.add("revealed");
        io.unobserve(el);

        window.setTimeout(() => {
          if (!el.classList.contains("revealed")) return;

          el.style.animation = "none";
          el.style.opacity = "1";
          el.style.transform = "none";
        }, 850);
      };

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting || entry.intersectionRatio < 0.12) {
              return;
            }

            reveal(entry.target);
          });
        },
        { rootMargin: "0px 0px -14% 0px", threshold: 0.12 },
      );

      window.__t2aAtelierIo = io;

      const syncTargets = () => {
        shell.querySelectorAll("[data-reveal]").forEach((el) => {
          if (
            el.classList.contains("revealed") ||
            getComputedStyle(el).display === "none"
          ) {
            return;
          }

          if (isReadyForReveal(el)) {
            reveal(el);
            return;
          }

          if (observed.has(el)) return;

          observed.add(el);
          io.observe(el);
        });
      };

      const scheduleSync = () => {
        if (syncTimerId !== null) return;

        syncTimerId = setTimeout(() => {
          syncTimerId = null;
          syncTargets();
        }, 100);
      };

      const teardown = () => {
        io.disconnect();
        window.__t2aAtelierIo = null;

        if (syncTimerId !== null) {
          clearTimeout(syncTimerId);
          syncTimerId = null;
        }

        window.removeEventListener("scroll", scheduleSync);
        window.removeEventListener("resize", scheduleSync);
        document.removeEventListener("astro:before-swap", onBeforeSwap);
      };

      const onBeforeSwap = (event) => {
        const nextPath = new URL(event.to.href).pathname;
        if (nextPath !== "/atelier") teardown();
      };

      requestAnimationFrame(syncTargets);
      window.addEventListener("scroll", scheduleSync, { passive: true });
      window.addEventListener("resize", scheduleSync, { passive: true });
      document.addEventListener("astro:before-swap", onBeforeSwap);
    })();
  </script>

  <div
    class="relative z-10 mx-auto flex w-full max-w-7xl flex-col gap-16 px-6 pt-20 pb-(--footer-root-overlap) sm:gap-20 sm:px-8 sm:pt-24 lg:gap-20 lg:px-10 lg:pt-28"
  >
    <div class="flex flex-col gap-16 sm:gap-20 lg:gap-15">
      <FigIDuo section={atelierPageData.duoFigure} />
      <FigIITitouan section={titouanSection} />
      <div class="flex flex-col">
        <FigIIIThea section={theaSection} />
        <div
          aria-hidden="true"
          class="pointer-events-none relative flex h-30 justify-center sm:h-38 md:h-46 lg:h-70 2xl:h-120"
          data-atelier-footer-bridge
        >
          <span class="hidden h-[105%] w-px bg-(--trait) lg:block"></span>
        </div>
      </div>
    </div>
  </div>
</section>
