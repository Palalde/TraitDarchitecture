---
import { atelierPageData } from "@/components/atelier/atelier.data";
import FigIDuo from "@/components/atelier/sections/FigIDuo.astro";
import FigIITitouan from "@/components/atelier/sections/FigIITitouan.astro";
import FigIIIThea from "@/components/atelier/sections/FigIIIThea.astro";

const [titouanSection, theaSection] = atelierPageData.people;
---

<section
  aria-labelledby="atelier-page-title"
  class="relative w-full"
  data-atelier-shell
>
  <script is:inline data-astro-rerun>
    (() => {
      const revealSystem = window.__t2aReveal;
      if (!revealSystem) return;

      revealSystem
        .createController({
          id: "atelier",
          pathname: "/atelier",
          rootSelector: "[data-atelier-shell]",
        })
        ?.startAfterPageVisible(revealSystem.getResponsiveDelay());
    })();
  </script>

  <div
    class="relative z-10 mx-auto flex w-full max-w-7xl flex-col gap-16 px-6 pt-20 pb-(--footer-root-overlap) sm:gap-20 sm:px-8 sm:pt-24 lg:gap-20 lg:px-10 lg:pt-28"
  >
    <div class="flex flex-col gap-16 sm:gap-18 lg:gap-8">
      <FigIDuo
        heading={atelierPageData.heading}
        section={atelierPageData.duoFigure}
      />
      <FigIITitouan section={titouanSection} />
      <div class="flex flex-col">
        <FigIIIThea section={theaSection} />
        <div
          aria-hidden="true"
          class="pointer-events-none relative flex h-30 justify-center sm:h-38 md:h-46 lg:h-70 2xl:h-120"
          data-atelier-footer-bridge
        >
          <span
            class="hidden h-[105%] w-px bg-(--trait) [--reveal-d:720ms] lg:block"
            data-reveal="bar-from-top"
          >
          </span>
        </div>
      </div>
    </div>
  </div>

  <script is:inline data-astro-rerun>
    // Narrow-tall mobile: the sticky portrait must leave with the last text
    // card, i.e. release one card height before the end of the stack. The
    // cards share one height (auto-rows-fr) that depends on the text wrap
    // (width, font loading, theme weight): measure it as --atelier-card-h.
    (() => {
      const groups = Array.from(
        document.querySelectorAll("[data-atelier-person]"),
      );
      if (!groups.length) return;

      const sync = (group) => {
        const card = group.querySelector("[data-atelier-card]");
        if (card) {
          group.style.setProperty("--atelier-card-h", `${card.offsetHeight}px`);
        }
      };

      groups.forEach(sync);
      if (!("ResizeObserver" in window)) return;

      const observer = new ResizeObserver((entries) => {
        entries.forEach((entry) => {
          const group = entry.target.closest("[data-atelier-person]");
          if (group) sync(group);
        });
      });

      groups.forEach((group) => {
        const card = group.querySelector("[data-atelier-card]");
        if (card) observer.observe(card);
      });

      document.addEventListener(
        "astro:before-swap",
        () => observer.disconnect(),
        { once: true },
      );
    })();
  </script>
</section>
