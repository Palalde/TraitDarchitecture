---
interface Props {
  className?: string;
  teaserText?: string;
  ctaHref?: string;
  ctaLabel?: string;
  panelLabel?: string;
  footerLabel?: string;
  lineWidths?: string[];
  teaserReveal?: string;
  ctaReveal?: string;
  containerReveal?: string;
}

const {
  className,
  teaserText,
  ctaHref,
  ctaLabel,
  panelLabel = "Structure teaser",
  footerLabel = "Zone texte",
  lineWidths = ["w-10/12", "w-full", "w-11/12", "w-8/12"],
  teaserReveal,
  ctaReveal,
  containerReveal,
}: Props = Astro.props;

const placeholderClassName = "border border-(--border) bg-(--bg-secondary)";
const hasTeaserContent = Boolean(teaserText);
const containerClassName = hasTeaserContent
  ? "mt-8 border border-(--border) bg-(--bg-primary) p-6 sm:p-8 lg:mt-10 lg:border-0 lg:bg-transparent lg:p-0"
  : "mt-8 border border-(--border) bg-(--bg-primary) p-6 sm:p-8 lg:mt-10 lg:p-10";
---

<div
  class:list={[
    containerClassName,
    className,
    containerReveal && "max-lg:[--reveal-start-opacity:1]",
  ]}
  data-reveal={containerReveal}
  data-reveal-group={containerReveal ? "" : undefined}
>
  {
    hasTeaserContent ? (
      <>
        <p
          class="max-w-xl text-[1rem] leading-7 text-(--text-primary) sm:text-[1.05rem] sm:leading-8"
          data-reveal={teaserReveal}
        >
          {teaserText}
        </p>

        {ctaHref && ctaLabel ? (
          <a
            href={ctaHref}
            class="group mt-8 inline-flex items-center gap-2 text-[0.82rem] uppercase tracking-[0.14em] text-(--t2a-blue-dark) transition-colors duration-200 hover:text-(--t2a-blue) dark:text-(--t2a-blue) dark:hover:text-(--t2a-blue-light)"
            data-reveal={ctaReveal}
            data-reveal-independent={ctaReveal ? "" : undefined}
          >
            <span class="relative">
              {ctaLabel}
              <span
                aria-hidden="true"
                class="absolute bottom-0 left-0 h-px w-0 bg-(--trait) transition-all duration-300 group-hover:w-full"
              />
            </span>
            <span aria-hidden="true" class="text-[1.1em]">
              →
            </span>
          </a>
        ) : null}
      </>
    ) : (
      <>
        <p class="text-[0.8rem] uppercase tracking-[0.16em] text-(--text-muted)">
          {panelLabel}
        </p>
        <div class="mt-5 space-y-3" aria-hidden="true">
          {lineWidths.map((width) => (
            <div class:list={[placeholderClassName, "h-3", width]} />
          ))}
        </div>
        <div class="mt-8 flex items-center gap-3 text-[0.82rem] uppercase tracking-[0.14em] text-(--t2a-blue-dark) dark:text-(--t2a-blue)">
          <span>{footerLabel}</span>
          <span aria-hidden="true" class="h-px flex-1 bg-(--trait)" />
        </div>
      </>
    )
  }
</div>
