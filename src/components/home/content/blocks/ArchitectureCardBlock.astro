---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import T2AMotifPattern from "@/components/ui/background/T2AMotifPattern.astro";
import { ParallaxFrame } from "./ParallaxFrame";

interface Props {
  className?: string;
  label?: string;
  subtitle?: string;
  lineWidths?: readonly string[];
  image?: ImageMetadata;
  imageAlt?: string;
  imageClassName?: string;
  parallax?: boolean;
  parallaxOverflow?: number;
  mobileParallaxOverflow?: number;
}

const {
  className,
  label,
  subtitle,
  lineWidths = ["w-8/12", "w-10/12"],
  image,
  imageAlt = "",
  imageClassName = "object-cover object-center",
  parallax = false,
  parallaxOverflow = 0.025,
  mobileParallaxOverflow = 0.04,
}: Props = Astro.props;

const hasLabel = Boolean(label);
---

<article
  class:list={[
    "relative z-10 overflow-hidden border border-(--border) bg-(--bg-primary) p-4 sm:p-5",
    className,
  ]}
>
  <T2AMotifPattern />

  <div
    class="relative z-10 aspect-4/5 w-full overflow-hidden border border-(--trait) bg-(--t2a-blue-wash)"
  >
    {
      image && parallax ? (
        <ParallaxFrame
          client:visible
          overflowPercent={parallaxOverflow}
          mobileOverflowPercent={mobileParallaxOverflow}
        >
          <Image
            alt={imageAlt}
            class:list={["h-full w-full", imageClassName]}
            draggable="false"
            loading="lazy"
            quality={85}
            widths={[400, 600, 800]}
            sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
            src={image}
          />
        </ParallaxFrame>
      ) : image ? (
        <Image
          alt={imageAlt}
          class:list={["h-full w-full", imageClassName]}
          draggable="false"
          loading="lazy"
          quality={85}
          widths={[400, 600, 800]}
          sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
          src={image}
        />
      ) : null
    }
  </div>
  {
    hasLabel ? (
      <div class="relative z-10 mt-5">
        <p class="text-[0.95rem] font-semibold uppercase tracking-widest text-(--t2a-blue-dark) dark:text-(--t2a-blue)">
          {label}
        </p>
        {subtitle && (
          <p class="mt-1 text-[0.82rem] tracking-[0.04em] text-(--text-secondary)">
            {subtitle}
          </p>
        )}
      </div>
    ) : (
      <div class="relative z-10 mt-5 space-y-3" aria-hidden="true">
        {lineWidths.map((width) => (
          <div
            class:list={[
              "h-3 border border-(--border) bg-(--bg-secondary)",
              width,
            ]}
          />
        ))}
      </div>
    )
  }
</article>
