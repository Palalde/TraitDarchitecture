---
interface Props {
  containerClassName: string;
  label: string;
}

const { containerClassName, label }: Props = Astro.props;
---

<div class={containerClassName}>
  <div class="w-full border border-(--border) bg-(--bg-secondary) p-4 sm:p-5">
    <div
      class="aspect-9/10 w-full border border-(--trait) bg-(--t2a-blue-wash)"
    >
    </div>
    <p
      class="mt-4 text-center text-[0.8rem] uppercase tracking-[0.16em] text-(--text-secondary)"
    >
      {label}
    </p>
  </div>
</div>
