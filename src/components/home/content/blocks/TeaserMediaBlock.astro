---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import T2AMotifPattern from "@/components/ui/background/T2AMotifPattern.astro";
import { ParallaxFrame } from "./ParallaxFrame";

interface Props {
  containerClassName: string;
  label: string;
  image?: ImageMetadata;
  imageAlt?: string;
  imageClassName?: string;
  imageLoading?: "lazy" | "eager";
  parallax?: boolean;
  parallaxOverflow?: number;
}

const {
  containerClassName,
  label,
  image,
  imageAlt = "",
  imageClassName = "object-cover object-center",
  imageLoading = "lazy",
  parallax = false,
  parallaxOverflow = 0.1,
}: Props = Astro.props;
---

<div class={containerClassName}>
  <div
    class="relative w-full overflow-hidden border border-(--border) bg-(--bg-secondary) p-4 sm:p-5"
  >
    <T2AMotifPattern />

    <div
      class="relative z-10 aspect-square w-full overflow-hidden border border-(--trait) bg-(--t2a-blue-wash)"
    >
      {
        image && parallax ? (
          <ParallaxFrame client:visible overflowPercent={parallaxOverflow}>
            <Image
              alt={imageAlt}
              class:list={["h-full w-full", imageClassName]}
              draggable="false"
              loading={imageLoading}
              quality={85}
              widths={[400, 600, 800]}
              sizes="(min-width: 1024px) 50vw, 100vw"
              src={image}
            />
          </ParallaxFrame>
        ) : image ? (
          <Image
            alt={imageAlt}
            class:list={["h-full w-full", imageClassName]}
            draggable="false"
            loading={imageLoading}
            quality={85}
            widths={[400, 600, 800]}
            sizes="(min-width: 1024px) 50vw, 100vw"
            src={image}
          />
        ) : null
      }
    </div>
    <p
      class="relative z-10 mt-4 text-center text-[0.8rem] uppercase tracking-[0.16em] text-(--text-primary)"
    >
      {label}
    </p>
  </div>
</div>
