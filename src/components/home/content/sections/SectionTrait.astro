---
import TeaserContentBlock from "@/components/home/content/blocks/TeaserContentBlock.astro";
import TeaserMediaBlock from "@/components/home/content/blocks/TeaserMediaBlock.astro";
import carnetPhoto from "@/assets/photos/home/carnet.jpg";

interface Props {
  className?: string;
}

const { className }: Props = Astro.props;

// text
const traitTeaser =
  "Chaque projet commence par l'écoute du lieu, des usages et de ceux qui y vivront. Du premier trait jusqu'à la remise des clefs, nous accompagnons une aventure humaine fondée sur la confiance et le dialogue.";

const traitCtaLabel = "Découvrir notre approche";
---

<section id="trait" aria-labelledby="home-section-trait" class={className}>
  <!-- title -->
  <h2 id="home-section-trait" class="sr-only">TraiT</h2>

  <!-- trait -->
  <div class="relative z-10 mb-10 sm:mb-12 lg:hidden">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute bottom-full left-1/2 h-12 w-px -translate-x-1/2 bg-(--trait) sm:h-14"
    >
    </div>

    <div class="flex items-center gap-4">
      <div aria-hidden="true" class="h-px flex-1 bg-(--trait)"></div>
      <span
        aria-hidden="true"
        class="shrink-0 text-center text-[1.5rem] font-semibold tracking-[0.12em] text-(--t2a-blue-dark) dark:text-(--t2a-blue)"
      >
        TraiT
      </span>
      <div aria-hidden="true" class="h-px flex-1 bg-(--trait)"></div>
    </div>
  </div>

  <!-- container content -->
  <div
    class="relative mt-10 grid grid-cols-1 items-center gap-10 sm:mt-12 lg:mt-0 lg:min-h-[inherit] lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-16"
  >
    <div
      aria-hidden="true"
      class="pointer-events-none absolute left-1/2 z-0 w-px -translate-x-1/2 bg-(--trait) -top-10 -bottom-12 sm:-top-12 sm:-bottom-14 lg:hidden"
    >
    </div>

    <div
      aria-hidden="true"
      class="pointer-events-none absolute left-1/2 z-0 hidden w-px -translate-x-1/2 bg-(--trait) lg:block lg:-top-32 lg:-bottom-32"
    >
    </div>

    <!-- media block -->
    <TeaserMediaBlock
      containerClassName="relative z-10 order-1 flex h-full items-center lg:order-1 lg:pr-12"
      image={carnetPhoto}
      imageAlt="Carnet de relevé, plans et ordinateur posés sur des rochers face à la mer"
      imageClassName="object-cover object-[70%_center]"
      label="Philosophie & Méthode"
    />

    <div
      class="relative z-10 order-2 flex h-full flex-col justify-center lg:order-2 lg:pl-12"
    >
      <div class="hidden items-center gap-4 lg:flex lg:justify-end">
        <div aria-hidden="true" class="h-px flex-1 bg-(--trait)"></div>
        <span
          aria-hidden="true"
          class="shrink-0 text-center text-[1.5rem] font-semibold tracking-[0.12em] text-(--t2a-blue-dark) dark:text-(--t2a-blue) lg:text-right lg:text-[2.25rem]"
        >
          TraiT
        </span>
      </div>

      <!-- content block -->
      <TeaserContentBlock
        teaserText={traitTeaser}
        ctaHref="/trait/philosophie"
        ctaLabel={traitCtaLabel}
      />
    </div>
  </div>
</section>
