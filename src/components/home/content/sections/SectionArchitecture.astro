---
import ProjectCard from "@/components/architecture/blocks/ProjectCard.astro";
import { getHomeFeaturedProjects } from "@/components/architecture/architecture.data";

interface Props {
  className?: string;
}

const { className }: Props = Astro.props;

// Reveal config positionnelle (1er / 2e / 3e projet vedette).
const REVEAL_CONFIG = [
  {
    cardReveal: "fade-left" as const,
    mobileCardReveal: "fade-up" as const,
    cardRevealDelay: "max-lg:[--reveal-start-opacity:1]",
  },
  {
    cardReveal: "fade-up" as const,
    mobileCardReveal: undefined,
    cardRevealDelay: "[--reveal-start-opacity:1]",
  },
  {
    cardReveal: "fade-right" as const,
    mobileCardReveal: "fade-up" as const,
    cardRevealDelay: "max-lg:[--reveal-start-opacity:1]",
  },
];

// Projets vedettes pilotés par le champ `home` du frontmatter (position 1, 2, 3).
const featuredProjects = await getHomeFeaturedProjects();
const architectureCards = featuredProjects.map((project, index) => {
  const slug = project.id.replace(/\/index$/, "");
  const { name, city, dept, cover, coverAlt } = project.data;
  return {
    image: cover,
    imageAlt: coverAlt,
    imageClassName: "object-cover object-center",
    label: name,
    subtitle: `${city} (${dept})`,
    href: `/architecture/${slug}`,
    ...REVEAL_CONFIG[index],
  };
});
---

<section
  id="architecture"
  aria-labelledby="home-section-architecture"
  class={className}
>
  <!-- trait -->
  <div class="flex h-full flex-col justify-center">
    <div class="relative z-10 mx-auto flex w-full max-w-4xl items-center gap-4">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute bottom-full left-1/2 h-12 w-px -translate-x-1/2 bg-(--trait) sm:h-14 lg:h-20 xl:h-24"
        data-reveal="bar-from-top"
      >
      </div>
      <div
        aria-hidden="true"
        class="h-px flex-1 bg-(--trait)"
        data-reveal="bar-from-right"
      >
      </div>
      <h2
        id="home-section-architecture"
        class="shrink-0 text-center text-[1.5rem] font-semibold tracking-[0.12em] text-(--t2a-blue-dark) dark:text-(--t2a-blue) lg:text-[2.25rem]"
        data-reveal="fade"
      >
        D'ARCHITECTURE
      </h2>
      <div
        aria-hidden="true"
        class="h-px flex-1 bg-(--trait)"
        data-reveal="bar-from-left"
      >
      </div>
    </div>

    <!-- cards container -->
    <div
      class="relative z-10 mt-10 grid grid-cols-1 gap-6 sm:mt-12 lg:mt-14 lg:grid-cols-3 lg:gap-8"
    >
      <div
        aria-hidden="true"
        class="pointer-events-none absolute left-1/2 z-0 w-px -translate-x-1/2 bg-(--trait) -top-10 -bottom-35 sm:-top-12 sm:-bottom-40 lg:-top-14 lg:-bottom-50 xl:-bottom-35"
        data-reveal="bar-from-top"
      >
      </div>

      <!-- architecture cards -->
      {
        architectureCards.map(
          ({
            image,
            imageAlt,
            imageClassName,
            label,
            subtitle,
            href,
            cardReveal,
            cardRevealDelay,
            mobileCardReveal,
          }) => (
            <ProjectCard
              image={image}
              imageAlt={imageAlt}
              imageClassName={imageClassName}
              label={label}
              subtitle={subtitle}
              href={href}
              parallax
              cardReveal={cardReveal}
              cardRevealDelay={cardRevealDelay}
              mobileCardReveal={mobileCardReveal}
            />
          ),
        )
      }
    </div>

    <!-- cta -->
    <div class="relative z-10 mt-10 flex justify-center sm:mt-12">
      <a
        href="/architecture"
        class="group inline-flex items-center gap-2 border border-(--border) bg-(--bg-primary) px-6 py-3 text-[0.9rem] uppercase tracking-[0.14em] text-(--t2a-blue-dark) transition-colors hover:text-(--t2a-blue) dark:text-(--t2a-blue) dark:hover:text-(--t2a-blue-light)"
        data-reveal="fade"
      >
        <span class="relative">
          Découvrir nos projets
          <span
            aria-hidden="true"
            class="absolute bottom-0 left-0 h-px w-0 bg-(--trait) transition-all group-hover:w-full"
          ></span>
        </span>
        <span aria-hidden="true" class="text-[1.1em]">→</span>
      </a>
    </div>
  </div>
</section>
