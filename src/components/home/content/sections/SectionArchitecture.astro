---
import ArchitectureCardBlock from "@/components/home/content/blocks/ArchitectureCardBlock.astro";
import bancaouImg from "@/assets/photos/home/le-bancaou-coupe-3d.png";
import secaireImg from "@/assets/photos/home/u-secaire-croquis.png";
import casaVImg from "@/assets/photos/home/casa-v-facade-croquis.jpg";

interface Props {
  className?: string;
}

const { className }: Props = Astro.props;

const architectureCards = [
  {
    image: casaVImg,
    imageAlt: "CASA V — Croquis de façade du projet à Olmeta-di-Tuda, Corse",
    imageClassName: "object-cover object-center",
    lineWidths: ["w-8/12", "w-10/12"],
  },
  {
    image: bancaouImg,
    imageAlt: "LE BANCAOU — Coupe 3D du projet à Sausset-les-Pins, Côte Bleue",
    imageClassName: "object-cover object-center",
    lineWidths: ["w-8/12", "w-10/12"],
  },
  {
    image: secaireImg,
    imageAlt: "U SECAïRE — Croquis axonométrique du projet à Mézel, Provence",
    imageClassName: "object-cover object-center",
    lineWidths: ["w-8/12", "w-10/12"],
  },
];
---

<section
  id="architecture"
  aria-labelledby="home-section-architecture"
  class={className}
>
  <div class="flex h-full flex-col justify-center">
    <div class="relative z-10 mx-auto flex w-full max-w-4xl items-center gap-4">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute bottom-full left-1/2 h-12 w-px -translate-x-1/2 bg-(--trait) sm:h-14 lg:h-32"
      >
      </div>
      <div aria-hidden="true" class="h-px flex-1 bg-(--trait)"></div>
      <h2
        id="home-section-architecture"
        class="shrink-0 text-center text-[1.5rem] font-semibold tracking-[0.12em] text-(--t2a-blue-dark) dark:text-(--t2a-blue) lg:text-[2.25rem]"
      >
        D'ARCHITECTURE
      </h2>
      <div aria-hidden="true" class="h-px flex-1 bg-(--trait)"></div>
    </div>

    <div
      class="relative z-10 mt-10 grid grid-cols-1 gap-6 sm:mt-12 lg:mt-14 lg:grid-cols-3 lg:gap-8"
    >
      <div
        aria-hidden="true"
        class="architecture-center-trait pointer-events-none absolute left-1/2 z-0 w-px -translate-x-1/2 bg-(--trait) -top-10 -bottom-12 sm:-top-12 sm:-bottom-14 lg:-top-14 lg:-bottom-49 xl:-bottom-24"
      >
      </div>

      {
        architectureCards.map(
          ({ image, imageAlt, imageClassName, lineWidths }) => (
            <ArchitectureCardBlock
              image={image}
              imageAlt={imageAlt}
              imageClassName={imageClassName}
              lineWidths={lineWidths}
            />
          ),
        )
      }
    </div>
  </div>
</section>

<style>
  @media (min-width: 1210px) and (max-width: 1279px) {
    .architecture-center-trait {
      bottom: -8rem;
    }
  }
</style>
