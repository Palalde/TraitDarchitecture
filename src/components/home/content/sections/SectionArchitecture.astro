---
import ArchitectureCardBlock from "@/components/home/content/blocks/ArchitectureCardBlock.astro";
import bancaouImg from "@/assets/photos/home/le-bancaou-coupe-3d.png";
import secaireImg from "@/assets/photos/home/u-secaire-croquis.png";
import casaVImg from "@/assets/photos/home/casa-v-facade-croquis.jpg";

interface Props {
  className?: string;
}

const { className }: Props = Astro.props;

// cards data
const architectureCards = [
  {
    image: casaVImg,
    imageAlt: "CASA V — Croquis de façade du projet à Olmeta-di-Tuda, Corse",
    imageClassName: "object-cover object-center",
    label: "CASA V",
    subtitle: "Olmeta-di-Tuda, Corse",
    href: "#", // TODO: remplacer par "/architecture/casa-v"
  },
  {
    image: bancaouImg,
    imageAlt: "LE BANCAOU — Coupe 3D du projet à Sausset-les-Pins, Côte Bleue",
    imageClassName: "object-cover object-center",
    label: "LE BANCAOU",
    subtitle: "Sausset-les-Pins, Côte Bleue",
    href: "#", // TODO: remplacer par "/architecture/le-bancaou"
  },
  {
    image: secaireImg,
    imageAlt: "U SECAïRE — Croquis axonométrique du projet à Mézel, Provence",
    imageClassName: "object-cover object-center",
    label: "U SECAïRE",
    subtitle: "Mézel, Provence",
    href: "#", // TODO: remplacer par "/architecture/u-secaire"
  },
];
---

<section
  id="architecture"
  aria-labelledby="home-section-architecture"
  class={className}
>
  <!-- trait -->
  <div class="flex h-full flex-col justify-center">
    <div class="relative z-10 mx-auto flex w-full max-w-4xl items-center gap-4">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute bottom-full left-1/2 h-12 w-px -translate-x-1/2 bg-(--trait) sm:h-14 lg:-h-1"
      >
      </div>
      <div aria-hidden="true" class="h-px flex-1 bg-(--trait)"></div>
      <h2
        id="home-section-architecture"
        class="shrink-0 text-center text-[1.5rem] font-semibold tracking-[0.12em] text-(--t2a-blue-dark) dark:text-(--t2a-blue) lg:text-[2.25rem]"
      >
        D'ARCHITECTURE
      </h2>
      <div aria-hidden="true" class="h-px flex-1 bg-(--trait)"></div>
    </div>

    <!-- cards container -->
    <div
      class="relative z-10 mt-10 grid grid-cols-1 gap-6 sm:mt-12 lg:mt-14 lg:grid-cols-3 lg:gap-8"
    >
      <div
        aria-hidden="true"
        class="pointer-events-none absolute left-1/2 z-0 w-px -translate-x-1/2 bg-(--trait) -top-10 -bottom-35 sm:-top-12 sm:-bottom-40 lg:-top-14 lg:-bottom-50 xl:-bottom-35"
      >
      </div>

      <!-- architecture cards -->
      {
        architectureCards.map(
          ({ image, imageAlt, imageClassName, label, subtitle, href }) => (
            <ArchitectureCardBlock
              image={image}
              imageAlt={imageAlt}
              imageClassName={imageClassName}
              label={label}
              subtitle={subtitle}
              href={href}
              parallax
            />
          ),
        )
      }
    </div>

    <!-- cta -->
    <div class="relative z-10 mt-10 flex justify-center sm:mt-12">
      <a
        href="/architecture"
        class="group inline-flex items-center gap-2 border border-(--border) bg-(--bg-primary) px-6 py-3 text-[0.9rem] uppercase tracking-[0.14em] text-(--t2a-blue-dark) transition-colors duration-200 hover:text-(--t2a-blue) dark:text-(--t2a-blue) dark:hover:text-(--t2a-blue-light)"
      >
        <span class="relative">
          Découvrir nos projets
          <span
            aria-hidden="true"
            class="absolute bottom-0 left-0 h-px w-0 bg-(--trait) transition-all duration-300 group-hover:w-full"
          ></span>
        </span>
        <span aria-hidden="true" class="text-[1.1em]">→</span>
      </a>
    </div>
  </div>
</section>
