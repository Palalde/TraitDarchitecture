---
interface Props {
  className?: string;
}

const { className }: Props = Astro.props;
---

<section id="extrait" aria-labelledby="home-section-extrait" class={className}>
  <div class="flex h-full flex-col justify-center">
    <div class="relative z-10 mx-auto flex w-full max-w-3xl items-center gap-4">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute bottom-full left-1/2 h-12 w-px -translate-x-1/2 bg-(--trait) sm:h-14 lg:h-20 xl:h-24"
      >
      </div>
      <div aria-hidden="true" class="h-px flex-1 bg-(--trait)"></div>
      <h2
        id="home-section-extrait"
        class="shrink-0 text-center text-[1.5rem] font-semibold tracking-[0.12em] text-(--t2a-blue-dark) dark:text-(--t2a-blue) lg:text-[2.25rem]"
      >
        EXTraiT
      </h2>
      <div aria-hidden="true" class="h-px flex-1 bg-(--trait)"></div>
    </div>

    <div
      class="relative z-10 mt-10 grid grid-cols-1 gap-10 sm:mt-12 lg:mt-14 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:gap-16"
    >
      <div
        aria-hidden="true"
        class="pointer-events-none absolute left-1/2 z-0 w-px -translate-x-1/2 bg-(--trait) -top-10 -bottom-24 sm:-top-12 sm:-bottom-28 lg:-top-14 lg:-bottom-80"
      >
      </div>

      <div
        class="relative z-10 border border-(--border) bg-(--bg-primary) p-6 sm:p-8 lg:mr-6 lg:p-10"
      >
        <p
          class="text-[0.8rem] uppercase tracking-[0.16em] text-(--text-muted)"
        >
          Bloc éditorial
        </p>
        <div class="mt-5 space-y-3" aria-hidden="true">
          <div class="h-3 w-9/12 border border-(--border) bg-(--bg-secondary)">
          </div>
          <div class="h-3 w-full border border-(--border) bg-(--bg-secondary)">
          </div>
          <div class="h-3 w-11/12 border border-(--border) bg-(--bg-secondary)">
          </div>
          <div class="h-3 w-7/12 border border-(--border) bg-(--bg-secondary)">
          </div>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-6 lg:pl-12">
        <div
          aria-hidden="true"
          class="absolute bottom-0 left-3 top-0 hidden w-px bg-(--trait) lg:block"
        >
        </div>

        <article
          class="relative border border-(--border) bg-(--bg-primary) p-5 lg:pl-12"
        >
          <span
            aria-hidden="true"
            class="absolute left-0 top-5 hidden -translate-x-[calc(50%-1px)] text-[0.9rem] leading-none text-(--trait) lg:block"
            >●</span
          >
          <div class="space-y-3" aria-hidden="true">
            <div
              class="h-3 w-9/12 border border-(--border) bg-(--bg-secondary)"
            >
            </div>
            <div
              class="h-3 w-full border border-(--border) bg-(--bg-secondary)"
            >
            </div>
            <div
              class="h-3 w-10/12 border border-(--border) bg-(--bg-secondary)"
            >
            </div>
          </div>
        </article>

        <article
          class="relative border border-(--border) bg-(--bg-primary) p-5 lg:pl-12"
        >
          <span
            aria-hidden="true"
            class="absolute left-0 top-5 hidden -translate-x-[calc(50%-1px)] text-[0.9rem] leading-none text-(--trait) lg:block"
            >●</span
          >
          <div class="space-y-3" aria-hidden="true">
            <div
              class="h-3 w-9/12 border border-(--border) bg-(--bg-secondary)"
            >
            </div>
            <div
              class="h-3 w-full border border-(--border) bg-(--bg-secondary)"
            >
            </div>
            <div
              class="h-3 w-10/12 border border-(--border) bg-(--bg-secondary)"
            >
            </div>
          </div>
        </article>

        <article
          class="relative border border-(--border) bg-(--bg-primary) p-5 lg:pl-12"
        >
          <span
            aria-hidden="true"
            class="absolute left-0 top-5 hidden -translate-x-[calc(50%-1px)] text-[0.9rem] leading-none text-(--trait) lg:block"
            >●</span
          >
          <div class="space-y-3" aria-hidden="true">
            <div
              class="h-3 w-9/12 border border-(--border) bg-(--bg-secondary)"
            >
            </div>
            <div
              class="h-3 w-full border border-(--border) bg-(--bg-secondary)"
            >
            </div>
            <div
              class="h-3 w-10/12 border border-(--border) bg-(--bg-secondary)"
            >
            </div>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>
