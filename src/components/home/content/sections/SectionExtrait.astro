---
import ExtraitArticleBlock from "@/components/home/content/blocks/ExtraitArticleBlock.astro";

interface Props {
  className?: string;
}

const { className }: Props = Astro.props;

// editorial
const editorialLabel = "Ce qu'est EXTraiT";

const editorialText =
  "EXTraiT rassemble nos articles, prises de position et retours de terrain sur les questions que particuliers comme professionnels se posent avant de construire, rénover ou transformer. Un espace pour dépasser les idées reçues, comprendre les arbitrages et entrer dans les réalités d'un projet architectural.";

const editorialCtaLabel = "Voir tous les articles";

const editorialTags = [
  "Budget",
  "Réglementation",
  "Autoconstruction",
  "& bien d'autres",
];
const articleCount = 6;

// articles data
const extraitArticles = [
  {
    title: "Pourquoi faire appel à un architecte ?",
    summary:
      "Temps, budget, charge mentale : pourquoi l'architecte reste un investissement de maîtrise plutôt qu'un coût supplémentaire.",
    href: "#",
  },
  {
    title: "Un architecte coûte trop cher, ce n'est pas pour moi !",
    summary:
      "Honoraires, reprises et surcoûts invisibles : ce que coûte vraiment un projet mal cadré avant même le chantier.",
    href: "#",
  },
  {
    title: "Auto-construction : Je veux faire mon chantier moi-même",
    summary:
      "Construire soi-même peut séduire, mais sans cadre, méthode et limites claires, le chantier devient long, risqué et épuisant.",
    href: "#",
  },
];
---

<section id="extrait" aria-labelledby="home-section-extrait" class={className}>
  <div class="flex h-full flex-col justify-center">
    <!-- trait -->
    <div class="relative z-10 mx-auto flex w-full max-w-3xl items-center gap-4">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute bottom-full left-1/2 h-12 w-px -translate-x-1/2 bg-(--trait) sm:h-14 lg:h-20 xl:h-24"
      >
      </div>
      <div aria-hidden="true" class="h-px flex-1 bg-(--trait)"></div>
      <h2
        id="home-section-extrait"
        class="shrink-0 text-center text-[1.5rem] font-semibold tracking-[0.12em] text-(--t2a-blue-dark) dark:text-(--t2a-blue) lg:text-[2.25rem]"
      >
        EXTraiT
      </h2>
      <div aria-hidden="true" class="h-px flex-1 bg-(--trait)"></div>
    </div>

    <!-- editorial -->
    <div
      class="relative z-10 mt-8 grid grid-cols-1 gap-8 sm:mt-10 lg:mt-12 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:gap-14"
    >
      <div
        aria-hidden="true"
        class="pointer-events-none absolute left-1/2 z-0 w-px -translate-x-1/2 bg-(--trait) -top-8 -bottom-35 sm:-top-10 sm:-bottom-48 lg:-top-12 lg:-bottom-80 2xl:-bottom-100"
      >
      </div>

      <div
        class="relative z-10 flex h-fit border border-(--border) bg-(--bg-primary) p-5 sm:p-6 lg:mr-6 lg:p-7"
      >
        <div class="flex flex-col">
          <p
            class="text-[0.8rem] uppercase tracking-[0.16em] text-(--text-muted)"
          >
            {editorialLabel}
          </p>
          <p
            class="mt-4 text-[0.98rem] leading-7 text-(--text-primary) sm:text-[1.02rem] sm:leading-8"
          >
            {editorialText}
          </p>

          <div class="mt-5 flex flex-wrap items-center gap-2">
            {
              editorialTags
                .slice(0, -1)
                .map((tag) => (
                  <span class="border border-(--border) px-3 py-1 text-[0.72rem] uppercase tracking-[0.12em] text-(--text-muted)">
                    {tag}
                  </span>
                ))
            }
            <span
              class="px-2 py-1 text-[0.72rem] italic tracking-[0.06em] text-(--text-muted)"
            >
              {editorialTags[editorialTags.length - 1]}
            </span>
          </div>

          <!-- cta -->
          <div class="mt-4 flex items-center justify-between">
            <a
              href="/extrait"
              class="group inline-flex items-center gap-2 text-[0.82rem] uppercase tracking-[0.14em] text-(--t2a-blue-dark) transition-colors duration-200 hover:text-(--t2a-blue) dark:text-(--t2a-blue) dark:hover:text-(--t2a-blue-light)"
            >
              <span class="relative">
                {editorialCtaLabel}
                <span
                  aria-hidden="true"
                  class="absolute bottom-0 left-0 h-px w-0 bg-(--trait) transition-all duration-300 group-hover:w-full"
                ></span>
              </span>
              <span aria-hidden="true" class="text-[1.1em]">→</span>
            </a>
            <span class="text-[0.78rem] tracking-[0.08em] text-(--text-muted)">
              {articleCount} articles publiés
            </span>
          </div>
        </div>
      </div>

      <!-- articles -->
      <div
        class="relative z-10 flex flex-col gap-3 lg:grid lg:h-full lg:grid-rows-3 lg:gap-3 lg:pl-12"
      >
        {
          extraitArticles.map(({ title, summary, href }) => (
            <ExtraitArticleBlock
              className="lg:h-full"
              title={title}
              summary={summary}
              href={href}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>
