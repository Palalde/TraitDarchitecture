---
import BackgroundDecorations from "@/components/ui/background/BackgroundDecorations.astro";
import SectionArchitecture from "@/components/home/content/sections/SectionArchitecture.astro";
import SectionAtelier from "@/components/home/content/sections/SectionAtelier.astro";
import SectionExtrait from "@/components/home/content/sections/SectionExtrait.astro";
import SectionTrait from "@/components/home/content/sections/SectionTrait.astro";

const sectionFrameClassName =
  "relative min-h-[34rem] sm:min-h-[38rem] lg:min-h-[42rem]";

const extraitSectionFrameClassName =
  "relative min-h-[28rem] sm:min-h-[30rem] lg:min-h-[33rem]";

const HOME_REVEAL_DELAY_AFTER_LANDING_MS = 50;
const HOME_REVEAL_DELAY_RETURNING_MS = 400;
---

<section
  aria-label="Contenu principal de l'accueil"
  class="relative w-full overflow-hidden bg-(--bg-primary)"
>
  <script
    define:vars={{
      delayAfterLanding: HOME_REVEAL_DELAY_AFTER_LANDING_MS,
      delayReturning: HOME_REVEAL_DELAY_RETURNING_MS,
    }}
  >
    (() => {
      const SELECTOR =
        "[data-reveal], [data-reveal-stagger], [data-reveal-container]";
      const observed = new Set();
      let started = false;
      let syncRafId = null;

      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      const syncTargets = (io) => {
        document.querySelectorAll(SELECTOR).forEach((el) => {
          if (
            el.classList.contains("revealed") ||
            observed.has(el) ||
            getComputedStyle(el).display === "none"
          ) {
            return;
          }

          observed.add(el);
          io.observe(el);
        });
      };

      const start = () => {
        if (started) return;

        // Defer until DOM is fully parsed (data-reveal elements are below this script).
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", start, { once: true });
          return;
        }

        started = true;

        if (!document.querySelector(SELECTOR)) return;

        // Default viewport root keeps IO compatible with OverlayScrollbars.
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.intersectionRatio < 0.2) return;

              entry.target.classList.add("revealed");
              observed.delete(entry.target);
              io.unobserve(entry.target);
            });
          },
          { threshold: 0.2 },
        );

        syncTargets(io);

        window.addEventListener(
          "resize",
          () => {
            if (syncRafId !== null) return;

            syncRafId = requestAnimationFrame(() => {
              syncRafId = null;
              syncTargets(io);
            });
          },
          { passive: true },
        );
      };

      const markReady = () => {
        document.body.dataset.homeRevealReady = "1";
        window.dispatchEvent(new CustomEvent("home-reveal:ready"));
        start();
      };

      if (document.body.dataset.homeRevealReady === "1") {
        start();
      } else if (document.body.classList.contains("landing-dismissed")) {
        setTimeout(markReady, delayReturning);
      } else {
        window.addEventListener(
          "landing:dismissed",
          () => setTimeout(markReady, delayAfterLanding),
          { once: true },
        );
      }
    })();
  </script>

  <BackgroundDecorations />

  <div
    class="relative z-10 mx-auto flex w-full max-w-7xl flex-col gap-24 px-6 pt-24 pb-35 sm:gap-28 sm:px-8 sm:pt-28 sm:pb-55 lg:gap-32 lg:px-10 lg:pt-32 lg:pb-55 2xl:pb-70"
  >
    <SectionAtelier className={sectionFrameClassName} />
    <SectionTrait className={sectionFrameClassName} />
    <SectionArchitecture className={sectionFrameClassName} />
    <SectionExtrait className={extraitSectionFrameClassName} />
  </div>
</section>
