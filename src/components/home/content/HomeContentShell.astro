---
import BackgroundDecorations from "@/components/ui/background/BackgroundDecorations.astro";
import SectionArchitecture from "@/components/home/content/sections/SectionArchitecture.astro";
import SectionAtelier from "@/components/home/content/sections/SectionAtelier.astro";
import SectionExtrait from "@/components/home/content/sections/SectionExtrait.astro";
import SectionTrait from "@/components/home/content/sections/SectionTrait.astro";

const sectionFrameClassName =
  "relative min-h-[34rem] sm:min-h-[38rem] lg:min-h-[42rem]";

const extraitSectionFrameClassName =
  "relative min-h-[28rem] sm:min-h-[30rem] lg:min-h-[33rem]";
---

<section
  aria-label="Contenu principal de l'accueil"
  class="relative w-full overflow-hidden bg-(--bg-primary)"
>
  <script is:inline data-astro-rerun>
    (() => {
      const DELAY_AFTER_SLIDING_MS = 0;
      const DELAY_RETURNING_MS = 400;
      const SELECTOR = "[data-reveal]";

      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      // Disconnect any previous IO/MO (from a prior home visit) to avoid leaks.
      if (window.__t2aHomeIo) {
        window.__t2aHomeIo.disconnect();
        window.__t2aHomeIo = null;
      }
      if (window.__t2aHomeMo) {
        window.__t2aHomeMo.disconnect();
        window.__t2aHomeMo = null;
      }

      const observed = new WeakSet();
      let started = false;
      let syncRafId = null;
      let io = null;
      let mo = null;
      let total = 0;
      let revealedCount = 0;

      const teardown = () => {
        if (io) {
          io.disconnect();
          io = null;
          window.__t2aHomeIo = null;
        }
        if (mo) {
          mo.disconnect();
          mo = null;
          window.__t2aHomeMo = null;
        }
      };

      const syncTargets = () => {
        if (!io) return;
        document.querySelectorAll(SELECTOR).forEach((el) => {
          if (
            el.classList.contains("revealed") ||
            observed.has(el) ||
            getComputedStyle(el).display === "none"
          ) {
            return;
          }

          observed.add(el);
          total += 1;
          io.observe(el);
        });
      };

      const scheduleSync = () => {
        if (syncRafId !== null) return;
        syncRafId = requestAnimationFrame(() => {
          syncRafId = null;
          syncTargets();
        });
      };

      const start = () => {
        if (started) return;
        started = true;

        io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.intersectionRatio < 0.2) return;

              entry.target.classList.add("revealed");
              io.unobserve(entry.target);
              revealedCount += 1;
              // All reveals done: stop observing the DOM entirely.
              if (revealedCount >= total && mo) {
                mo.disconnect();
                mo = null;
                window.__t2aHomeMo = null;
              }
            });
          },
          { threshold: 0.2 },
        );

        window.__t2aHomeIo = io;
        syncTargets();

        // Catch late-added elements: slow-network HTML parsing still ongoing,
        // React islands hydrating, or any dynamic DOM changes.
        mo = new MutationObserver(scheduleSync);
        mo.observe(document.body, { childList: true, subtree: true });
        window.__t2aHomeMo = mo;

        window.addEventListener("resize", scheduleSync, { passive: true });
      };

      // Clean up when navigating away from the home page via SPA nav.
      document.addEventListener(
        "astro:before-swap",
        (event) => {
          const nextPath = new URL(event.to.href).pathname;
          if (nextPath !== "/") teardown();
        },
        { once: true },
      );

      // Returning visitor (landing already dismissed via sessionStorage)
      // OR returning via SPA nav (class set by LandingIsland on previous visit):
      // start reveals with a short delay so the page has time to paint.
      const isDismissed =
        sessionStorage.getItem("t2a-landing-dismissed") === "1" ||
        document.body.classList.contains("landing-dismissed");

      if (isDismissed) {
        setTimeout(start, DELAY_RETURNING_MS);
      } else {
        window.addEventListener(
          "landing:sliding-up",
          () => setTimeout(start, DELAY_AFTER_SLIDING_MS),
          { once: true },
        );
      }
    })();
  </script>

  <BackgroundDecorations />

  <div
    class="relative z-10 mx-auto flex w-full max-w-7xl flex-col gap-24 px-6 pt-24 pb-35 sm:gap-28 sm:px-8 sm:pt-28 sm:pb-55 lg:gap-32 lg:px-10 lg:pt-32 lg:pb-55 2xl:pb-70"
  >
    <SectionAtelier className={sectionFrameClassName} />
    <SectionTrait className={`${sectionFrameClassName} lg:-mt-32`} />
    <SectionArchitecture className={`${sectionFrameClassName} lg:-mt-16`} />
    <SectionExtrait className={`${extraitSectionFrameClassName} lg:-mt-8`} />
  </div>
</section>
