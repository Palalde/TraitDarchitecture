---
import { Image } from "astro:assets";
import topoImg from "@/assets/illustrations/T2A_Plan_Topo_territoire.webp";
import coupeMerImg from "@/assets/illustrations/T2A_Coupe_Mer-elargie.webp";
---

<section
  aria-label="Contenu principal de l'accueil"
  class="relative min-h-[200vh] w-full overflow-hidden"
  style="background: linear-gradient(to bottom, var(--bg-primary) 0%, var(--bg-primary) 40%, var(--gradient-end) 100%)"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 flex items-start justify-center overflow-hidden"
  >
    <div
      class="relative mt-0 max-w-none overflow-hidden w-160 opacity-[0.20] sm:w-200 lg:w-350 xl:w-640 dark:opacity-[0.10]"
    >
      <Image
        alt=""
        class="h-auto w-full max-w-none grayscale"
        draggable="false"
        loading="lazy"
        src={topoImg}
      />
      <div aria-hidden="true" class="absolute inset-0 mix-blend-multiply"></div>
    </div>
  </div>

  <div
    aria-hidden="true"
    class="absolute top-0 bottom-0 left-1/2 w-px -translate-x-1/2 bg-(--trait)"
  >
  </div>

  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 bottom-0 flex justify-center overflow-hidden"
  >
    <Image
      alt=""
      class="w-full max-w-none object-cover object-bottom grayscale opacity-[0.7] dark:opacity-[0.5]"
      draggable="false"
      loading="lazy"
      src={coupeMerImg}
    />
  </div>
</section>
