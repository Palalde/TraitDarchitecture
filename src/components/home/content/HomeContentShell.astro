---
import BackgroundDecorations from "@/components/ui/background/BackgroundDecorations.astro";
import SectionArchitecture from "@/components/home/content/sections/SectionArchitecture.astro";
import SectionAtelier from "@/components/home/content/sections/SectionAtelier.astro";
import SectionExtrait from "@/components/home/content/sections/SectionExtrait.astro";
import SectionTrait from "@/components/home/content/sections/SectionTrait.astro";

const sectionFrameClassName =
  "relative min-h-[34rem] sm:min-h-[38rem] lg:min-h-[42rem]";

const extraitSectionFrameClassName =
  "relative min-h-[28rem] sm:min-h-[30rem] lg:min-h-[33rem]";
---

<section
  aria-label="Contenu principal de l'accueil"
  class="relative w-full overflow-hidden bg-(--bg-primary)"
>
  <BackgroundDecorations />

  <div
    class="relative z-10 mx-auto flex w-full max-w-7xl flex-col gap-24 px-6 pt-24 pb-35 sm:gap-28 sm:px-8 sm:pt-28 sm:pb-55 lg:gap-32 lg:px-10 lg:pt-32 lg:pb-55 2xl:pb-70"
  >
    <SectionAtelier className={sectionFrameClassName} />
    <SectionTrait className={sectionFrameClassName} />
    <SectionArchitecture className={sectionFrameClassName} />
    <SectionExtrait className={extraitSectionFrameClassName} />
  </div>
</section>
