---
import { Image } from "astro:assets";
import topoDarkPng from "@/assets/illustrations/T2A_Plan_Topo territoire - DARK.png";
import topoLightPng from "@/assets/illustrations/T2A_Plan_Topo territoire - LIGHT.png";
import coupeMerDarkPng from "@/assets/illustrations/T2A_Coupe_Mer DARK.png";
import coupeMerLightPng from "@/assets/illustrations/T2A_Coupe_Mer LIGHT.png";

interface Props {
  class?: string;
}

const { class: className }: Props = Astro.props;
---

<div
  aria-hidden="true"
  class:list={[
    "pointer-events-none absolute inset-0 overflow-hidden",
    className,
  ]}
>
  <div
    class="absolute inset-0"
    style="background: linear-gradient(to bottom, var(--bg-primary) 0%, var(--bg-primary) 40%, var(--gradient-end) 100%)"
  >
  </div>

  <div class="absolute inset-0 flex items-start justify-center overflow-hidden">
    <div
      class="relative mt-0 max-w-none overflow-hidden w-160 opacity-[0.15] sm:w-200 lg:w-350 xl:w-640 dark:opacity-[0.15]"
    >
      <div class="grid w-full">
        <Image
          alt=""
          class="col-start-1 row-start-1 h-auto w-full max-w-none opacity-100 transition-opacity duration-300 ease-out motion-reduce:transition-none dark:opacity-0"
          decoding="async"
          draggable="false"
          format="webp"
          loading="lazy"
          quality={10}
          widths={[640, 800, 1400, 2560]}
          sizes="(min-width: 1280px) 2560px, (min-width: 1024px) 1400px, (min-width: 640px) 800px, 640px"
          src={topoLightPng}
        />
        <Image
          alt=""
          class="col-start-1 row-start-1 h-auto w-full max-w-none opacity-0 transition-opacity duration-300 ease-out motion-reduce:transition-none dark:opacity-100"
          decoding="async"
          draggable="false"
          format="webp"
          loading="lazy"
          quality={30}
          widths={[640, 800, 1400, 2560]}
          sizes="(min-width: 1280px) 2560px, (min-width: 1024px) 1400px, (min-width: 640px) 800px, 640px"
          src={topoDarkPng}
        />
      </div>
    </div>
  </div>

  <div class="absolute inset-x-0 bottom-0 flex justify-center overflow-hidden">
    <div class="grid w-full">
      <Image
        alt=""
        class="col-start-1 row-start-1 w-full max-w-none object-cover object-bottom opacity-[0.7] transition-opacity duration-300 ease-out motion-reduce:transition-none dark:opacity-0"
        decoding="async"
        draggable="false"
        format="webp"
        loading="lazy"
        quality={60}
        widths={[800, 1280, 1920, 2560]}
        sizes="100vw"
        src={coupeMerLightPng}
      />
      <Image
        alt=""
        class="col-start-1 row-start-1 w-full max-w-none object-cover object-bottom opacity-0 transition-opacity duration-300 ease-out motion-reduce:transition-none dark:opacity-[0.6]"
        decoding="async"
        draggable="false"
        format="webp"
        loading="lazy"
        quality={60}
        widths={[800, 1280, 1920, 2560]}
        sizes="100vw"
        src={coupeMerDarkPng}
      />
    </div>
  </div>
</div>
