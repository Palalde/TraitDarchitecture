---
import { Image } from "astro:assets";
import topoDarkPng from "@/assets/illustrations/T2A_Plan_Topo territoire - DARK.png";
import topoLightPng from "@/assets/illustrations/T2A_Plan_Topo territoire - LIGHT.png";
import coupeMerDarkPng from "@/assets/illustrations/T2A_Coupe_Mer DARK.png";
import coupeMerLightPng from "@/assets/illustrations/T2A_Coupe_Mer LIGHT.png";

interface Props {
  class?: string;
}

const { class: className }: Props = Astro.props;

// Theme is driven by [data-theme] (the `dark:` variant), not media queries:
// both light and dark sets are rendered and toggled via opacity. Desktop vs
// mobile stays a real responsive concern handled by widths + sizes.
const topoSizes = "(min-width: 1024px) 1350px, 100vw";
const topoWidths = [320, 480, 640, 960, 1350];
const coupeMerSizes = "(min-width: 1600px) 1600px, 100vw";
const coupeMerWidths = [480, 640, 960, 1280, 1600];
---

<div
  aria-hidden="true"
  class:list={[
    "pointer-events-none absolute inset-0 overflow-hidden",
    className,
  ]}
>
  <div
    class="absolute inset-0"
    style="background: linear-gradient(to bottom, var(--bg-primary) 0%, var(--bg-primary) 40%, var(--gradient-end) 100%)"
  >
  </div>

  <div class="absolute inset-0 flex items-start justify-center overflow-hidden">
    <div
      class="relative mt-0 max-w-none overflow-hidden w-160 opacity-[0.15] sm:w-200 lg:w-350 xl:w-640 dark:opacity-[0.15]"
    >
      <div class="grid w-full">
        <Image
          alt=""
          class="col-start-1 row-start-1 h-auto w-full max-w-none opacity-100 dark:opacity-0"
          draggable={false}
          fetchpriority="low"
          format="webp"
          loading="eager"
          quality={2}
          sizes={topoSizes}
          src={topoLightPng}
          widths={topoWidths}
        />
        <Image
          alt=""
          class="col-start-1 row-start-1 h-auto w-full max-w-none opacity-0 dark:opacity-100"
          draggable={false}
          fetchpriority="low"
          format="webp"
          loading="lazy"
          quality={2}
          sizes={topoSizes}
          src={topoDarkPng}
          widths={topoWidths}
        />
      </div>
    </div>
  </div>

  <div class="absolute inset-x-0 bottom-0 flex justify-center overflow-hidden">
    <div class="grid w-full">
      <Image
        alt=""
        class="col-start-1 row-start-1 w-full max-w-none object-cover object-bottom opacity-[0.7] dark:opacity-0"
        draggable={false}
        format="webp"
        loading="lazy"
        quality={42}
        sizes={coupeMerSizes}
        src={coupeMerLightPng}
        widths={coupeMerWidths}
      />
      <Image
        alt=""
        class="col-start-1 row-start-1 w-full max-w-none object-cover object-bottom opacity-0 dark:opacity-[0.6]"
        draggable={false}
        format="webp"
        loading="lazy"
        quality={42}
        sizes={coupeMerSizes}
        src={coupeMerDarkPng}
        widths={coupeMerWidths}
      />
    </div>
  </div>
</div>
