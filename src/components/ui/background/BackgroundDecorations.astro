---
import { Image } from "astro:assets";
import topoImg from "@/assets/illustrations/T2A_Plan_Topo_territoire.webp";
import coupeMerDarkPng from "@/assets/illustrations/T2A_Coupe_Mer DARK.png";
import coupeMerLightPng from "@/assets/illustrations/T2A_Coupe_Mer LIGHT.png";

interface Props {
  class?: string;
}

const { class: className }: Props = Astro.props;
---

<div
  aria-hidden="true"
  class:list={[
    "pointer-events-none absolute inset-0 overflow-hidden",
    className,
  ]}
>
  <div
    class="absolute inset-0"
    style="background: linear-gradient(to bottom, var(--bg-primary) 0%, var(--bg-primary) 40%, var(--gradient-end) 100%)"
  >
  </div>

  <div class="absolute inset-0 flex items-start justify-center overflow-hidden">
    <div
      class="relative mt-0 max-w-none overflow-hidden w-160 opacity-[0.20] sm:w-200 lg:w-350 xl:w-640 dark:opacity-[0.10]"
    >
      <Image
        alt=""
        class="h-auto w-full max-w-none grayscale"
        draggable="false"
        loading="lazy"
        src={topoImg}
      />
      <div aria-hidden="true" class="absolute inset-0 mix-blend-multiply"></div>
    </div>
  </div>

  <div class="absolute inset-x-0 bottom-0 flex justify-center overflow-hidden">
    <div class="grid w-full">
      <Image
        alt=""
        class="col-start-1 row-start-1 w-full max-w-none object-cover object-bottom opacity-[0.7] transition-opacity duration-300 ease-out motion-reduce:transition-none dark:opacity-0"
        decoding="async"
        draggable="false"
        format="webp"
        loading="lazy"
        quality="high"
        src={coupeMerLightPng}
      />
      <Image
        alt=""
        class="col-start-1 row-start-1 w-full max-w-none object-cover object-bottom opacity-0 transition-opacity duration-300 ease-out motion-reduce:transition-none dark:opacity-[0.6]"
        decoding="async"
        draggable="false"
        format="webp"
        loading="lazy"
        quality="high"
        src={coupeMerDarkPng}
      />
    </div>
  </div>
</div>
