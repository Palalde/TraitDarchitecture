---
import FacebookLogo from "../social/logo/FacebookLogo.astro";
import InstagramLogo from "../social/logo/InstagramLogo.astro";
import LinkedInLogo from "../social/logo/LinkedInLogo.astro";
import FooterOffice from "./FooterOffice.astro";
import T2ALogoLineLeft from "./logo/T2ALogoLineLeft.astro";
import T2ANordLogo from "./logo/T2ANordLogo.astro";

const FOOTER_OFFICES = [
  {
    city: "CORSE",
    addressLines: ["29 rue Chanoine Letteron", "20200 Bastia"],
  },
  {
    city: "CÔTE BLEUE",
    addressLines: ["10 allée des églantiers", "13960 Sausset-les-Pins"],
  },
  {
    city: "PROVENCE",
    addressLines: ["22 rue des Fenils", "04270 Mézel"],
  },
] as const;

const footerLinkClassName =
  "font-medium underline decoration-current/35 underline-offset-4 transition-[color,text-decoration-color] hover:text-(--t2a-blue-light) hover:decoration-current";

const footerMetaLinkClassName =
  "font-medium underline decoration-current/35 underline-offset-4 text-(--t2a-blue-dark) transition-[color,text-decoration-color] hover:text-(--text-primary) hover:decoration-current dark:text-(--t2a-blue) dark:hover:text-(--t2a-blue-light)";

const currentYear = new Date().getFullYear();
---

<footer
  id="site-footer"
  aria-label="Pied de page"
  class="relative w-full overflow-hidden bg-transparent"
  style="margin-top: calc(var(--footer-root-overlap) * -1)"
>
  <div
    aria-hidden="true"
    class="absolute inset-x-0 bottom-0 bg-(--gradient-end)"
    style="top: var(--footer-root-overlap)"
  >
  </div>

  <div
    class="pointer-events-none absolute top-0 -left-15 z-10 flex h-(--footer-logo-height) items-start sm:-left-20 md:-left-38 2xl:-left-100"
    style="top: var(--footer-logo-top-offset)"
  >
    <T2ALogoLineLeft
      class="h-full w-auto max-w-none shrink-0 text-(--trait)"
      style="transform: scale(var(--footer-logo-scale)); transform-origin: left 89.12%;"
    />
  </div>

  <div
    class="relative z-20 px-6 sm:px-8 lg:px-10"
    style="padding-top: var(--footer-content-start)"
  >
    <div class="mx-auto w-full max-w-3xl md:max-w-4xl">
      <div class="grid grid-cols-1 sm:grid-cols-3">
        {
          FOOTER_OFFICES.map((office, index) => (
            <div
              class:list={[
                "px-5 py-5 md:px-8",
                index > 0 &&
                  "border-t border-(--trait) sm:border-t-0 sm:border-l",
              ]}
            >
              <FooterOffice
                addressLines={office.addressLines}
                city={office.city}
              />
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div
    aria-hidden="true"
    class="pointer-events-none relative z-10 mt-6 flex w-full select-none items-baseline justify-center px-4 md:mt-10"
  >
    <div
      class="absolute left-1/2 top-1/2 z-0 w-(--footer-nord-width)"
      style="margin-top: var(--footer-nord-offset-y); transform: translate(calc(-50% + var(--footer-nord-offset-x)), -50%);"
    >
      <T2ANordLogo
        class="h-auto w-full text-(--t2a-blue-dark) opacity-(--footer-nord-opacity) dark:text-(--t2a-blue)"
      />
    </div>
    <p
      class="relative z-10 w-full text-center font-normal leading-none tracking-[0.12em] text-(--t2a-blue-dark) opacity-50"
      style="font-size: clamp(2.75rem, 7.5vw, 7.5rem)"
    >
      ATELIER <span class="font-semibold" style="font-size: 1.15em">TraiT</span>
      D'ARCHITECTURE
    </p>
  </div>

  <div
    class="relative z-20 mx-auto grid w-full max-w-3xl grid-cols-1 gap-6 px-6 py-6 text-center text-[0.8rem] leading-relaxed text-(--t2a-blue-dark) dark:text-(--t2a-blue) sm:grid-cols-3 sm:items-start sm:gap-4 sm:px-8 sm:text-left md:max-w-4xl lg:px-10"
  >
    <div class="space-y-2 sm:text-left">
      <p class="font-light">Architecture sensible, contextuelle et engagée.</p>
      <div
        class="flex items-center justify-center gap-2 text-(--t2a-blue-dark) dark:text-(--t2a-blue-light) sm:justify-start"
      >
        <span class="text-[0.72rem] uppercase tracking-[0.12em]"
          >Suivez-nous</span
        >
        <a
          aria-label="Instagram de l'atelier"
          href="https://www.instagram.com/atelier.trait.darchitecture/"
          target="_blank"
          rel="noreferrer"
          class="inline-flex h-7 w-7 items-center justify-center transition-[color,transform] hover:scale-110 hover:text-(--t2a-blue)"
        >
          <InstagramLogo class="h-4.5 w-4.5" />
        </a>
        <a
          aria-label="Facebook de l'atelier"
          href="https://www.facebook.com/profile.php?id=61578637113872#"
          target="_blank"
          rel="noreferrer"
          class="inline-flex h-7 w-7 items-center justify-center transition-[color,transform] hover:scale-110 hover:text-(--t2a-blue)"
        >
          <FacebookLogo class="h-4.5 w-4.5" />
        </a>
        <a
          aria-label="LinkedIn de l'atelier"
          href="https://www.linkedin.com/company/atelier-trait-d-architecture/"
          target="_blank"
          rel="noreferrer"
          class="inline-flex h-7 w-7 items-center justify-center transition-[color,transform] hover:scale-110 hover:text-(--t2a-blue)"
        >
          <LinkedInLogo class="h-4.5 w-4.5" />
        </a>
      </div>
    </div>

    <div class="space-y-1 sm:text-center">
      <p>
        <a href="tel:+33672310421" class={footerLinkClassName}>
          Titouan +33.6.72.31.04.21
        </a>
      </p>
      <p>
        <a href="tel:+33630589981" class={footerLinkClassName}>
          Théa +33.6.30.58.99.81
        </a>
      </p>
      <p>
        <a
          href="mailto:atelier@traitdarchitecture.com"
          class={footerLinkClassName}
        >
          atelier[at]traitdarchitecture.com
        </a>
      </p>
      <p>Lundi à vendredi : 9h-18h</p>
    </div>

    <div class="space-y-2 sm:text-right">
      <p>© {currentYear} ATELIER TraiT D'ARCHITECTURE</p>
      <p class="space-x-2">
        <a href="/mentions-legales" class={footerMetaLinkClassName}>
          Mentions légales
        </a>
        <span aria-hidden="true">·</span>
        <span>Site réalisé par:</span>
        <a
          href="https://www.linkedin.com/in/paul-alessandrini"
          target="_blank"
          rel="noreferrer"
          class={footerMetaLinkClassName}
        >
          Paul Alessandrini
        </a>
      </p>
    </div>
  </div>
</footer>
