---
interface Props {
  class?: string;
  [key: string]: unknown;
}

const { class: className, ...rest }: Props = Astro.props;
---

<div
  {...rest}
  class:list={[
    "prose-body max-w-4xl text-prose text-(--text-primary)",
    className,
  ]}
>
  <slot />
</div>

<style>
  .prose-body :global(p:not([data-lead])) {
    max-width: var(--reading-measure);
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }

  .prose-body :global(strong) {
    font-weight: 600;
    color: inherit;
  }

  /* Section labels keep the T2A identity font, whatever the reading font is. */
  .prose-body :global(:is(h2, h3)) {
    max-width: var(--reading-measure);
    margin-top: 2.5rem;
    margin-bottom: 0.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .prose-body :global(:is(ul, ol)) {
    max-width: var(--reading-measure);
    margin-bottom: 1.5rem;
    padding-left: 1.25rem;
  }

  .prose-body :global(li) {
    margin-bottom: 0.375rem;
  }

  .prose-body :global(blockquote:not([data-pullquote])) {
    max-width: var(--reading-measure);
    margin: 2rem 0;
    padding: 0.25rem 0 0.25rem 1.25rem;
    border-left: 1px solid var(--border);
    color: var(--text-secondary);
  }

  .prose-body :global(blockquote:not([data-pullquote]) p) {
    margin-bottom: 1rem;
    color: inherit;
    font-size: calc(var(--reading-prose-size) * 15 / 17);
  }

  .prose-body
    :global(blockquote:not([data-pullquote]) :is(p, ul, ol):last-child) {
    margin-bottom: 0;
  }

  .prose-body :global(blockquote:not([data-pullquote]) :is(ul, ol)) {
    margin-bottom: 1rem;
  }

  .prose-body :global(:is([data-pullquote], [data-lead]) p) {
    max-width: none;
    margin-bottom: 0;
    color: inherit;
    font-size: inherit;
  }
</style>
