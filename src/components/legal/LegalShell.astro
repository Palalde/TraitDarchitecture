---
import LegalHero from "@/components/legal/blocks/LegalHero.astro";
import LegalSectionBlock from "@/components/legal/blocks/LegalSection.astro";
import { legalPageData } from "@/components/legal/legal.data";
---

<section
  class="relative z-10 pb-[calc(var(--footer-root-overlap)+7rem)] sm:pb-[calc(var(--footer-root-overlap)+12rem)] lg:pb-[calc(var(--footer-root-overlap)+18rem)] 2xl:pb-[calc(var(--footer-root-overlap)+30rem)]"
>
  <div class="mx-auto w-full max-w-3xl px-6 sm:px-8 lg:px-10">
    <LegalHero
      heading={legalPageData.heading}
      intro={legalPageData.intro}
      updatedAt={legalPageData.updatedAt}
    />

    <div data-legal-body class="mt-12 sm:mt-14 lg:mt-16">
      <script is:inline data-astro-rerun>
        (() => {
          const revealSystem = window.__t2aReveal;
          if (!revealSystem) return;

          revealSystem
            .createController({
              id: "legal-body",
              pathname: "/mentions-legales",
              rootSelector: "[data-legal-body]",
            })
            ?.startAfterPageTransition(revealSystem.getResponsiveDelay());
        })();
      </script>

      {
        legalPageData.sections.map((section, index) => (
          <LegalSectionBlock
            email={legalPageData.email}
            first={index === 0}
            revealIndex={index}
            section={section}
          />
        ))
      }
    </div>
  </div>
</section>
