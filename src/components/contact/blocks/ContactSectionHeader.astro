---
interface Props {
  figureId: string;
  headingId: string;
  title: string;
}

const { figureId, headingId, title }: Props = Astro.props;
---

<div class="flex items-center gap-3 sm:gap-5">
  <span
    class="shrink-0 text-[0.68rem] uppercase tracking-[0.16em] text-(--t2a-blue-dark) dark:text-(--text-muted) sm:text-[0.72rem]"
    data-reveal="fade-up"
  >
    {figureId}
  </span>
  <div
    aria-hidden="true"
    class="h-px w-10 bg-(--trait) [--reveal-d:560ms] sm:w-14"
    data-reveal="bar-from-right"
  >
  </div>
  <h2
    id={headingId}
    class="shrink-0 text-[0.82rem] font-semibold uppercase tracking-[0.16em] text-(--t2a-blue-dark) [--reveal-delay:60ms] dark:text-(--t2a-blue) sm:text-[0.9rem]"
    data-reveal="fade-up"
  >
    {title}
  </h2>
  <div
    aria-hidden="true"
    class="h-px min-w-0 flex-1 bg-(--trait) [--reveal-d:560ms] [--reveal-delay:60ms]"
    data-reveal="bar-from-left"
  >
  </div>
</div>
