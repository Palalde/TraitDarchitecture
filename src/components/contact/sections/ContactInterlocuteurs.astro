---
import type { ContactPageData } from "@/components/contact/contact.data";
import CotationFrame from "@/components/ui/cotation/CotationFrame.astro";

interface Props {
  email: ContactPageData["email"];
  interlocutors: ContactPageData["interlocutors"];
  officeHours: ContactPageData["officeHours"];
  offices: ContactPageData["offices"];
}

const { email, interlocutors, officeHours, offices }: Props = Astro.props;
type ContactInterlocutor = ContactPageData["interlocutors"][number];
type ContactOffice = ContactPageData["offices"][number];
---

<section
  aria-labelledby="contact-interlocutors-title"
  class="relative z-10 mx-auto flex w-full max-w-7xl flex-col gap-8 px-6 sm:px-8 lg:gap-10 lg:px-10"
>
  <div class="flex items-center gap-3 sm:gap-5">
    <span
      class="shrink-0 text-[0.68rem] uppercase tracking-[0.16em] text-(--t2a-blue-dark) dark:text-(--text-muted) sm:text-[0.72rem]"
    >
      Fig. I
    </span>
    <div aria-hidden="true" class="h-px w-10 bg-(--trait) sm:w-14"></div>
    <h2
      id="contact-interlocutors-title"
      class="shrink-0 text-[0.82rem] font-semibold uppercase tracking-[0.16em] text-(--t2a-blue-dark) dark:text-(--t2a-blue) sm:text-[0.9rem]"
    >
      Interlocuteurs & ateliers
    </h2>
    <div aria-hidden="true" class="h-px min-w-0 flex-1 bg-(--trait)"></div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-10">
    {
      interlocutors.map((interlocutor: ContactInterlocutor) => (
        <a
          aria-label={`Appeler ${interlocutor.name} au ${interlocutor.phoneDisplay}`}
          class="group block transition-colors duration-200 hover:bg-(--t2a-blue-wash) focus-visible:outline-2 focus-visible:outline-(--t2a-blue) active:bg-(--t2a-blue-wash) dark:hover:bg-(--t2a-blue-pale)/30 dark:active:bg-(--t2a-blue-pale)/30"
          href={interlocutor.phoneHref}
        >
          <CotationFrame
            contentClassName="p-6 lg:p-8"
            contentStyle="background: transparent;"
            orientation="vertical"
            revealCotation={false}
          >
            <div class="flex min-h-32 flex-col justify-between gap-8">
              <div class="flex flex-col gap-2">
                <h3 class="text-[1rem] font-semibold uppercase tracking-[0.14em] text-(--text-primary) sm:text-[1.05rem]">
                  {interlocutor.name}
                </h3>
                <p class="text-[0.78rem] uppercase tracking-[0.14em] text-(--t2a-blue-dark) dark:text-(--text-muted)">
                  {interlocutor.role}
                </p>
              </div>

              <p class="inline-flex items-center gap-3 text-[1rem] text-(--t2a-blue-dark) dark:text-(--t2a-blue)">
                <span>{interlocutor.phoneDisplay}</span>
                <span
                  aria-hidden="true"
                  class="inline-block transition-transform duration-200 group-hover:translate-x-1"
                >
                  →
                </span>
              </p>
            </div>
          </CotationFrame>
        </a>
      ))
    }
  </div>

  <div
    class="grid grid-cols-1 items-center gap-4 text-center md:grid-cols-2 md:gap-6 md:text-left lg:gap-10"
  >
    <a
      class="inline-flex max-w-full flex-col items-center justify-center gap-1 px-2 py-3 text-center text-[0.72rem] uppercase tracking-[0.08em] text-(--t2a-blue-dark) transition-colors duration-200 hover:text-(--text-primary) focus-visible:outline-2 focus-visible:outline-(--t2a-blue) dark:text-(--text-muted) sm:flex-row sm:gap-3 sm:text-[0.82rem] sm:tracking-[0.14em] md:justify-start md:text-left"
      href={email.href}
    >
      <span class="max-w-full break-all sm:break-normal">{email.display}</span>
      <span aria-hidden="true" class="hidden sm:inline">→</span>
      <span class="inline-flex items-center gap-2 whitespace-nowrap">
        <span aria-hidden="true" class="sm:hidden">→</span>
        <span>écrire un mail</span>
      </span>
    </a>

    <p
      aria-label={`${officeHours.label} : ${officeHours.value}`}
      class="px-2 py-3 text-[0.78rem] uppercase tracking-[0.14em] text-(--t2a-blue-dark) dark:text-(--text-muted) md:justify-self-end md:text-right"
    >
      <span>{officeHours.label}</span>
      <span aria-hidden="true" class="mx-2">—</span>
      <span>{officeHours.value}</span>
    </p>
  </div>

  <div
    aria-label="Ateliers de l'ATELIER TraiT D'ARCHITECTURE"
    class="grid grid-cols-1 sm:grid-cols-3"
  >
    {
      offices.map((office: ContactOffice, index: number) => (
        <section
          aria-label={`Atelier ${office.city}`}
          class:list={[
            "px-4 py-5 text-center sm:px-5 lg:px-8",
            index > 0 && "border-t border-(--trait) sm:border-t-0 sm:border-l",
          ]}
        >
          <h3 class="text-[0.78rem] font-semibold uppercase tracking-[0.18em] text-(--t2a-blue-dark) dark:text-(--t2a-blue)">
            {office.city}
          </h3>
          <address class="mt-3 space-y-1 text-[0.95rem] leading-7 not-italic text-(--t2a-blue-dark) dark:text-(--t2a-blue)">
            {office.addressLines.map((line: string) => (
              <p>{line}</p>
            ))}
          </address>
        </section>
      ))
    }
  </div>
</section>
