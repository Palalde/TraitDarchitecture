---
import type { ContactPageData } from "@/components/contact/contact.data";
import CotationFrame from "@/components/ui/cotation/CotationFrame.astro";

interface Props {
  email: ContactPageData["email"];
  interlocutors: ContactPageData["interlocutors"];
}

const { email, interlocutors }: Props = Astro.props;
type ContactInterlocutor = ContactPageData["interlocutors"][number];
---

<section
  aria-labelledby="contact-interlocutors-title"
  class="relative z-10 mx-auto flex w-full max-w-7xl flex-col gap-8 px-6 sm:px-8 lg:gap-10 lg:px-10"
>
  <div class="flex items-center gap-3 sm:gap-5">
    <span
      class="shrink-0 text-[0.68rem] uppercase tracking-[0.16em] text-(--text-muted) sm:text-[0.72rem]"
    >
      Fig. I
    </span>
    <div aria-hidden="true" class="h-px w-10 bg-(--trait) sm:w-14"></div>
    <h2
      id="contact-interlocutors-title"
      class="shrink-0 text-[0.82rem] font-semibold uppercase tracking-[0.16em] text-(--t2a-blue-dark) dark:text-(--t2a-blue) sm:text-[0.9rem]"
    >
      Interlocuteurs
    </h2>
    <div aria-hidden="true" class="h-px min-w-0 flex-1 bg-(--trait)"></div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-10">
    {
      interlocutors.map((interlocutor: ContactInterlocutor) => (
        <a
          aria-label={`Appeler ${interlocutor.name} au ${interlocutor.phoneDisplay}`}
          class="group block transition-colors duration-200 hover:bg-(--t2a-blue-wash) focus-visible:outline-2 focus-visible:outline-(--t2a-blue) active:bg-(--t2a-blue-wash) dark:hover:bg-(--t2a-blue-pale)/30 dark:active:bg-(--t2a-blue-pale)/30"
          href={interlocutor.phoneHref}
        >
          <CotationFrame
            contentClassName="p-6 lg:p-8"
            contentStyle="background: transparent;"
            orientation="vertical"
            revealCotation={false}
          >
            <div class="flex min-h-32 flex-col justify-between gap-8">
              <div class="flex flex-col gap-2">
                <h3 class="text-[1rem] font-semibold uppercase tracking-[0.14em] text-(--text-primary) sm:text-[1.05rem]">
                  {interlocutor.name}
                </h3>
                <p class="text-[0.78rem] uppercase tracking-[0.14em] text-(--text-muted)">
                  {interlocutor.role}
                </p>
              </div>

              <p class="inline-flex items-center gap-3 text-[1rem] text-(--t2a-blue-dark) dark:text-(--t2a-blue)">
                <span>{interlocutor.phoneDisplay}</span>
                <span
                  aria-hidden="true"
                  class="inline-block transition-transform duration-200 group-hover:translate-x-1"
                >
                  →
                </span>
              </p>
            </div>
          </CotationFrame>
        </a>
      ))
    }
  </div>

  <div class="text-center">
    <a
      class="inline-flex items-center justify-center gap-3 px-2 py-3 text-[0.82rem] uppercase tracking-[0.14em] text-(--text-muted) transition-colors duration-200 hover:text-(--text-primary) focus-visible:outline-2 focus-visible:outline-(--t2a-blue)"
      href={email.href}
    >
      <span>{email.display}</span>
      <span aria-hidden="true">→</span>
      <span>écrire un mail</span>
    </a>
  </div>
</section>
