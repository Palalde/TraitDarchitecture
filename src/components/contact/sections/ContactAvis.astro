---
import type { ContactPageData } from "@/components/contact/contact.data";
import ContactSectionHeader from "@/components/contact/blocks/ContactSectionHeader.astro";
import CotationFrame from "@/components/ui/cotation/CotationFrame.astro";

interface Props {
  className?: string;
  googleReviewsUrl: ContactPageData["googleReviewsUrl"];
  reviews: ContactPageData["reviews"];
}

const { className, googleReviewsUrl, reviews }: Props = Astro.props;
type ContactReview = ContactPageData["reviews"][number];

const createRatingTraits = (rating: number) =>
  Array.from({ length: Math.min(Math.max(rating, 0), 5) });
---

<section
  aria-labelledby="contact-reviews-title"
  class:list={[
    "relative z-10 mx-auto flex w-full max-w-7xl flex-col gap-8 px-6 sm:px-8 lg:gap-10 lg:px-10",
    className,
  ]}
>
  <ContactSectionHeader
    figureId="Fig. III"
    headingId="contact-reviews-title"
    title="Ce qu'ils en disent"
  />

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-10">
    {
      reviews.map((review: ContactReview, reviewIndex: number) => (
        <div
          class="h-full"
          style={`--reveal-delay:${100 + reviewIndex * 80}ms;`}
        >
          <CotationFrame
            className="h-full"
            contentClassName="flex h-full flex-col gap-5 p-6"
            contentStyle="background: transparent;"
            orientation="vertical"
            revealBorder
            revealCotation
          >
            <article class="flex h-full flex-col gap-5">
              <div class="flex flex-col gap-3">
                <div class="flex flex-col gap-1.5">
                  <h3
                    class="text-[0.9rem] font-semibold uppercase tracking-[0.14em] text-(--text-primary)"
                    data-reveal="fade-up"
                    style={`--reveal-delay:${180 + reviewIndex * 80}ms;`}
                  >
                    {review.author}
                  </h3>
                  {googleReviewsUrl && googleReviewsUrl.length > 0 ? (
                    <a
                      aria-label="Lire les avis de l'atelier sur Google (nouvel onglet)"
                      class="inline-flex w-fit items-center py-1 text-[0.64rem] uppercase tracking-[0.18em] text-(--text-muted) underline decoration-current/35 underline-offset-4 transition-colors duration-200 hover:text-(--t2a-blue-dark) hover:decoration-current focus-visible:outline-2 focus-visible:outline-(--t2a-blue) dark:hover:text-(--t2a-blue)"
                      data-reveal="fade-up"
                      href={googleReviewsUrl}
                      rel="noopener noreferrer"
                      style={`--reveal-delay:${205 + reviewIndex * 80}ms;`}
                      target="_blank"
                    >
                      Avis de Google
                    </a>
                  ) : (
                    <p
                      class="text-[0.64rem] uppercase tracking-[0.18em] text-(--text-muted)"
                      data-reveal="fade-up"
                      style={`--reveal-delay:${205 + reviewIndex * 80}ms;`}
                    >
                      Avis de Google
                    </p>
                  )}
                </div>
                <span
                  aria-label={`Avis de Google de ${review.author}, note ${review.rating} sur 5`}
                  class="flex gap-1.5"
                >
                  {createRatingTraits(review.rating).map(
                    (_, traitIndex: number) => (
                      <span
                        aria-hidden="true"
                        class="inline-block h-4 w-0.75 bg-(--t2a-blue) [--reveal-d:360ms]"
                        data-reveal="bar-from-top"
                        style={`--reveal-delay:${230 + reviewIndex * 80 + traitIndex * 25}ms;`}
                      />
                    ),
                  )}
                </span>
              </div>

              <p
                class="text-[0.95rem] leading-7 font-light text-(--text-secondary) italic dark:text-(--text-muted)"
                data-reveal="fade-up"
                style={`--reveal-delay:${340 + reviewIndex * 80}ms;`}
              >
                {review.text}
              </p>
            </article>
          </CotationFrame>
        </div>
      ))
    }
  </div>

  {
    googleReviewsUrl && googleReviewsUrl.length > 0 && (
      <div
        class="text-center"
        data-reveal="fade-up"
        style="--reveal-delay:600ms;"
      >
        <a
          aria-label="Lire tous les avis de l'atelier sur Google (nouvel onglet)"
          class="inline-block px-2 py-3 text-[0.82rem] uppercase tracking-[0.16em] text-(--t2a-blue-dark) underline decoration-current/35 underline-offset-4 transition-colors duration-200 hover:text-(--t2a-blue) hover:decoration-current focus-visible:outline-2 focus-visible:outline-(--t2a-blue) dark:text-(--t2a-blue) dark:hover:text-(--t2a-blue-light)"
          href={googleReviewsUrl}
          rel="noopener noreferrer"
          target="_blank"
        >
          Lire les avis sur Google
        </a>
      </div>
    )
  }
</section>
