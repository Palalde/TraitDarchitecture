---
import type { ContactPageData } from "@/components/contact/contact.data";
import CotationFrame from "@/components/ui/cotation/CotationFrame.astro";

interface Props {
  className?: string;
  googleReviewsUrl: ContactPageData["googleReviewsUrl"];
  reviews: ContactPageData["reviews"];
}

const { className, googleReviewsUrl, reviews }: Props = Astro.props;
type ContactReview = ContactPageData["reviews"][number];

const createRatingTraits = (rating: number) =>
  Array.from({ length: Math.min(Math.max(rating, 0), 5) });
---

<section
  aria-labelledby="contact-reviews-title"
  class:list={[
    "relative z-10 mx-auto flex w-full max-w-7xl flex-col gap-8 px-6 sm:px-8 lg:gap-10 lg:px-10",
    className,
  ]}
>
  <div class="flex items-center gap-3 sm:gap-5">
    <span
      class="shrink-0 text-[0.68rem] uppercase tracking-[0.16em] text-(--t2a-blue-dark) dark:text-(--text-muted) sm:text-[0.72rem]"
    >
      Fig. III
    </span>
    <div aria-hidden="true" class="h-px w-10 bg-(--trait) sm:w-14"></div>
    <h2
      id="contact-reviews-title"
      class="shrink-0 text-[0.82rem] font-semibold uppercase tracking-[0.16em] text-(--t2a-blue-dark) dark:text-(--t2a-blue) sm:text-[0.9rem]"
    >
      Ce qu'ils en disent
    </h2>
    <div aria-hidden="true" class="h-px min-w-0 flex-1 bg-(--trait)"></div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-10">
    {
      reviews.map((review: ContactReview) => (
        <CotationFrame
          className="h-full"
          contentClassName="flex h-full flex-col gap-5 p-6"
          contentStyle="background: transparent;"
          orientation="vertical"
          revealCotation={false}
        >
          <article class="flex h-full flex-col gap-5">
            <div class="flex flex-col gap-3">
              <h3 class="text-[0.9rem] font-semibold uppercase tracking-[0.14em] text-(--text-primary)">
                {review.author}
              </h3>
              <span
                aria-label={`Note ${review.rating} sur 5`}
                class="flex gap-1.5"
              >
                {createRatingTraits(review.rating).map(() => (
                  <span
                    aria-hidden="true"
                    class="inline-block h-4 w-0.75 bg-(--t2a-blue)"
                  />
                ))}
              </span>
            </div>

            <p class="text-[0.95rem] leading-7 font-light text-(--text-secondary) italic dark:text-(--text-muted)">
              {review.text}
            </p>
          </article>
        </CotationFrame>
      ))
    }
  </div>

  {
    googleReviewsUrl && googleReviewsUrl.length > 0 && (
      <div class="text-center">
        <a
          aria-label="Lire tous les avis de l'atelier sur Google (nouvel onglet)"
          class="inline-block px-2 py-3 text-[0.82rem] uppercase tracking-[0.16em] text-(--t2a-blue-dark) transition-colors duration-200 hover:underline focus-visible:outline-2 focus-visible:outline-(--t2a-blue) dark:text-(--t2a-blue)"
          href={googleReviewsUrl}
          rel="noopener noreferrer"
          target="_blank"
        >
          Lire les avis sur Google →
        </a>
      </div>
    )
  }
</section>
