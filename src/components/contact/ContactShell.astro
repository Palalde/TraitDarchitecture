---
import { contactPageData } from "@/components/contact/contact.data";
import ContactAvis from "@/components/contact/sections/ContactAvis.astro";
import ContactCartouche from "@/components/contact/sections/ContactCartouche.astro";
import ContactForm from "@/components/contact/sections/ContactForm.astro";
import ContactInterlocuteurs from "@/components/contact/sections/ContactInterlocuteurs.astro";
---

<section data-contact-shell aria-labelledby="contact-page-title">
  <ContactCartouche cartouche={contactPageData.cartouche} />

  <ContactInterlocuteurs
    email={contactPageData.email}
    interlocutors={contactPageData.interlocutors}
    officeHours={contactPageData.officeHours}
    offices={contactPageData.offices}
  />

  <ContactForm
    email={contactPageData.email}
    form={contactPageData.form}
    className="mt-12 lg:mt-16"
  />

  <ContactAvis
    className="mt-16 pb-[calc(var(--footer-root-overlap)+7rem)] sm:pb-[calc(var(--footer-root-overlap)+12rem)] lg:pb-[calc(var(--footer-root-overlap)+18rem)] 2xl:pb-[calc(var(--footer-root-overlap)+30rem)]"
    googleReviewsUrl={contactPageData.googleReviewsUrl}
    reviews={contactPageData.reviews}
  />
</section>
