---
import type { CollectionEntry } from "astro:content";
import ArticleRow from "@/components/extrait/blocks/ArticleRow.astro";

interface Props {
  articles: CollectionEntry<"articles">[];
}

const { articles }: Props = Astro.props;
---

<ol
  class="mx-auto w-full max-w-7xl px-6 pb-28 sm:px-8 sm:pb-36 lg:px-10 lg:pb-44"
>
  {
    articles.map((article, index) => (
      <ArticleRow article={article} index={index} />
    ))
  }
</ol>
