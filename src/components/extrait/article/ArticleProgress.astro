<script is:inline data-astro-rerun>
  (() => {
    const CLEANUP_KEY = "__t2aArticleProgressCleanup";
    const BAR_SELECTOR = "[data-article-progress-bar]";
    const OS_VIEWPORT_SELECTOR = "[data-overlayscrollbars-viewport]";

    const previousCleanup = window[CLEANUP_KEY];
    if (typeof previousCleanup === "function") {
      previousCleanup();
    }

    const bar = document.querySelector(BAR_SELECTOR);
    if (!bar) return;

    const clamp = (value) => Math.min(1, Math.max(0, value));

    let rafId = null;
    // On desktop OverlayScrollbars owns the scroll on its own viewport, so
    // `window.scrollY` stays 0 and `window`'s scroll event never fires. Read
    // from the OS viewport when present, else fall back to native scrolling.
    let osViewport = document.querySelector(OS_VIEWPORT_SELECTOR);
    let observer = null;

    const getMetrics = () => {
      if (osViewport) {
        return {
          scrollTop: osViewport.scrollTop,
          maxScroll: osViewport.scrollHeight - osViewport.clientHeight,
        };
      }

      const doc = document.documentElement;
      return {
        scrollTop: window.scrollY,
        maxScroll: doc.scrollHeight - window.innerHeight,
      };
    };

    const setProgress = () => {
      const { scrollTop, maxScroll } = getMetrics();
      const progress = maxScroll > 0 ? clamp(scrollTop / maxScroll) : 0;
      bar.style.transform = `scaleX(${progress})`;
    };

    const update = () => {
      rafId = null;
      setProgress();
    };

    const scheduleUpdate = () => {
      if (rafId !== null) return;
      rafId = window.requestAnimationFrame(update);
    };

    const cleanup = () => {
      if (rafId !== null) {
        window.cancelAnimationFrame(rafId);
        rafId = null;
      }

      window.removeEventListener("scroll", scheduleUpdate);
      window.removeEventListener("resize", scheduleUpdate);
      osViewport?.removeEventListener("scroll", scheduleUpdate);
      observer?.disconnect();
      observer = null;
      document.removeEventListener("astro:page-load", scheduleUpdate);
      document.removeEventListener("astro:before-swap", cleanup);
      window[CLEANUP_KEY] = undefined;
    };

    window[CLEANUP_KEY] = cleanup;

    window.addEventListener("scroll", scheduleUpdate, { passive: true });
    window.addEventListener("resize", scheduleUpdate, { passive: true });
    document.addEventListener("astro:page-load", scheduleUpdate);
    document.addEventListener("astro:before-swap", cleanup);

    if (osViewport) {
      osViewport.addEventListener("scroll", scheduleUpdate, { passive: true });
    } else {
      // OverlayScrollbars hydrates client:idle → its viewport can appear after
      // this script runs. Bind to it the moment it is inserted (mirrors
      // useParallaxScroll's late-init fallback).
      observer = new MutationObserver(() => {
        const vp = document.querySelector(OS_VIEWPORT_SELECTOR);
        if (vp) {
          observer?.disconnect();
          observer = null;
          osViewport = vp;
          vp.addEventListener("scroll", scheduleUpdate, { passive: true });
          scheduleUpdate();
        }
      });
      observer.observe(document.body, { childList: true });
    }

    setProgress();
  })();
</script>

<div
  aria-hidden="true"
  data-article-progress
  class="pointer-events-none fixed left-0 top-0 z-9999 h-px w-full"
>
  <span
    data-article-progress-bar
    class="block h-full w-full origin-left bg-(--trait)"
    style="transform: scaleX(0);"></span>
</div>
