---
import type { CollectionEntry } from "astro:content";
import { getSimilarArticles } from "@/components/extrait/extrait.data";
import ArticleCard from "@/components/extrait/article/ArticleCard.astro";

interface Props {
  entry: CollectionEntry<"articles">;
  allArticles: CollectionEntry<"articles">[];
}

const { entry, allArticles }: Props = Astro.props;
const similarArticles = await getSimilarArticles(entry, allArticles);
---

{
  similarArticles.length > 0 && (
    <section aria-labelledby="article-similar-heading" class="mt-12 lg:mt-16">
      <div>
        <h2
          id="article-similar-heading"
          class="text-[0.75rem] font-normal uppercase tracking-[0.14em] text-(--text-muted) [--reveal-delay:0ms]"
          data-reveal="fade-up"
        >
          Articles similaires
        </h2>
        <span
          aria-hidden="true"
          class="mt-3 block h-px w-24 bg-(--trait) [--reveal-delay:60ms] sm:w-32"
          data-reveal="bar-from-left"
        />
      </div>

      <ul class="mt-6 grid grid-cols-1 items-start gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
        {similarArticles.map((article, index) => (
          <li
            class:list={[index >= 2 ? "max-lg:hidden" : undefined]}
            data-reveal="fade-up"
            style={`--reveal-delay:${Math.min(index, 7) * 60}ms;`}
          >
            <ArticleCard article={article} />
          </li>
        ))}
      </ul>
    </section>
  )
}
