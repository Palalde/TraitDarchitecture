---
import { render, type CollectionEntry } from "astro:content";
import Compare from "@/components/extrait/mdx/Compare.astro";
import CompareColumn from "@/components/extrait/mdx/CompareColumn.astro";
import Figure from "@/components/extrait/mdx/Figure.astro";
import FigurePair from "@/components/extrait/mdx/FigurePair.astro";
import Lead from "@/components/extrait/mdx/Lead.astro";
import Note from "@/components/extrait/mdx/Note.astro";
import Pullquote from "@/components/extrait/mdx/Pullquote.astro";
import Prose from "@/components/ui/prose/Prose.astro";

interface Props {
  entry: CollectionEntry<"articles">;
}

const { entry }: Props = Astro.props;
const { Content } = await render(entry);
// `img: Figure` makes Markdown images `![légende](./x.webp)` render through Figure.
// `Figure` (named) lets authors control image layout and project links.
const mdxComponents = {
  img: Figure,
  Figure,
  FigurePair,
  Lead,
  Note,
  Pullquote,
  Compare,
  CompareColumn,
};
---

<section aria-labelledby="article-body-heading" class="mt-10 sm:mt-12 lg:mt-16">
  <h2 id="article-body-heading" class="sr-only">Contenu de l’article</h2>

  <Prose data-article-prose>
    <Content components={mdxComponents} />
  </Prose>

  <script is:inline data-astro-rerun>
    (() => {
      const prose = document.querySelector("[data-article-prose]");
      if (!prose) return;

      Array.from(prose.children).forEach((child, index) => {
        if (child.hasAttribute("data-reveal")) return;

        child.setAttribute("data-reveal", "fade-up");
        child.style.setProperty(
          "--reveal-delay",
          `${Math.min(index, 7) * 40}ms`,
        );
      });
    })();
  </script>
</section>
