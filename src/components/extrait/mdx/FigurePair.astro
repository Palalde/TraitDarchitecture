---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import FigureCaption from "@/components/extrait/mdx/FigureCaption.astro";

interface Props {
  first: ImageMetadata;
  second: ImageMetadata;
  firstAlt: string;
  secondAlt: string;
  caption?: string;
  project?: string;
  layout?: "full" | "wide";
  class?: string;
}

const {
  first,
  second,
  firstAlt,
  secondAlt,
  caption,
  project,
  layout = "wide",
  class: className,
}: Props = Astro.props;

if (!firstAlt.trim() || !secondAlt.trim()) {
  throw new Error("FigurePair: both image alt texts must not be empty.");
}

const firstRatio = first.width / first.height;
const secondRatio = second.width / second.height;
const ratioTotal = firstRatio + secondRatio;
const maxWidth = layout === "wide" ? 56 : 40;
const captionText = caption?.trim();
const captionId = captionText
  ? `figure-pair-${crypto.randomUUID().slice(0, 8)}`
  : undefined;

function getImageSizes(ratio: number): string {
  const part = ratio / ratioTotal;

  return `(min-width: 1024px) ${(maxWidth * part).toFixed(1)}rem, (min-width: 768px) ${Math.round(100 * part)}vw, 100vw`;
}
---

<figure
  aria-labelledby={captionId}
  class:list={[
    layout === "wide"
      ? "my-12 w-full max-w-4xl"
      : "my-10 w-full max-w-(--reading-measure)",
    className,
  ]}
  data-reveal="fade-up"
>
  <div class="flex flex-col gap-4 md:flex-row md:items-start">
    <div
      class="relative w-full overflow-hidden border border-(--trait) bg-(--t2a-blue-wash) md:w-auto md:[flex:var(--pair-grow)_1_0%]"
      style={`aspect-ratio: ${first.width} / ${first.height}; --pair-grow: ${firstRatio.toFixed(4)};`}
    >
      <Image
        alt={firstAlt}
        class="h-full w-full object-cover"
        draggable="false"
        loading="lazy"
        quality={85}
        sizes={getImageSizes(firstRatio)}
        src={first}
        widths={[480, 640, 900, 1200, 1600]}
      />
    </div>

    <div
      class="relative w-full overflow-hidden border border-(--trait) bg-(--t2a-blue-wash) md:w-auto md:[flex:var(--pair-grow)_1_0%]"
      style={`aspect-ratio: ${second.width} / ${second.height}; --pair-grow: ${secondRatio.toFixed(4)};`}
    >
      <Image
        alt={secondAlt}
        class="h-full w-full object-cover"
        draggable="false"
        loading="lazy"
        quality={85}
        sizes={getImageSizes(secondRatio)}
        src={second}
        widths={[480, 640, 900, 1200, 1600]}
      />
    </div>
  </div>

  <FigureCaption labelId={captionId} caption={captionText} project={project} />
</figure>
