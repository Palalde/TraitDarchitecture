---
interface Props {
  class?: string;
  [key: string]: unknown;
}

const { class: className, ...rest }: Props = Astro.props;
---

<div
  {...rest}
  data-lead
  data-reveal="fade-up"
  class:list={[
    "mb-8 max-w-(--reading-measure) text-lead font-light text-(--text-secondary) sm:mb-10",
    className,
  ]}
>
  <slot />
</div>
