---
interface Props {
  class?: string;
  label?: string;
}

const { class: className, label } = Astro.props;
---

<div
  data-compare-column
  class:list={[
    "min-w-0 py-6 md:py-8 md:pr-8 even:border-t even:border-(--trait) even:pt-6 md:even:border-t-0 md:even:border-l md:even:pl-8 md:even:pt-8 [&>*:last-child]:mb-0!",
    className,
  ]}
>
  {
    label && (
      <p class="mb-4! text-label text-(--t2a-blue-dark) dark:text-(--t2a-blue)">
        {label}
      </p>
    )
  }
  <slot />
</div>
