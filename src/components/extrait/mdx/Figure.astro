---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import FigureCaption from "@/components/extrait/mdx/FigureCaption.astro";
import T2AMotifPattern from "@/components/ui/background/T2AMotifPattern.astro";
import { ParallaxFrame } from "@/components/ui/media/ParallaxFrame";

interface Props {
  class?: string;
  src?: ImageMetadata | string;
  alt?: string;
  caption?: string;
  title?: string;
  ratio?: string;
  layout?: "full" | "wide" | "aside-left" | "aside-right";
  plate?: number | string;
  parallax?: boolean;
  project?: string;
}

const {
  class: className,
  src,
  alt = "",
  caption,
  title,
  ratio,
  layout = "full",
  plate,
  parallax = true,
  project,
}: Props = Astro.props;

const imageAlt = alt.trim() || caption?.trim() || title?.trim() || "";
const resolvedRatio =
  ratio ??
  (src && typeof src !== "string"
    ? `${src.width} / ${src.height}`
    : "16 / 9");

const resolvedLayout =
  layout === "wide" || layout === "aside-left" || layout === "aside-right"
    ? layout
    : "full";

const isAside =
  resolvedLayout === "aside-left" || resolvedLayout === "aside-right";

const captionText = [caption, title, alt]
  .find((value) => Boolean(value?.trim()))
  ?.trim();
const plateLabel =
  plate !== undefined && !project?.trim()
    ? `Fig. ${String(plate).padStart(2, "0")}`
    : undefined;
const captionId = captionText
  ? `figure-${crypto.randomUUID().slice(0, 8)}`
  : undefined;

const figureClass = isAside
  ? [
      "my-10 clear-both w-full max-w-(--reading-measure) lg:my-0 lg:clear-none",
      resolvedLayout === "aside-left"
        ? "lg:float-left lg:mr-8 lg:w-[22rem] lg:max-w-[22rem]"
        : "lg:float-right lg:ml-8 lg:w-[22rem] lg:max-w-[22rem]",
    ]
  : resolvedLayout === "wide"
    ? ["my-12 w-full max-w-4xl"]
    : ["my-10 w-full max-w-(--reading-measure)"];

const imageClass = "h-full w-full object-cover object-center";
const imageSizes =
  resolvedLayout === "wide"
    ? "(min-width: 1024px) 56rem, 100vw"
    : isAside
      ? "(min-width: 1024px) 22rem, 100vw"
      : "(min-width: 1024px) 65ch, 100vw";
---

<figure
  aria-labelledby={captionText ? captionId : undefined}
  aria-hidden={!src ? "true" : undefined}
  class:list={[figureClass, className]}
  data-reveal="fade-up"
>
  <div
    class="relative w-full overflow-hidden border border-(--trait) bg-(--t2a-blue-wash)"
    style={`aspect-ratio: ${resolvedRatio};`}
  >
    {
      src ? (
        typeof src === "string" ? (
          parallax ? (
            <ParallaxFrame
              client:visible
              overflowPercent={0.025}
              mobileOverflowPercent={0.04}
            >
              <img
                alt={imageAlt}
                class={imageClass}
                draggable="false"
                loading="lazy"
                src={src}
              />
            </ParallaxFrame>
          ) : (
            <img
              alt={imageAlt}
              class={imageClass}
              draggable="false"
              loading="lazy"
              src={src}
            />
          )
        ) : (
          parallax ? (
            <ParallaxFrame
              client:visible
              overflowPercent={0.025}
              mobileOverflowPercent={0.04}
            >
              <Image
                alt={imageAlt}
                class:list={[imageClass]}
                draggable="false"
                loading="lazy"
                quality={85}
                sizes={imageSizes}
                src={src}
                widths={[480, 640, 900, 1200, 1600]}
              />
            </ParallaxFrame>
          ) : (
            <Image
              alt={imageAlt}
              class:list={[imageClass]}
              draggable="false"
              loading="lazy"
              quality={85}
              sizes={imageSizes}
              src={src}
              widths={[480, 640, 900, 1200, 1600]}
            />
          )
        )
      ) : (
        <T2AMotifPattern />
      )
    }
  </div>

  <FigureCaption
    labelId={captionId}
    caption={captionText}
    plateLabel={plateLabel}
    project={project}
  />
</figure>
