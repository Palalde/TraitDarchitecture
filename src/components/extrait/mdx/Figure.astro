---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";
import T2AMotifPattern from "@/components/ui/background/T2AMotifPattern.astro";
import { ParallaxFrame } from "@/components/ui/media/ParallaxFrame";

interface Props {
  class?: string;
  src?: ImageMetadata | string;
  alt?: string;
  caption?: string;
  title?: string;
  ratio?: string;
  layout?: "full" | "wide" | "aside-left" | "aside-right";
  plate?: number | string;
  parallax?: boolean;
  project?: string;
}

const {
  class: className,
  src,
  alt = "",
  caption,
  title,
  ratio,
  layout = "full",
  plate,
  parallax = true,
  project,
}: Props = Astro.props;

const projectSlug = project?.trim();
if (project !== undefined && !projectSlug) {
  throw new Error("Figure: project slug must not be empty.");
}

const projectEntry = projectSlug
  ? (await getCollection("projects", ({ data }) => !data.draft)).find(
      (entry) => entry.id.replace(/\/index$/, "") === projectSlug,
    )
  : undefined;

if (projectSlug && !projectEntry) {
  throw new Error(`Figure: unknown project "${projectSlug}".`);
}

const imageAlt = alt.trim() || caption?.trim() || title?.trim() || "";
const resolvedRatio =
  ratio ??
  (src && typeof src !== "string"
    ? `${src.width} / ${src.height}`
    : "16 / 9");

const resolvedLayout =
  layout === "wide" || layout === "aside-left" || layout === "aside-right"
    ? layout
    : "full";

const isAside =
  resolvedLayout === "aside-left" || resolvedLayout === "aside-right";

const captionText = [caption, title, alt]
  .find((value) => Boolean(value?.trim()))
  ?.trim();
const plateLabel =
  plate !== undefined && !projectEntry
    ? `Fig. ${String(plate).padStart(2, "0")}`
    : undefined;
const hasCaption = Boolean(captionText || plateLabel || projectEntry);
const captionId = hasCaption
  ? `figure-${crypto.randomUUID().slice(0, 8)}`
  : undefined;

const figureClass = isAside
  ? [
      "my-10 clear-both w-full max-w-(--reading-measure) lg:my-0 lg:clear-none",
      resolvedLayout === "aside-left"
        ? "lg:float-left lg:mr-8 lg:w-[22rem] lg:max-w-[22rem]"
        : "lg:float-right lg:ml-8 lg:w-[22rem] lg:max-w-[22rem]",
    ]
  : resolvedLayout === "wide"
    ? ["my-12 w-full max-w-4xl"]
    : ["my-10 w-full max-w-(--reading-measure)"];

const captionClass = hasCaption
  ? [
      "mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 font-sans text-[0.75rem] font-normal uppercase tracking-[0.12em] text-(--text-muted)",
      plateLabel || projectEntry ? "justify-between" : "justify-start",
    ]
  : [];

const plateClass = ["shrink-0", "leading-tight"];
const labelClass = [
  projectEntry
    ? "min-w-0 flex-1 text-left"
    : plateLabel
      ? "max-w-[70%] text-right"
      : "max-w-full text-left",
  "leading-tight",
];

const imageClass = "h-full w-full object-cover object-center";
const projectLinkClass =
  "shrink-0 font-sans text-[0.75rem] font-normal uppercase tracking-[0.18em] text-(--t2a-blue-dark) underline decoration-current/35 underline-offset-4 transition-colors duration-200 hover:text-(--text-primary) focus-visible:outline-2 focus-visible:outline-(--t2a-blue) dark:text-(--t2a-blue) dark:hover:text-(--t2a-blue-light)";
const imageSizes =
  resolvedLayout === "wide"
    ? "(min-width: 1024px) 56rem, 100vw"
    : isAside
      ? "(min-width: 1024px) 22rem, 100vw"
      : "(min-width: 1024px) 65ch, 100vw";
---

<figure
  aria-labelledby={hasCaption ? captionId : undefined}
  aria-hidden={hasCaption ? undefined : "true"}
  class:list={[figureClass, className]}
  data-reveal="fade-up"
>
  <div
    class="relative w-full overflow-hidden border border-(--trait) bg-(--t2a-blue-wash)"
    style={`aspect-ratio: ${resolvedRatio};`}
  >
    {
      src ? (
        typeof src === "string" ? (
          parallax ? (
            <ParallaxFrame
              client:visible
              overflowPercent={0.025}
              mobileOverflowPercent={0.04}
            >
              <img
                alt={imageAlt}
                class={imageClass}
                draggable="false"
                loading="lazy"
                src={src}
              />
            </ParallaxFrame>
          ) : (
            <img
              alt={imageAlt}
              class={imageClass}
              draggable="false"
              loading="lazy"
              src={src}
            />
          )
        ) : (
          parallax ? (
            <ParallaxFrame
              client:visible
              overflowPercent={0.025}
              mobileOverflowPercent={0.04}
            >
              <Image
                alt={imageAlt}
                class:list={[imageClass]}
                draggable="false"
                loading="lazy"
                quality={85}
                sizes={imageSizes}
                src={src}
                widths={[480, 640, 900, 1200, 1600]}
              />
            </ParallaxFrame>
          ) : (
            <Image
              alt={imageAlt}
              class:list={[imageClass]}
              draggable="false"
              loading="lazy"
              quality={85}
              sizes={imageSizes}
              src={src}
              widths={[480, 640, 900, 1200, 1600]}
            />
          )
        )
      ) : (
        <T2AMotifPattern />
      )
    }
  </div>

  {
    hasCaption && (
      <figcaption id={captionId} class:list={captionClass}>
        {plateLabel && <span class:list={plateClass}>{plateLabel}</span>}
        {captionText && <span class:list={labelClass}>{captionText}</span>}
        {projectEntry && (
          <a class={projectLinkClass} href={`/architecture/${projectSlug}`}>
            <span class="sr-only">Voir le projet </span>
            {projectEntry.data.name}
            <span aria-hidden="true"> →</span>
          </a>
        )}
      </figcaption>
    )
  }
</figure>
