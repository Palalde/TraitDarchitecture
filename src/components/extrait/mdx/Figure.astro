---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import T2AMotifPattern from "@/components/ui/background/T2AMotifPattern.astro";
import { ParallaxFrame } from "@/components/ui/media/ParallaxFrame";

interface Props {
  class?: string;
  src?: ImageMetadata | string;
  alt?: string;
  caption?: string;
  title?: string;
  ratio?: string;
  layout?: "full" | "wide" | "aside-left" | "aside-right";
  plate?: number | string;
}

const {
  class: className,
  src,
  alt = "",
  caption,
  title,
  ratio = "16/9",
  layout = "full",
  plate,
}: Props = Astro.props;

const imageAlt = alt.trim() || caption?.trim() || title?.trim() || "";

const resolvedLayout =
  layout === "wide" || layout === "aside-left" || layout === "aside-right"
    ? layout
    : "full";

const isAside =
  resolvedLayout === "aside-left" || resolvedLayout === "aside-right";

const captionText = [caption, title, alt]
  .find((value) => Boolean(value?.trim()))
  ?.trim();
const plateLabel =
  plate !== undefined ? `Fig. ${String(plate).padStart(2, "0")}` : undefined;
const hasCaption = Boolean(captionText || plateLabel);
const captionId = hasCaption
  ? `figure-${crypto.randomUUID().slice(0, 8)}`
  : undefined;

const figureClass = isAside
  ? [
      "my-10 clear-both w-full max-w-[65ch] lg:my-0 lg:clear-none",
      resolvedLayout === "aside-left"
        ? "lg:float-left lg:mr-8 lg:w-[22rem] lg:max-w-[22rem]"
        : "lg:float-right lg:ml-8 lg:w-[22rem] lg:max-w-[22rem]",
    ]
  : resolvedLayout === "wide"
    ? ["my-12 w-full max-w-4xl"]
    : ["my-10 w-full max-w-[65ch]"];

const captionClass = hasCaption
  ? [
      "mt-4 flex items-center gap-4 text-[0.6rem] uppercase tracking-[0.12em] text-(--text-muted) sm:text-[0.68rem]",
      plateLabel ? "justify-between" : "justify-start",
    ]
  : [];

const plateClass = ["shrink-0", "leading-tight"];
const labelClass = [
  plateLabel ? "max-w-[70%] text-right" : "max-w-full text-left",
  "leading-tight",
];

const imageClass = "h-full w-full object-cover object-center";
const imageSizes =
  resolvedLayout === "wide"
    ? "(min-width: 1024px) 56rem, 100vw"
    : isAside
      ? "(min-width: 1024px) 22rem, 100vw"
      : "(min-width: 1024px) 65ch, 100vw";
---

<figure
  aria-labelledby={hasCaption ? captionId : undefined}
  aria-hidden={hasCaption ? undefined : "true"}
  class:list={[figureClass, className]}
  data-reveal="fade-up"
>
  <div
    class="relative w-full overflow-hidden border border-(--trait) bg-(--t2a-blue-wash)"
    style={`aspect-ratio: ${ratio};`}
  >
    {
      src ? (
        typeof src === "string" ? (
          <ParallaxFrame
            client:visible
            overflowPercent={0.025}
            mobileOverflowPercent={0.04}
          >
            <img
              alt={imageAlt}
              class={imageClass}
              draggable="false"
              loading="lazy"
              src={src}
            />
          </ParallaxFrame>
        ) : (
          <ParallaxFrame
            client:visible
            overflowPercent={0.025}
            mobileOverflowPercent={0.04}
          >
            <Image
              alt={imageAlt}
              class:list={[imageClass]}
              draggable="false"
              loading="lazy"
              quality={85}
              sizes={imageSizes}
              src={src}
            />
          </ParallaxFrame>
        )
      ) : (
        <T2AMotifPattern />
      )
    }
  </div>

  {
    hasCaption && (
      <figcaption id={captionId} class:list={captionClass}>
        {plateLabel && <span class:list={plateClass}>{plateLabel}</span>}
        {captionText && <span class:list={labelClass}>{captionText}</span>}
      </figcaption>
    )
  }
</figure>
