---
import { traitPageData } from "@/components/trait/trait.data";
import BackgroundDecorations from "@/components/ui/background/BackgroundDecorations.astro";
import Footer from "@/components/ui/footer/Footer.astro";
import HeaderShell from "@/components/ui/header/HeaderShell.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title={traitPageData.title}
  description={traitPageData.description}
>
  <HeaderShell />
  <main class="relative min-h-screen overflow-hidden bg-(--bg-primary)">
    <BackgroundDecorations />

    <section class="relative z-10 mx-auto flex min-h-screen w-full max-w-[1200px] items-start px-6 pb-16 pt-[calc(var(--header-height)+3rem)] sm:px-8 lg:px-10">
      <div class="max-w-[36rem] border-l border-(--trait) pl-6 sm:pl-8">
        <p class="text-[0.78rem] uppercase tracking-[0.18em] text-(--t2a-blue-dark) dark:text-(--t2a-blue)">
          Phase 0.1
        </p>
        <h1 class="mt-4 text-[clamp(3.25rem,10vw,6.5rem)] font-light tracking-[0.02em] text-(--t2a-blue-dark) dark:text-(--t2a-blue)">
          {traitPageData.opening.heading}
        </h1>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>