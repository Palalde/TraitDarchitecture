---
import { LandingIsland } from "@/components/home/LandingIsland";
import HomeContentShell from "@/components/home/content/HomeContentShell.astro";
import HeaderShell from "@/components/ui/header/HeaderShell.astro";
import Footer from "@/components/ui/footer/Footer.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

// Dev flag: set to true locally to replay the landing animation on every
// reload (bypasses the sessionStorage "dismissed" check). Must ship as false.
const FORCE_REPLAY_LANDING = false;
---

<BaseLayout
  title="ATELIER TraiT D'ARCHITECTURE"
  description="Atelier d'architecture sensible, contextuelle et engagée. Théa Battistini & Titouan Granet."
>
  <!-- landing transition -->
  <script is:inline data-astro-rerun>
    (() => {
      const HOME_FLOW_SLIDE_DISTANCE = "calc(var(--landing-vh) * -1)";
      const HOME_FLOW_SLIDE_DURATION_MS = 1250;

      const isDismissed =
        sessionStorage.getItem("t2a-landing-dismissed") === "1";
      const rootStyle = document.documentElement.style;
      const setHomeFlowTransition = (value) => {
        rootStyle.setProperty("--home-flow-transition", value);
      };
      const setHomeFlowShift = (value) => {
        rootStyle.setProperty("--home-flow-shift", value);
      };

      setHomeFlowTransition("none");
      setHomeFlowShift("0px");

      if (isDismissed) {
        document.body.classList.add("landing-dismissed");
        return;
      }

      if (history.scrollRestoration) {
        history.scrollRestoration = "manual";
      }
      window.scrollTo(0, 0);

      const handleLandingSlidingUp = () => {
        setHomeFlowTransition(
          `transform ${HOME_FLOW_SLIDE_DURATION_MS}ms ease-out`,
        );
        setHomeFlowShift(HOME_FLOW_SLIDE_DISTANCE);
      };

      const handleLandingDismissed = () => {
        setHomeFlowTransition("none");
        setHomeFlowShift("0px");
        window.removeEventListener(
          "landing:sliding-up",
          handleLandingSlidingUp,
        );
      };

      window.addEventListener("landing:sliding-up", handleLandingSlidingUp);
      window.addEventListener("landing:dismissed", handleLandingDismissed, {
        once: true,
      });
    })();
  </script>
  <HeaderShell waitForLanding />
  <main class="flex flex-col bg-(--bg-primary)">
    <div
      id="home-flow"
      class="will-change-transform"
      style="transform: translate3d(0, var(--home-flow-shift, 0px), 0); transition: var(--home-flow-transition, none);"
    >
      <div
        id="landing-wrapper"
        class="relative overflow-hidden"
        style="height: var(--landing-vh);"
      >
        <LandingIsland client:load forceReplay={FORCE_REPLAY_LANDING} />
        <script is:inline data-astro-rerun>
          // Skip LandingIsland hydration entirely on returning visits.
          (() => {
            if (sessionStorage.getItem("t2a-landing-dismissed") !== "1") {
              return;
            }
            const wrapper = document.getElementById("landing-wrapper");
            if (!wrapper) {
              return;
            }
            const island = wrapper.querySelector("astro-island");
            if (island) {
              island.remove();
            }
          })();
        </script>
      </div>
      <div id="home-stage">
        <HomeContentShell />
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
