---
import { getCollection } from "astro:content";
import BackgroundDecorations from "@/components/ui/background/BackgroundDecorations.astro";
import Footer from "@/components/ui/footer/Footer.astro";
import HeaderShell from "@/components/ui/header/HeaderShell.astro";
import JsonLd from "@/components/ui/seo/JsonLd.astro";
import {
  buildBreadcrumbListSchema,
  buildCreativeWorkSchema,
  buildSocialImagePath,
} from "@/components/ui/seo/seo.data";
import ProjectShell from "@/components/architecture/project/ProjectShell.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  buildProjectLabelSummary,
  getSortedProjects,
} from "@/components/architecture/architecture.data";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  return projects.map((entry) => {
    const slug = entry.id.replace(/\/index$/, "");
    return { params: { slug }, props: { entry } };
  });
}

const { entry } = Astro.props;
const { name, city, dept, cover, year } = entry.data;

// Generated description — stable even when labels are absent
const labelParts = buildProjectLabelSummary(entry);
const description = [
  `Projet ${name} à ${city} (${dept})`,
  labelParts ? `— ${labelParts}` : "",
  "Par l'ATELIER TraiT D'ARCHITECTURE.",
]
  .filter(Boolean)
  .join(" ");

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImagePath = await buildSocialImagePath(cover);
const projectImageUrl = new URL(socialImagePath, Astro.site ?? Astro.url).href;
const projectJsonLd = buildCreativeWorkSchema(Astro.site ?? Astro.url, {
  name,
  imageUrl: projectImageUrl,
  canonicalUrl: canonicalURL,
  locationCreatedName: `${city} (${dept})`,
  ...(year ? { dateCreated: String(year) } : {}),
});

const breadcrumbJsonLd = buildBreadcrumbListSchema(Astro.site ?? Astro.url, [
  { name: "Accueil", path: "/" },
  { name: "Architecture", path: "/architecture/" },
  { name, path: Astro.url.pathname },
]);

// Pre-fetch all projects once for the similar projects section (step 7)
const allProjects = await getSortedProjects();
---

<BaseLayout
  title={`${name} à ${city} | ATELIER TraiT D'ARCHITECTURE`}
  description={description}
  ogImage={socialImagePath}
>
  <Fragment slot="head">
    <JsonLd data={projectJsonLd} />
    <JsonLd data={breadcrumbJsonLd} />
  </Fragment>
  <HeaderShell />
  <main class="relative overflow-x-clip bg-(--bg-primary)">
    <BackgroundDecorations />
    <ProjectShell entry={entry} allProjects={allProjects} />
  </main>
  <Footer />
</BaseLayout>
