---
import ArchitectureShell from "@/components/architecture/ArchitectureShell.astro";
import BackgroundDecorations from "@/components/ui/background/BackgroundDecorations.astro";
import Footer from "@/components/ui/footer/Footer.astro";
import HeaderShell from "@/components/ui/header/HeaderShell.astro";
import JsonLd from "@/components/ui/seo/JsonLd.astro";
import {
  buildBreadcrumbListSchema,
  buildItemListSchema,
} from "@/components/ui/seo/seo.data";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getSortedProjects } from "@/components/architecture/architecture.data";

// OG social : première cover (premier projet trié par `order`). Swap simple
// quand une image dédiée sera validée avec T&T.
const sortedProjects = await getSortedProjects();
const ogImage = sortedProjects[0]?.data.cover.src;
const projectListJsonLd = buildItemListSchema(
  Astro.site ?? Astro.url,
  sortedProjects.map((project) => {
    const slug = project.id.replace(/\/index$/, "");
    return {
      name: project.data.name,
      path: `/architecture/${slug}/`,
    };
  }),
  "Projets",
);
const breadcrumbJsonLd = buildBreadcrumbListSchema(Astro.site ?? Astro.url, [
  { name: "Accueil", path: "/" },
  { name: "Architecture", path: "/architecture/" },
]);
---

<BaseLayout
  title="Architecture | ATELIER TraiT D'ARCHITECTURE"
  description="Projets et réalisations de l'ATELIER TraiT D'ARCHITECTURE."
  ogImage={ogImage}
>
  <Fragment slot="head">
    <JsonLd data={projectListJsonLd} />
    <JsonLd data={breadcrumbJsonLd} />
  </Fragment>
  <HeaderShell />
  <main class="relative overflow-hidden bg-(--bg-primary)">
    <BackgroundDecorations />
    <ArchitectureShell />
  </main>
  <Footer />
</BaseLayout>
