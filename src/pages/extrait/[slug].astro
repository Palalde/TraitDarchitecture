---
import { getCollection } from "astro:content";
import BackgroundDecorations from "@/components/ui/background/BackgroundDecorations.astro";
import Footer from "@/components/ui/footer/Footer.astro";
import HeaderShell from "@/components/ui/header/HeaderShell.astro";
import JsonLd from "@/components/ui/seo/JsonLd.astro";
import {
  buildArticleSchema,
  buildBreadcrumbListSchema,
  buildSocialImagePath,
} from "@/components/ui/seo/seo.data";
import ArticleShell from "@/components/extrait/article/ArticleShell.astro";
import { getSortedArticles } from "@/components/extrait/extrait.data";
import BaseLayout from "@/layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => !data.draft);

  return articles.map((entry) => {
    const slug = entry.id.replace(/\/index$/, "");
    return { params: { slug }, props: { entry } };
  });
}

const { entry } = Astro.props;
const { title, excerpt, cover } = entry.data;
const publishedDate = entry.data.publishedDate;
const updatedDate = entry.data.updatedDate;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImagePath = cover ? await buildSocialImagePath(cover) : undefined;
const articleImageUrl = new URL(
  socialImagePath ?? "/media/og/default-og.jpg",
  Astro.site ?? Astro.url,
).href;

const articleJsonLd = buildArticleSchema(Astro.site ?? Astro.url, {
  headline: title,
  description: excerpt,
  imageUrl: articleImageUrl,
  canonicalUrl: canonicalURL,
  publishedDate,
  updatedDate,
});

const breadcrumbJsonLd = buildBreadcrumbListSchema(Astro.site ?? Astro.url, [
  { name: "Accueil", path: "/" },
  { name: "EXTraiT", path: "/extrait/" },
  { name: title, path: Astro.url.pathname },
]);

const allArticles = await getSortedArticles();
---

<BaseLayout
  title={`${title} | ATELIER TraiT D'ARCHITECTURE`}
  description={excerpt}
  author="ATELIER TraiT D'ARCHITECTURE"
  ogImage={socialImagePath}
  ogType="article"
>
  <Fragment slot="head">
    <JsonLd data={articleJsonLd} />
    <JsonLd data={breadcrumbJsonLd} />
    <meta
      property="article:published_time"
      content={publishedDate.toISOString()}
    />
    {
      updatedDate ? (
        <meta
          property="article:modified_time"
          content={updatedDate.toISOString()}
        />
      ) : null
    }
  </Fragment>
  <HeaderShell />
  <main class="relative overflow-x-clip bg-(--bg-primary)">
    <BackgroundDecorations />
    <ArticleShell entry={entry} allArticles={allArticles} />
  </main>
  <Footer />
</BaseLayout>
