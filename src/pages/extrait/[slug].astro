---
import { getCollection } from "astro:content";
import BackgroundDecorations from "@/components/ui/background/BackgroundDecorations.astro";
import Footer from "@/components/ui/footer/Footer.astro";
import HeaderShell from "@/components/ui/header/HeaderShell.astro";
import ArticleShell from "@/components/extrait/article/ArticleShell.astro";
import { getSortedArticles } from "@/components/extrait/extrait.data";
import BaseLayout from "@/layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => !data.draft);

  return articles.map((entry) => {
    const slug = entry.id.replace(/\/index$/, "");
    return { params: { slug }, props: { entry } };
  });
}

const { entry } = Astro.props;
const { title, excerpt, cover } = entry.data;

const allArticles = await getSortedArticles();
---

<BaseLayout
  title={`${title} | ATELIER TraiT D'ARCHITECTURE`}
  description={excerpt}
  ogImage={cover?.src}
>
  <HeaderShell />
  <main class="relative overflow-x-clip bg-(--bg-primary)">
    <BackgroundDecorations />
    <ArticleShell entry={entry} allArticles={allArticles} />
  </main>
  <Footer />
</BaseLayout>
