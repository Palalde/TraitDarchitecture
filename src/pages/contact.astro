---
import ContactShell from "@/components/contact/ContactShell.astro";
import { contactPageData } from "@/components/contact/contact.data";
import BackgroundDecorations from "@/components/ui/background/BackgroundDecorations.astro";
import Footer from "@/components/ui/footer/Footer.astro";
import HeaderShell from "@/components/ui/header/HeaderShell.astro";
import JsonLd from "@/components/ui/seo/JsonLd.astro";
import { buildBreadcrumbListSchema } from "@/components/ui/seo/seo.data";
import BaseLayout from "@/layouts/BaseLayout.astro";

const breadcrumbJsonLd = buildBreadcrumbListSchema(Astro.site ?? Astro.url, [
  { name: "Accueil", path: "/" },
  { name: "Contact", path: "/contact/" },
]);
---

<BaseLayout
  title={contactPageData.title}
  description={contactPageData.description}
>
  <Fragment slot="head">
    <JsonLd data={breadcrumbJsonLd} />
  </Fragment>
  <HeaderShell />
  <main
    id="main-content"
    tabindex="-1"
    class="relative overflow-hidden bg-(--bg-primary)"
  >
    <BackgroundDecorations />
    <ContactShell />
  </main>
  <Footer />
</BaseLayout>
